<div class="card">
    <div class="card-body">

        <RadzenStack Gap="1rem">
            @if (InProcess)
            {
                <SpinnerControl></SpinnerControl>
            }

            <RadzenDataGrid @ref="grid" Render="@OnRender" class="rz-border-radius-2"
                            PageSizeOptions="@Utiles.PageSizeOptions()"
            TItem="Consultor"
            AllowFiltering="true"
            AllowColumnResize="true"
            FilterMode="FilterMode.SimpleWithMenu"
            PageSize="10"
            AllowPaging="true"
            AllowSorting="true"
            AllowMultiColumnSorting="true"
            ShowMultiColumnSortingIndex="true"
            Data="@dataList"
            ColumnWidth="300px"
            FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
            FilterCleared=@FilterCleared
            SelectionMode="DataGridSelectionMode.Single"
            @bind-Value=@selectedData
            LogicalFilterOperator="LogicalFilterOperator.Or"
            FilterPopupRenderMode="PopupRenderMode.OnDemand"
            RowDoubleClick="@OnSelect"
            AllowColumnPicking="true"
            AllowColumnReorder="true"
            ColumnReordering="@OnColumnReordering">
                <Columns>                    
                    <RadzenDataGridColumn Property="@nameof(Consultor.Id)"
                    FilterValue="@ConsultorID"
                    Filterable="true" Title="ID" 
                    Frozen="true" 
                    Width="100px" 
                    TextAlign="TextAlign.Center">
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn Property="@nameof(Consultor.Nombre)" Title="Nombre" Width="300px" />
                    <RadzenDataGridColumn Property="@nameof(Consultor.Email)" Title="Email" Width="200px" />
                    <RadzenDataGridColumn Property="@nameof(Consultor.Telefono)" Title="Teléfono" Width="150px" />
                    <RadzenDataGridColumn Property="@nameof(Consultor.Activo)" Title="Activo" Width="150px">
                        <Template Context="Consultor">
                            <RadzenSwitch @bind-Value=@Consultor.Activo Disabled="true"></RadzenSwitch>
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>            
        </RadzenStack>

    </div>
</div>

@code {
    [Parameter] public EventCallback<Consultor> OnItemSelected { get; set; }

    private bool InProcess = true; 

    string? ConsultorID;
    RadzenDataGrid<Consultor> grid;
    IEnumerable<Consultor> dataList;
    IList<Consultor> selectedData;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await base.OnInitializedAsync();
            dataList = await GetDataList();


        }
        catch (Exception)
        {
            await swal.FireAsync("Error", "Error al cargar la información solicitada.", SweetAlertIcon.Info);
        }
        StateHasChanged();
    }


    async Task FilterCleared()
    {
        ConsultorID = null;
        await grid.FirstPage();
    }

    void OnRender(DataGridRenderEventArgs<Consultor> args)
    {
        if (args.FirstRender)
        {
            args.Grid.Sorts.Add(new SortDescriptor() { Property = "Id", SortOrder = SortOrder.Ascending });
        }     

    }


    private async Task<IEnumerable<Consultor>> GetDataList()
    {
        List<Consultor> model = new();
        try
        {
            var consultores = await mtoService.GetConsultor();

            if (consultores is not null)
            {
                consultores = consultores.Where(e => e.Activo == true);

                model = (from c in consultores
                         select new Consultor
                         {
                             Id = c.Id,
                             Nombre = $"{c.Nombre} {c.PrimerApellido} {c.SegundoApellido}",
                             Telefono = c.Telefono,
                             Email = c.Email,
                             Activo = c.Activo,
                         }).ToList();
            }
            

        }
        catch (Exception)
        {
            await swal.FireAsync("Error", "Error al cargar la información solicitada.", SweetAlertIcon.Info);
        }

        InProcess = false;
        StateHasChanged();
        return model;
    }

    void OnColumnReordering(DataGridColumnReorderingEventArgs<Consultor> args)
    {
        if (args.ToColumn.Property == nameof(Consultor.Id))
        {
            args.Cancel = true;
        }
    }

    
    protected async Task OnSelect(DataGridRowMouseEventArgs<Consultor> args)
    {
        await OnItemSelected.InvokeAsync(args.Data);
    }
   
}

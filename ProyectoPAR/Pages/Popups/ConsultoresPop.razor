<div class="card">
    <div class="card-body">

        <RadzenStack Gap="1rem">
            @if (InProcess)
            {
                <SpinnerControl></SpinnerControl>
            }

            <RadzenDataGrid @ref="grid" Render="@OnRender" class="rz-border-radius-2"
                            PageSizeOptions="@Utiles.PageSizeOptions()"
            TItem="Consultor"
            AllowFiltering="true" 
            AllowColumnResize="true" 
            FilterMode="FilterMode.SimpleWithMenu" 
            PageSize="8"
            AllowPaging="true"
            AllowSorting="true" 
            AllowMultiColumnSorting="true" 
            ShowMultiColumnSortingIndex="true"
            Data="@dataList"
            ColumnWidth="300px"
            FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"                           
            FilterCleared=@FilterCleared
            AllowRowSelectOnRowClick=@allowRowSelect
            SelectionMode="DataGridSelectionMode.Multiple" 
            @bind-Value=@selectedData
            LogicalFilterOperator="LogicalFilterOperator.Or"
            FilterPopupRenderMode="PopupRenderMode.OnDemand"
            AllowColumnPicking="true"
            AllowColumnReorder="true" 
            ColumnReordering="@OnColumnReordering">  
                <HeaderTemplate>
                    <RadzenStack Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem;" Wrap="FlexWrap.Wrap">
                        <RadzenButton class="rz-border-radius-6" Shade="Shade.Light" ButtonStyle="ButtonStyle.Primary" Text="Seleccionar" Icon="how_to_reg" Click="@(args => OnSelect())" />
                    </RadzenStack>
                </HeaderTemplate>
                <Columns>
                    <RadzenDataGridColumn Width="60px" Sortable="false" Filterable="false">
                        <HeaderTemplate>
                            <RadzenCheckBox TabIndex="-1" TriState="false" TValue="bool?" InputAttributes="@(new Dictionary<string, object>() { { "aria-label", "Seleccionar todos" } })"
                            Value="@(selectedData == null || selectedData?.Any() != true ? false : !dataList.All(i => selectedData.Contains(i)) ? null : dataList.Any(i => selectedData.Contains(i)))"
                            Change="@(args => selectedData = args == true ? dataList.ToList() : null)" />
                        </HeaderTemplate>
                        <Template Context="data">
                            <RadzenCheckBox TabIndex="-1" TriState="false" Value="@(selectedData != null && selectedData.Contains(data))" InputAttributes="@(new Dictionary<string,object>(){ { "aria-label", "Select item" }})"
                            TValue="bool" Change=@(args => { if (!allowRowSelect) { grid.SelectRow(data); } }) />
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn Property="@nameof(Consultor.Id)"
                    FilterValue="@ConsultorID"
                    Filterable="true" Title="ID" 
                    Frozen="true" 
                    Width="100px" 
                    TextAlign="TextAlign.Center">
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn Property="@nameof(Consultor.Nombre)" Title="Nombre" Width="300px" />
                    <RadzenDataGridColumn Property="@nameof(Consultor.Email)" Title="Email" Width="200px" />
                    <RadzenDataGridColumn Property="@nameof(Consultor.Telefono)" Title="Teléfono" Width="150px" />
                    <RadzenDataGridColumn Property="@nameof(Consultor.Activo)" Title="Activo" Width="150px">
                        <Template Context="Consultor">
                            <RadzenSwitch @bind-Value=@Consultor.Activo Disabled="true"></RadzenSwitch>
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>            
        </RadzenStack>

    </div>
</div>

@code {
    [Parameter] public EventCallback<IList<Consultor>> OnItemSelected { get; set; }
    [Parameter] public IEnumerable<ProyectoConsultorExt>? ConsultoresActuales { get; set; }

    private bool InProcess = true; 

    string? ConsultorID;
    RadzenDataGrid<Consultor> grid;
    IEnumerable<Consultor> dataList;
    IList<Consultor> selectedData;
    private bool allowRowSelect = true;
    private bool bInicializado = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await base.OnInitializedAsync();
            dataList = await GetDataList();


        }
        catch (Exception)
        {
            await swal.FireAsync("Error", "Error al cargar la información solicitada.", SweetAlertIcon.Info);
        }
        StateHasChanged();
    }


    async Task FilterCleared()
    {
        ConsultorID = null;
        await grid.FirstPage();
    }

    void OnRender(DataGridRenderEventArgs<Consultor> args)
    {
        if (args.FirstRender)
        {
            args.Grid.Sorts.Add(new SortDescriptor() { Property = "Id", SortOrder = SortOrder.Ascending });


        }
        if (!bInicializado)
        {
            if (grid.Data is not null)
            {
                foreach (var item in grid.Data)
                {
                    if (ConsultoresActuales.Any(e => e.ConsultorId == item.Id))
                    {
                        grid.SelectRow(item, true);
                    }
                    bInicializado = true;
                }
            }
        }


    }


    private async Task<IEnumerable<Consultor>> GetDataList()
    {
        List<Consultor> model = new();
        try
        {
            var consultores = await mtoService.GetConsultor();

            if (consultores is not null)
            {
                consultores = consultores.Where(e => e.Activo == true);

                model = (from c in consultores
                         select new Consultor
                         {
                             Id = c.Id,
                             Nombre = $"{c.PrimerApellido} {c.SegundoApellido} {c.Nombre}",
                             Telefono = c.Telefono,
                             Email = c.Email,
                             Activo = c.Activo,
                         }).ToList();
            }
           

        }
        catch (Exception)
        {
            await swal.FireAsync("Error", "Error al cargar la información solicitada.", SweetAlertIcon.Info);
        }

        InProcess = false;
        StateHasChanged();
        return model;
    }

    void OnColumnReordering(DataGridColumnReorderingEventArgs<Consultor> args)
    {
        if (args.ToColumn.Property == nameof(Consultor.Id))
        {
            args.Cancel = true;
        }
    }

    
    protected async Task OnSelect()
    {
        await OnItemSelected.InvokeAsync(selectedData);
    }
   
}


<RadzenTemplateForm Data="@ReporteExt" Submit="@((ReporteExt args) => { Guardar(args); })">
    <RadzenRow Gap="0.3rem" class="rz-p-0 rz-p-lg-2">
        <RadzenColumn Size="12" SizeMD="12">
            <RadzenStack>
                <RadzenFieldset Text="Comentarios de Facturación">
                    <RadzenStack Gap="0.3rem">
                        <RadzenRow AlignItems="AlignItems.Center">
                            <RadzenColumn Size="12" SizeMD="12">
                                <RadzenLabel Text="Por favor indique sus comentarios" Component="comment" />
                                <RadzenTextArea @bind-Value=@ReporteExt!.ComentariosFacturacion Style="width: 100%" Name="comment" />
                            </RadzenColumn>
                        </RadzenRow>
                    </RadzenStack>
                </RadzenFieldset>
            </RadzenStack>
        </RadzenColumn>
    </RadzenRow>

    <RadzenStack Orientation="Radzen.Orientation.Horizontal" JustifyContent="JustifyContent.Center" Gap="0.5rem" class="rz-mt-8 rz-mb-4">
        <RadzenButton class="rz-border-radius-6" ButtonType="Radzen.ButtonType.Submit" Size="Radzen.ButtonSize.Large" Icon="save" Text="Guardar" />
        <RadzenButton class="rz-border-radius-6" ButtonStyle="Radzen.ButtonStyle.Light" Variant="Variant.Flat" Size="Radzen.ButtonSize.Large" Icon="cancel" Text="Cancelar" Click="@Cancelar" />
    </RadzenStack>
</RadzenTemplateForm>

@code {
    [Parameter] public ReporteExt? ReporteExt { get; set; }
    [Parameter] public EventCallback<bool> OnSaveSelected { get; set; }

    private async Task Guardar(Reporte reporte)
    {
        reporte.Cliente = null;
        reporte.Consultor = null;

        List<Reporte> listReporte = new List<Reporte>()
        {
            reporte,
        };

        var respuesta = await genericService.Put("ReporteActualizaFacturacion", listReporte);

        if (respuesta.Id != "0")
        {
            await swal.FireAsync("Error", $"Error al actualizar los comentarios de la facturación.  Detalle de error: {respuesta.Descripcion}", SweetAlertIcon.Error);
        }
        else
            await OnSaveSelected.InvokeAsync(true);
    }
    private async Task Cancelar()
    {
        await OnSaveSelected.InvokeAsync(false);
    }
}

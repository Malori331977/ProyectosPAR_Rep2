@page "/reporteslist"
@layout MainLayout
@inherits DialogSettingLayout

<div class="card rz-background-color-base-200">
    <PageMant Titulo="@Titulo" OnClickAddSelected="OnClickAdd" />

    <div class="card-body">
        <RadzenStack Gap="0.5rem">
            @if (InProcess)
            {
                <SpinnerControl></SpinnerControl>
            }

            <RadzenDataGrid @ref="grid" Render="@OnRender" class="rz-border-radius-2"
                            PageSizeOptions="@Utiles.PageSizeOptions()"
                            TItem="ReporteExt"
                            AllowFiltering="true"
                            AllowColumnResize="true"
                            FilterMode="FilterMode.SimpleWithMenu"
                            PageSize="7"
                            AllowPaging="true"
                            AllowSorting="true"
                            AllowMultiColumnSorting="true"
                            ShowMultiColumnSortingIndex="true"
                            Data="@dataList"
                            ColumnWidth="300px"
                            FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                            FilterCleared=@FilterCleared
                            SelectionMode="DataGridSelectionMode.Single"
                            @bind-Value=@selectedData
                            LogicalFilterOperator="LogicalFilterOperator.Or"
                            FilterPopupRenderMode="PopupRenderMode.OnDemand"
                            RowDoubleClick="@OnSelect"
                            AllowColumnPicking="true"
                            AllowColumnReorder="true"
                            RowRender="@RowRender"
                            ColumnReordering="@OnColumnReordering">
                <HeaderTemplate>
                    <RadzenStack Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem;" Wrap="FlexWrap.Wrap">
                        <RadzenButton class="rz-border-radius-6" Shade="Shade.Light" ButtonStyle="ButtonStyle.Success" Text="Exportar a XLS" Icon="grid_on" Click="@(args => Export("excel"))" />
                        <RadzenButton class="rz-border-radius-6" Shade="Shade.Light" ButtonStyle="ButtonStyle.Secondary" Text="Exportar a CSV" Icon="wrap_text" Click="@(args => Export("csv"))" />
                    </RadzenStack>
                </HeaderTemplate>
                <Columns>

                    <RadzenDataGridColumn Property="@nameof(ReporteExt.Id)"
                    FilterValue="@ReporteID"
                    Filterable="true" Title="ID"
                    Frozen="true"
                    Width="100px"
                    TextAlign="TextAlign.Center">
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn Property="@nameof(ReporteExt.NombreCliente)" Title="Cliente" Width="300px"/>
                    <RadzenDataGridColumn Property="@nameof(ReporteExt.NombreConsultor)" Title="Consultor" Width="150px" />
                    <RadzenDataGridColumn Property="@nameof(ReporteExt.Fecha)" Title="Fecha" FormatString="{0:d}" Width="150px" />
                    <RadzenDataGridColumn Property="@nameof(ReporteExt.ResponsableCliente)" Title="Responsable de Empresa" Width="150px" />
                    <RadzenDataGridColumn Property="@nameof(ReporteExt.CorreoCliente)" Title="Email del Responsable" Width="150px" />
                    <RadzenDataGridColumn Property="@nameof(ReporteExt.DescEstado)" Title="Estado" Width="150px" />
                    <RadzenDataGridColumn Property="@nameof(ReporteExt.CantidadHorasFacturables)" Title="Horas Facturables" Width="80px" />
                    <RadzenDataGridColumn Property="@nameof(ReporteExt.CantidadHorasNoFacturables)" Title="Horas No Facturables" Width="80px" />
                    <RadzenDataGridColumn Property="@nameof(ReporteExt.Confirmacion)" Title="Confirmado" Width="80px">
                        <Template Context="ReporteExt">
                            <RadzenSwitch @bind-Value=@ReporteExt.Confirmacion Disabled="true"></RadzenSwitch>
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn Property="@nameof(ReporteExt.Facturado)" Title="Facturado" Width="80px">
                        <Template Context="ReporteExt">
                            <RadzenSwitch @bind-Value=@ReporteExt.Facturado Disabled="true"></RadzenSwitch>
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn Property="@nameof(ReporteExt.FechaCreacion)" Title="Creado" FormatString="{0:d}" Width="150px" />
                    <RadzenDataGridColumn Property="@nameof(ReporteExt.FechaModificacion)" Title="Modificado" FormatString="{0:d}" Width="150px" />
                    <RadzenDataGridColumn Context="ReporteExt" Width="50px" Filterable="false" Sortable="false" TextAlign="TextAlign.Right" Frozen="true" FrozenPosition="FrozenColumnPosition.Left">
                        <Template Context="ReporteExt">
                            @if (ReporteExt.EstadoId == "R")
                            {
                                <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger"
                                Variant="Variant.Flat" Size="Radzen.ButtonSize.Medium" Shade="Shade.Lighter" class="rounded-circle rz-my-1 rz-ms-1"
                                Click="@(args => OnDelete(ReporteExt))" />



                            }
                            <RadzenButton Icon="picture_as_pdf" ButtonStyle="ButtonStyle.Light"
                            Variant="Variant.Flat" Size="Radzen.ButtonSize.Medium" Shade="Shade.Lighter" class="rounded-circle rz-my-1 rz-ms-1"
                            Click="@(args => VerReporte(ReporteExt))" />
                        </Template>

                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        </RadzenStack>
    </div>
</div>


<Modal @ref="modalPdf" title="Reporte de Visita" Fullscreen="ModalFullscreen.Always" />


@code {
    public string Titulo { get; set; }
    private bool InProcess = true;

    string? ReporteID;
    RadzenDataGrid<ReporteExt> grid;
    IEnumerable<ReporteExt> dataList;
    IList<ReporteExt> selectedData;
    private Modal modalPdf = default!;
    

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        if (Titulo is null) Titulo = "Reportes";
        dataList = await GetDataList();
    }


    async Task FilterCleared()
    {
        ReporteID = null;
        await grid.FirstPage();
    }

    void OnRender(DataGridRenderEventArgs<ReporteExt> args)
    {
        if (args.FirstRender)
        {
            args.Grid.Sorts.Add(new SortDescriptor() { Property = "Id", SortOrder = SortOrder.Descending });

        }
    }


    private async Task<IEnumerable<ReporteExt>> GetDataList()
    {
        List<ReporteExt> model = new();
        try
        {
            var reportes = await processService.GetReporteConsultor(loginState.User.consultor!.Id);

            if (reportes is not null)
            {
                var listEstados = await configService.GetCatalogoGenerico("ESTADO_REPORTE");
                var listCategorias = await configService.GetCatalogoGenerico("CATEGORIA_REPORTE");
                model = (from e in reportes
                         join st in listEstados on e.EstadoId equals st.Id
                         join cat in listCategorias on e.CategoriaId equals cat.Id
                         select new ReporteExt
                        {
                            Id = e.Id,
                            Confirmacion = e.Confirmacion,
                            Facturado = e.Facturado,
                            EstadoId = e.EstadoId,
                            ClienteId = e.ClienteId,
                            Fecha = e.Fecha,
                            CategoriaId = e.CategoriaId,
                            TipoReporteId = e.TipoReporteId,
                            CantidadHorasFacturables = e.CantidadHorasFacturables,
                            CantidadHorasNoFacturables = e.CantidadHorasNoFacturables,
                            HoraEntrada = e.HoraEntrada,
                            HoraSalida = e.HoraSalida,
                            Descripcion = e.Descripcion,
                            TareasPendientes = e.TareasPendientes,
                            ConsultorId = e.ConsultorId,
                            ResponsableCliente = e.ResponsableCliente,
                            CorreoCliente = e.CorreoCliente,
                            Programado = e.Programado,
                            AgendaId = e.AgendaId,
                            ProyectoId = e.ProyectoId,
                            TareaId = e.TareaId,
                            ItemId = e.ItemId,
                            FechaCreacion = e.FechaCreacion,
                            UsuarioCreacion = e.UsuarioCreacion,
                            FechaModificacion = e.FechaModificacion,
                            UsuarioModificacion = e.UsuarioModificacion,
                            Cliente = e.Cliente == null ? null :
                                new Cliente
                                {
                                    Id = e.Cliente.Id,
                                    Nombre = e.Cliente.Nombre,
                                    Telefono = e.Cliente.Telefono,
                                    Cedula = e.Cliente.Cedula,
                                    Direccion = e.Cliente.Direccion,
                                    Contacto = e.Cliente.Contacto,
                                    Email = e.Cliente.Email,
                                    EstadoId = e.Cliente.EstadoId,
                                    Subsidiaria = e.Cliente.Subsidiaria,
                                    ClientePadre = e.Cliente.ClientePadre,
                                    FechaCreacion = e.Cliente.FechaCreacion,
                                    UsuarioCreacion = e.Cliente.UsuarioCreacion,
                                    FechaModificacion = e.Cliente.FechaModificacion,
                                    UsuarioModificacion = e.Cliente.UsuarioModificacion,
                                },
                            Consultor = e.Consultor == null ? null :
                                new Consultor
                                {
                                    Id = e.Consultor.Id,
                                    Usuario = e.Consultor.Usuario,
                                    Nombre = e.Consultor.Nombre,
                                    PrimerApellido = e.Consultor.PrimerApellido,
                                    SegundoApellido = e.Consultor.SegundoApellido,
                                    Email = e.Consultor.Email,
                                    Telefono = e.Consultor.Telefono,
                                    Activo = e.Consultor.Activo,
                                    FechaCreacion = e.Consultor.FechaCreacion,
                                    UsuarioCreacion = e.Consultor.UsuarioCreacion,
                                    FechaModificacion = e.Consultor.FechaModificacion,
                                    UsuarioModificacion = e.Consultor.UsuarioModificacion,
                                },
                                NombreCliente = e.Cliente!.Nombre,
                                NombreConsultor = $"{e.Consultor!.Nombre} {e.Consultor!.PrimerApellido} {e.Consultor!.SegundoApellido}",
                                DescEstado = st.Descripcion!,
                                DescCategoriaReporte = cat.Descripcion!,
                        }).ToList(); 
            }
        }
        catch (Exception)
        {
            await swal.FireAsync("Error", "Error al cargar la información solicitada.", SweetAlertIcon.Info);
        }

        InProcess = false;
        StateHasChanged();
        return model;
    }

    void OnColumnReordering(DataGridColumnReorderingEventArgs<ReporteExt> args)
    {
        if (args.ToColumn.Property == nameof(ReporteExt.Id))
        {
            args.Cancel = true;
        }
    }

    private async Task OnClickAdd()
    {
        NavigationManager.NavigateTo("./reportesdetalle/0/1");
    }

    protected async Task OnSelect(DataGridRowMouseEventArgs<ReporteExt> args)
    {
        NavigationManager.NavigateTo("./reportesdetalle/" + args.Data.Id + "/2");
        await InvokeAsync(() => { StateHasChanged(); });
    }

    protected async void OnDelete(ReporteExt ReporteExt)
    {
        NavigationManager.NavigateTo($"./reportesdetalle/{ReporteExt.Id}/3");
    }

    public async Task Export(string type)
    {
        var queryableList = dataList.AsQueryable();

        var query = new Query()
        {
            OrderBy = grid.Query.OrderBy,
            Filter = grid.Query.Filter,
            Select = string.Join(",", grid.ColumnsCollection.Where(c => c.GetVisible() && !string.IsNullOrEmpty(c.Property))
                                .Select(c => c.Property.Contains(".") ? $"{c.Property} as {c.Property.Replace(".", "_")}" : c.Property))
        };

        await ExportFile(queryableList, type, query);
    }

    public async Task ExportFile(IQueryable<ReporteExt> ReporteExt, string type, Radzen.Query? query = null)
    {
        string fileName = "Reportes";
        if (type == "csv")
        {
            fileName = $"{fileName}.csv";
            await exportData.ToCSV(exportData.ApplyQuery(ReporteExt, query), fileName);
        }
        else
        {
            fileName = $"{fileName}.xlsx";
            await exportData.ToExcel(exportData.ApplyQuery(ReporteExt, query), fileName);
        }
    }

    void RowRender(RowRenderEventArgs<ReporteExt> args)
    {
        switch (args.Data.EstadoId)
        {
            case "F":
                args.Attributes.Add("class", "radzen-grid-row-background-color-yellow-light rz-data-row");
                break;
            case "A":
                args.Attributes.Add("class", "radzen-grid-row-background-color-red-light rz-data-row");
                break;
            case "E":
                args.Attributes.Add("class", "radzen-grid-row-background-color-green-light rz-data-row");
                break;
            case "X":
                args.Attributes.Add("class", "radzen-grid-row-background-color-blue-light rz-data-row");
                break;
        }

    }

    protected async void VerReporte(ReporteExt ReporteExt)
    {
        
        var param = await configService.GetParametro();
        var logo = await GetLogo();
        var pdf = new Blazor_PDF.PDF.Report();
        string pdfPath = await pdf.GenerarReporteVisita(JSRuntime, true, ReporteExt, logo, param);
        await OnShowModalPdf(pdfPath);
    }

    private async Task<byte[]> GetLogo()
    {
        string fileName = $"LogoEmpresaHeader.png";
        var dirBase = Path.Combine(Directory.GetCurrentDirectory(), "wwwroot", "img");
        string fileSource = Path.Combine(dirBase, fileName);
        byte[] data = new byte[1];
        if (System.IO.File.Exists(fileSource))
        {
            data = System.IO.File.ReadAllBytes(fileSource);
        }
        return data;
    }

    private async Task OnShowModalPdf(string PdfPath)
    {

        await dialogService.OpenAsync<VisorPdf>("Reporte de Visita",
              new Dictionary<string, object>()
                {
                    { "PdfPath", PdfPath}
                },
              new DialogOptions()
              {
                  Resizable = true,
                  Draggable = true,
                  Resize = base.OnResize,
                  Drag = base.OnDrag,
                  Width = Settings != null ? Settings.Width : "1200px",
                  Height = Settings != null ? Settings.Height : "900px",
                  Left = Settings != null ? Settings.Left : null,
                  Top = Settings != null ? Settings.Top : null
              });
    }
}



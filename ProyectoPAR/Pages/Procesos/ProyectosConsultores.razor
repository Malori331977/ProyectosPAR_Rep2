@inherits DialogSettingLayout

<div class="card-body">
    <RadzenStack Gap="0.5rem">

        <RadzenDataGrid @ref="grid" Render="@OnRender" class="rz-border-radius-2"
        TItem="ProyectoConsultorExt"
        AllowFiltering="true"
        AllowColumnResize="true"
        FilterMode="FilterMode.SimpleWithMenu"
        PageSize="7"
        AllowPaging="true"
        AllowSorting="true"
        AllowMultiColumnSorting="true"
        ShowMultiColumnSortingIndex="true"
        Data="@dataList"
        ColumnWidth="300px"
        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
        FilterCleared=@FilterCleared
        SelectionMode="DataGridSelectionMode.Single"
        @bind-Value=@selectedData
        LogicalFilterOperator="LogicalFilterOperator.Or"
        FilterPopupRenderMode="PopupRenderMode.OnDemand"
        RowDoubleClick="@OnSelect"
        AllowColumnPicking="true"
        AllowColumnReorder="true"
        ColumnReordering="@OnColumnReordering">
            <HeaderTemplate>
                <RadzenStack Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.End" Gap="1rem;" Wrap="FlexWrap.Wrap">
                    <RadzenButton Shade="Shade.Light" ButtonStyle="ButtonStyle.Secondary" Icon="person_add" class="rounded-circle rz-my-1 rz-ms-1" Click="@(args => OnClickAdd())" />
                </RadzenStack>
            </HeaderTemplate>
            <Columns>
                <RadzenDataGridColumn Property="@nameof(ProyectoConsultorExt.NombreConsultor)"
                FilterValue="@consultorId"
                Filterable="true" Title="Consultor" 
                TextAlign="TextAlign.Left">
                </RadzenDataGridColumn>
                @if (ModoGlobal == 2)
                {
                    <RadzenDataGridColumn Context="ProyectoConsultorExt" Width="50px" Filterable="false" Sortable="false" TextAlign="TextAlign.Right" Frozen="true" FrozenPosition="FrozenColumnPosition.Left">
                        <Template Context="ProyectoConsultorExt">
                            <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger"
                            Variant="Variant.Flat" Size="Radzen.ButtonSize.Medium" Shade="Shade.Lighter" class="rounded-circle rz-my-1 rz-ms-1"
                            Click="@(args => OnDelete(ProyectoConsultorExt))" />
                        </Template>
                    </RadzenDataGridColumn>
                }

            </Columns>
        </RadzenDataGrid>
    </RadzenStack>
</div>


@code {
    [Parameter] public int ProyectoId { get; set; }
    [Parameter] public int ModoGlobal { get; set; }

    private bool InProcess = true;
    private int ModoLocal;

    string? consultorId;
    RadzenDataGrid<ProyectoConsultorExt> grid;
    IEnumerable<ProyectoConsultorExt> dataList;
    IList<ProyectoConsultorExt> selectedData;
    private IEnumerable<CatalogoGenerico>? listEstadoProyecto;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        dataList = await GetDataList();

    }


    async Task FilterCleared()
    {
        consultorId = null;
        await grid.FirstPage();
    }

    void OnRender(DataGridRenderEventArgs<ProyectoConsultorExt> args)
    {
        if (args.FirstRender)
        {
            args.Grid.Sorts.Add(new SortDescriptor() { Property = "ConsultorId", SortOrder = SortOrder.Ascending });

        }
    }


    private async Task<IEnumerable<ProyectoConsultorExt>> GetDataList()
    {
        List<ProyectoConsultorExt> model = new();
        try
        {
            var ProyectosConsultor = await processService.GetProyectoConsultor(ProyectoId);

            if (ProyectosConsultor is not null)
            {
                model = (from e in ProyectosConsultor
                         select new ProyectoConsultorExt
                         {
                             ProyectoId = e.ProyectoId,
                             ConsultorId = e.ConsultorId,
                             NombreConsultor = $"{e.Consultor!.PrimerApellido} {e.Consultor!.SegundoApellido} {e.Consultor!.Nombre}",
                             Consultor = e.Consultor,
                         }).ToList();
            }
        }
        catch (Exception)
        {
            await swal.FireAsync("Error", "Error al cargar la información solicitada.", SweetAlertIcon.Info);
        }

        InProcess = false;
        StateHasChanged();
        return model;
    }

    void OnColumnReordering(DataGridColumnReorderingEventArgs<ProyectoConsultorExt> args)
    {
        if (args.ToColumn.Property == nameof(ProyectoConsultorExt.ConsultorId))
        {
            args.Cancel = true;
        }
    }

    private async Task OnClickAdd()
    {

        await dialogService.OpenAsync<ConsultoresPop>("Consultores asignados",
              new Dictionary<string, object>()
                {
                    { "OnItemSelected", EventCallback.Factory.Create<IList<Consultor>>(this, HideModalConsultores)},
                    { "ConsultoresActuales", dataList}
                },
              new DialogOptions()
              {
                  Resizable = true,
                  Draggable = true,
                  Resize = base.OnResize,
                  Drag = base.OnDrag,
                  Width = Settings != null ? Settings.Width : "1000px",
                  Height = Settings != null ? Settings.Height : "700px",
                  Left = Settings != null ? Settings.Left : null,
                  Top = Settings != null ? Settings.Top : null
              });
    }

    private async Task HideModalConsultores(IList<Consultor> consultoresSeleccionados)
    {
        await GuardarProyectosConsultores(consultoresSeleccionados);
        dialogService.Close(true);
        await InvokeAsync(StateHasChanged);
    }

    private async Task GuardarProyectosConsultores(IList<Consultor> consultoresSeleccionados)
    {
        try
        {

            List<ProyectoConsultor> listAdd = new List<ProyectoConsultor>();

            listAdd = (from e in consultoresSeleccionados
                       select new ProyectoConsultor
                       {
                           ProyectoId = ProyectoId,
                           ConsultorId = e.Id,
                           FechaCreacion = DateTime.Now,
                           UsuarioCreacion = loginState.User.consultor!.Id.ToString(),
                           FechaModificacion = DateTime.Now,
                           UsuarioModificacion = loginState.User.consultor!.Id.ToString(),

                       }).ToList();

            EventResponse respuesta;

            respuesta = await genericService.Post("ProyectoConsultor", listAdd);


            if (respuesta.Id == "0")
            {
                dataList = await GetDataList();
            }
            else
            {
                await swal.FireAsync("Error al guardar consultores del proyecto.", respuesta.Descripcion, SweetAlertIcon.Error);
            }

        }
        catch (Exception e)
        {
            await swal.FireAsync("Error", "Ocurrió un error al ejecutar el proceso. Detalle de Error: " + e.Message, SweetAlertIcon.Error);
        }
    }

    protected async Task OnSelect(DataGridRowMouseEventArgs<ProyectoConsultorExt> args)
    {
        // NavigationManager.NavigateTo("./proyectosdetalle/" + args.Data.Id + "/2");
        // await InvokeAsync(() => { StateHasChanged(); });
    }

    protected async void OnDelete(ProyectoConsultorExt proyectoConsultor)
    {
        try
        {
            SweetAlertResult result = await swal.FireAsync(new SweetAlertOptions
            {
                Title = "Atención",
                Text = $"¿Está seguro(a) que desea eliminar el consultor de este proyecto?",
                Icon = SweetAlertIcon.Error,
                ShowCancelButton = true,
                ConfirmButtonText = "Sí",
                CancelButtonText = "No"
            });

            if (result.IsConfirmed)
            {
                var respuesta = await genericService.Delete("ProyectoConsultor", $"{proyectoConsultor.ProyectoId}|{proyectoConsultor.ConsultorId}");


                if (respuesta.Id == "0")
                {
                    dataList = await GetDataList();
                    StateHasChanged();
                }
                else
                {
                    await swal.FireAsync("Error al guardar consultores del proyecto.", respuesta.Descripcion, SweetAlertIcon.Error);
                }
            }
            

        }
        catch (Exception e)
        {
            await swal.FireAsync("Error", "Ocurrió un error al ejecutar el proceso. Detalle de Error: " + e.Message, SweetAlertIcon.Error);
        }
        
    }

    
}

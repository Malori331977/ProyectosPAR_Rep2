@page "/licenciasdetalle/{Id:int}/{Modo:int}"
@using JtSegEncrypta
@inherits DialogSettingLayout
@inject IEncriptaService encripta
@using GeotimeFuncionesLib.Utiles
@using TextCopy


@if (licencia == null)
{
    <SpinnerControl></SpinnerControl>
}
else
{
    <div class="card">
        <PageReturn Titulo="@Titulo" UrlRetorno="@UrlRetorno" />

        <div class="card-body">
            <RadzenTemplateForm Data="@licencia" Submit="@((LicenciaExt args) => { Guardar(args); })">
                <RadzenRow Gap="0.3rem" class="rz-p-0 rz-p-lg-2">                   
                    <RadzenColumn Size="12" SizeMD="12">
                        <RadzenStack>
                            <RadzenFieldset Text="@Titulo">
                                <RadzenStack Gap="0.3rem">
                                    <RadzenRow AlignItems="AlignItems.Center">
                                        @if (Modo != 1)
                                        {
                                            <RadzenColumn Size="12" SizeMD="2">
                                                <RadzenLabel Text="No. de Licencia" Component="id" />
                                                <RadzenNumeric @bind-Value=@licencia.Id Name="id" Disabled="true" />
                                            </RadzenColumn>
                                        }
                                        <RadzenColumn Size="12" SizeMD="@sizeCli">
                                            <RadzenLabel Text="No. de Contrato" Component="ContratoId" />
                                            <RadzenRow AlignItems="AlignItems.Center">
                                                <RadzenColumn Size="12" SizeMD="1">
                                                    <RadzenButton ButtonStyle="ButtonStyle.Info" Icon="search" class="rounded-circle rz-my-1 rz-ms-1" Disabled="@soloLecturaAdd" Size="Radzen.ButtonSize.Medium" Click=@OnShowModalContratos></RadzenButton>
                                                </RadzenColumn>
                                                <RadzenColumn Size="12" SizeMD="2">
                                                    <RadzenNumeric Style="width: 100%;" Name="ContratoId" @bind-Value="licencia.ContratoId" Disabled="@soloLecturaAdd"
                                                    @onfocusout="BuscarContrato" />
                                                </RadzenColumn>
                                                <RadzenColumn Size="12" SizeMD="2">
                                                    <RadzenTextBox Style="width: 100%;" Name="ClienteId" @bind-Value="licencia.ClienteId" Disabled="true"/>
                                                </RadzenColumn>
                                                <RadzenColumn Size="12" SizeMD="2">
                                                    <RadzenTextBox Style="width: 100%;" Disabled="true" @bind-Value="licencia.AliasCliente" />
                                                </RadzenColumn>
                                                <RadzenColumn>
                                                    <RadzenTextBox Style="width: 100%;" Disabled="true" @bind-Value="licencia.NombreCliente" />
                                                </RadzenColumn>
                                            </RadzenRow>
                                        </RadzenColumn>
                                    </RadzenRow>

                                    <RadzenRow AlignItems="AlignItems.Center">
                                        <RadzenColumn Size="12" SizeMD="3">
                                            <RadzenLabel Text="Producto" Component="ProductoId" />
                                            <RadzenDropDown @bind-Value="licencia.ProductoId"
                                            AllowClear="false"
                                            Change=@(args => OnChangeProducto(args))
                                            Placeholder="Seleccione el Producto"
                                            Data="@listProductos" Style="width: 100%;"
                                            ValueProperty="Id"
                                            TextProperty="Nombre"
                                            Name="ProductoId" Disabled="@soloLectura">
                                            </RadzenDropDown>
                                        </RadzenColumn>

                                        @if (product is not null)
                                        {
                                            @if (product.Tipo == "CA")
                                            {
                                                <RadzenColumn Size="12" SizeMD="3">
                                                    <RadzenLabel Text="Compañía" Component="bd" />
                                                    <RadzenTextBox Name="bd" @bind-Value="licencia.BaseDatos" Disabled="@soloLectura" Style="width: 100%" />
                                                </RadzenColumn>

                                                <RadzenColumn Size="12" SizeMD="3">
                                                    <RadzenLabel Text="Compañía" Component="bd" />
                                                    <RadzenTextBox Name="bd" @bind-Value="licencia.BaseDatos" Disabled="@soloLectura" Style="width: 100%" />
                                                </RadzenColumn>
                                            }
                                            else
                                            {
                                                <RadzenColumn Size="12" SizeMD="3">
                                                    <RadzenLabel Text="Base de Datos" Component="bd" />
                                                    <RadzenTextBox Name="bd" @bind-Value="licencia.BaseDatos" Disabled="@soloLectura" Style="width: 100%" />
                                                </RadzenColumn>
                                            }
                                            <RadzenColumn Size="12" SizeMD="2">
                                                <RadzenLabel Text="Estado de Licencia" Component="estadoId" />
                                                <RadzenDropDown @bind-Value="licencia.EstadoId"
                                                AllowClear="false"
                                                Placeholder="Seleccione el Estado"
                                                Data="@listEstados" Style="width: 100%;"
                                                ValueProperty="Id"
                                                TextProperty="Descripcion"
                                                Name="estadoId" Disabled="@soloLectura">
                                                </RadzenDropDown>
                                            </RadzenColumn>

                                            <RadzenColumn Size="12" SizeMD="2">
                                                <RadzenLabel Text="Fecha de Expiración" Component="fexp" />
                                                <RadzenDatePicker Style="width: 100%;" Name="fexp" @bind-Value="licencia.FechaExpiracion" Disabled="@soloLectura"
                                                ShowCalendarWeek DateFormat="dd/MM/yyyy" Max="DateTime.MaxValue" />
                                            </RadzenColumn>
                                            <RadzenColumn Size="12" SizeMD="2">
                                                <RadzenLabel Text="No Expira" Component="noexp" />
                                                <RadzenStack Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.Center">
                                                    <RadzenSwitch Placeholder="No Expira" Style="width: 25%;" Name="noexp"
                                                    @bind-Value="licencia.NoExpira" Disabled="@soloLectura" Change=@(args => OnChangeNoExpira(args))
                                                    InputAttributes="@(new Dictionary<string, object>() { { "aria-label", "Switch value" } })" />
                                                </RadzenStack>
                                            </RadzenColumn>

                                        }
                                    </RadzenRow> 

                                    <RadzenRow AlignItems="AlignItems.Center">
                                        @if (product!.Tipo == "CA")
                                        {
                                            <RadzenColumn Size="12" SizeMD="3">
                                                <RadzenLabel Text="Cantidad de Usuarios" Component="canusu" />
                                                <RadzenNumeric Format="N0" Name="canusu" @bind-Value="licencia.CantidadUsuarios" Disabled="@soloLectura" Style="width: 100%" TextAlign="TextAlign.Right" />
                                            </RadzenColumn>
                                            <RadzenColumn Size="12" SizeMD="3">
                                                <RadzenLabel Text="Cantidad de Empleados" Component="canempl" />
                                                <RadzenNumeric Format="N0" Name="canempl" @bind-Value="licencia.CantidadEmpleados" Disabled="@soloLectura" Style="width: 100%" TextAlign="TextAlign.Right" />
                                            </RadzenColumn>
                                            <RadzenColumn Size="12" SizeMD="1">
                                                <RadzenLabel Text="Distribuye Usuarios" Component="distusu" />
                                                <RadzenStack Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.Center">
                                                    <RadzenSwitch Placeholder="Distribuye Usuarios" Style="width: 25%;" Name="distusu"
                                                    @bind-Value="licencia.DistUsuarios" Disabled="@soloLectura"
                                                    InputAttributes="@(new Dictionary<string, object>() { { "aria-label", "Switch value" } })" />
                                                </RadzenStack>
                                            </RadzenColumn>
                                            <RadzenColumn Size="12" SizeMD="1">
                                                <RadzenLabel Text="Distribuye Empleados" Component="distemp" />
                                                <RadzenStack Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.Center">
                                                    <RadzenSwitch Placeholder="Distribuye Empleados" Style="width: 25%;" Name="distemp"
                                                    @bind-Value="licencia.DistEmpleados" Disabled="@soloLectura"
                                                    InputAttributes="@(new Dictionary<string, object>() { { "aria-label", "Switch value" } })" />
                                                </RadzenStack>
                                            </RadzenColumn>
                                        }
                                        else
                                        {
                                            <RadzenColumn Size="12" SizeMD="3">
                                                <RadzenLabel Text="Cantidad Empleados" Component="canempl" />
                                                <RadzenNumeric Format="N0" Name="canempl" @bind-Value="licencia.CantidadEmpleados" Disabled="@soloLectura" Style="width: 100%" TextAlign="TextAlign.Right" />
                                            </RadzenColumn>

                                            <RadzenColumn Size="12" SizeMD="1">
                                                <RadzenLabel Text="Ilimitado" Component="Ilimitado" />
                                                <RadzenStack Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.Center">
                                                    <RadzenSwitch Placeholder="Ilimitado" Style="width: 25%;" Name="Ilimitado"
                                                    @bind-Value="licencia.Ilimitado" Disabled="@soloLectura" Change=@(args => OnChangeIlimitado(args))
                                                    InputAttributes="@(new Dictionary<string, object>() { { "aria-label", "Switch value" } })" />


                                                </RadzenStack>
                                            </RadzenColumn>
                                        }
                                    </RadzenRow>

                                    <RadzenRow AlignItems="AlignItems.Center">
                                        <RadzenColumn Size="12" SizeMD="2">
                                            <RadzenButton class="rz-border-radius-6" ButtonStyle="Radzen.ButtonStyle.Secondary" Variant="Variant.Flat" Size="Radzen.ButtonSize.Large" Icon="generating_tokens" Text="Generar licencia" Click="@GenerarLicencia" />
                                        </RadzenColumn>                                       
                                        <RadzenColumn Size="12" SizeMD="9">
                                            <RadzenLabel Text="Código de Licencia" Component="codlic" />
                                            <RadzenTextArea Name="codlic" @bind-Value="licencia.LicenciaId" Disabled="true" Style="width: 100%" />
                                        </RadzenColumn>
                                        <RadzenColumn Size="12" SizeMD="1">
                                            <RadzenButton class="rz-border-radius-6" ButtonStyle="Radzen.ButtonStyle.Secondary" Variant="Variant.Flat" Size="Radzen.ButtonSize.Small" Icon="content_copy" Click="@CopyToClipBoard" />
                                        </RadzenColumn>
                                    </RadzenRow>
                                    <RadzenRow AlignItems="AlignItems.Center">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenLabel Text="Licencia Geo V3.X.X" Component="licgeo" />
                                            <RadzenTextArea Name="licgeo" @bind-Value="licencia.LicenciaIdGeo" Disabled="true" Style="width: 100%" />
                                        </RadzenColumn>
                                    </RadzenRow>
                                </RadzenStack>
                            </RadzenFieldset>
                        </RadzenStack>
                    </RadzenColumn>
                </RadzenRow>
                <RadzenStack Orientation="Radzen.Orientation.Horizontal" JustifyContent="JustifyContent.Center" Gap="0.5rem" class="rz-mt-8 rz-mb-4">
                    <RadzenButton class="rz-border-radius-6" ButtonType="Radzen.ButtonType.Submit" Size="Radzen.ButtonSize.Large" Icon="save" Text="Guardar" />
                    <RadzenButton class="rz-border-radius-6" ButtonStyle="Radzen.ButtonStyle.Success" Variant="Variant.Flat" Size="Radzen.ButtonSize.Large" Icon="cancel" Text="Cancelar" Click="@Cancelar" />
                </RadzenStack>
            </RadzenTemplateForm>
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }
    [Parameter] public int Modo { get; set; }

    private string Titulo = "Licencia";
    private string UrlRetorno = "./licenciaslist";
    private bool InProcess = true;
    private bool soloLectura = false;
    private bool soloLecturaAdd = false;
    private LicenciaExt? licencia = null;
    private string NombreCliente = "";
    int sizeCli = 12;
    private Contrato? contract;
    private Producto? product;

    private IEnumerable<Producto>? listProductos;
    private IEnumerable<CatalogoGenerico>? listEstados;

    private async Task LoadProductos() => listProductos = await mtoService.GetProducto();
    private async Task LoadEstados() => listEstados = await configService.GetCatalogoGenerico("ESTADO_GLOBAL");

    private async Task LoadLicencia()
    {


        if (Modo != 1)
        {
            var repo = await processService.GetLicencia(Id);

            if (repo is not null)
            {

                licencia = new LicenciaExt
                {
                    Id = repo.Id,
                    ProductoId = repo.ProductoId,
                    ContratoId = repo.ContratoId,
                    LicenciaId = repo.LicenciaId,
                    FechaExpiracion = repo.FechaExpiracion,
                    CantidadUsuarios = repo.CantidadUsuarios,
                    Ilimitado = repo.Ilimitado,
                    NoExpira = repo.NoExpira,
                    EstadoId = repo.EstadoId,
                    BaseDatos = repo.BaseDatos,
                    FechaCreacion = repo.FechaCreacion,
                    UsuarioCreacion = repo.UsuarioCreacion,
                    FechaModificacion = repo.FechaModificacion,
                    UsuarioModificacion = repo.UsuarioModificacion,
                    CantidadEmpleados = repo.CantidadEmpleados,
                    CantidadDispMoviles = repo.CantidadDispMoviles,
                    DistEmpleados = repo.DistEmpleados,
                    DistUsuarios = repo.DistUsuarios,
                    LicenciaIdGeo = repo.LicenciaIdGeo,
                    Producto = repo.Producto == null ? null :
                                 new Producto
                                 {
                                     Id = repo.Producto.Id,
                                     Aplicacion = repo.Producto.Aplicacion,
                                     Nombre = repo.Producto.Nombre,
                                     Version = repo.Producto.Version,
                                     EstadoId = repo.Producto.EstadoId,
                                     FechaCreacion = repo.Producto.FechaCreacion,
                                     UsuarioCreacion = repo.Producto.UsuarioCreacion,
                                     FechaModificacion = repo.Producto.FechaModificacion,
                                     UsuarioModificacion = repo.Producto.UsuarioModificacion,
                                     Tipo = repo.Producto.Tipo,
                                 },
                    Contrato = repo.Contrato == null ? null :
                                 new Contrato
                                 {
                                     Id = repo.Contrato.Id,
                                     ClienteId = repo.Contrato.ClienteId,
                                     Descripcion = repo.Contrato.Descripcion,
                                     FechaInicio = repo.Contrato.FechaInicio,
                                     FechaFin = repo.Contrato.FechaFin,
                                     FormaPagoId = repo.Contrato.FormaPagoId,
                                     CantidadHorasContratadas = repo.Contrato.CantidadHorasContratadas,
                                     CantidadHorasConsumidas = repo.Contrato.CantidadHorasConsumidas,
                                     CantidadEmpleadosContrato = repo.Contrato.CantidadEmpleadosContrato,
                                     EstadoId = repo.Contrato.EstadoId,
                                     Monto = repo.Contrato.Monto,
                                     FechaCreacion = repo.Contrato.FechaCreacion,
                                     UsuarioCreacion = repo.Contrato.UsuarioCreacion,
                                     FechaModificacion = repo.Contrato.FechaModificacion,
                                     UsuarioModificacion = repo.Contrato.UsuarioModificacion,
                                     NivelContratoId = repo.Contrato.NivelContratoId,
                                     Cliente = new Cliente
                                     {
                                         Id = repo.Contrato.Cliente!.Id,
                                         Nombre = repo.Contrato.Cliente.Nombre,
                                         Telefono = repo.Contrato.Cliente.Telefono,
                                         Cedula = repo.Contrato.Cliente.Cedula,
                                         Direccion = repo.Contrato.Cliente.Direccion,
                                         Contacto = repo.Contrato.Cliente.Contacto,
                                         Email = repo.Contrato.Cliente.Email,
                                         EstadoId = repo.Contrato.Cliente.EstadoId,
                                         Subsidiaria = repo.Contrato.Cliente.Subsidiaria,
                                         ClientePadre = repo.Contrato.Cliente.ClientePadre,
                                         FechaCreacion = repo.Contrato.Cliente.FechaCreacion,
                                         UsuarioCreacion = repo.Contrato.Cliente.UsuarioCreacion,
                                         FechaModificacion = repo.Contrato.Cliente.FechaModificacion,
                                         UsuarioModificacion = repo.Contrato.Cliente.UsuarioModificacion,
                                         Alias = repo.Contrato.Cliente.Alias,
                                     },
                                 },
                    NombreCliente = repo.Contrato!.Cliente!.Nombre,
                    ClienteId = repo.Contrato.Cliente.Id,
                    DescProducto = repo.Producto!.Nombre,
                    AliasCliente = repo.Contrato.Cliente.Alias,
                };
                contract = licencia.Contrato;
                product = licencia.Producto;
            }
        }
    }

    private List<Task> GetLoadTasks()
    {
        return new List<Task>
        {
            LoadEstados(),
            LoadProductos(),
            LoadLicencia(),

        };

    }

    protected override async Task OnInitializedAsync()
    {
        sizeCli = Modo == 1 ? 12 : 10;
        soloLectura = Modo == 3;
        try
        {
            // Definir la lista de tareas a llamar
            var tasks = GetLoadTasks();

            // Esperar a que todas las tareas se completen
            await Task.WhenAll(tasks);

            //Modos= 1:Insertar 2:Actualizar 3:Borrar 0:Consulta
            if (Modo != 1)
            {
                soloLecturaAdd = true;                
            }
            else
            {
                licencia = new LicenciaExt
                {
                    Id = 0,
                    ProductoId = 0,
                    ContratoId = 0,
                    LicenciaId = "",
                    FechaExpiracion = DateTime.Today.AddMonths(1),
                    CantidadUsuarios = 0,
                    Ilimitado = false,
                    NoExpira = false,
                    EstadoId = "A",
                    BaseDatos = "",
                    FechaCreacion = DateTime.Now,
                    UsuarioCreacion = loginState.User.consultor!.Id.ToString(),
                    FechaModificacion = DateTime.Now,
                    UsuarioModificacion = loginState.User.consultor!.Id.ToString(),                    
                    NombreCliente = "",
                    ClienteId = "",
                    DescProducto = "",
                    DistEmpleados = false,
                    DistUsuarios = false,
                    CantidadDispMoviles = 0,
                    CantidadEmpleados = 0,
                    LicenciaIdGeo = "",

                };
                product = new Producto
                    {
                        Id = -1,
                        Tipo = "CA",
                    };
            }
        }
        catch (Exception e)
        {
            await swal.FireAsync("Error", e.Message, SweetAlertIcon.Error);
        }

        InProcess = false;
        StateHasChanged();
    }

    private async Task Guardar(Licencia arg)
    {
        InProcess = true;
        try
        {
            if (await Validaciones())
            {
                if (String.IsNullOrEmpty(licencia!.LicenciaId))
                {
                    await swal.FireAsync("Atención", "Debe generar el código de la licencia.", SweetAlertIcon.Info);
                    return;
                }

                arg.Producto = null;
                arg.Contrato = null;
                arg.BaseDatos = arg.BaseDatos.ToUpper();

                List<Licencia> listAdd = new List<Licencia> { arg };

                EventResponse respuesta;
                if (Modo == 3)
                {
                    SweetAlertResult result = await swal.FireAsync(new SweetAlertOptions
                    {
                        Title = "Atención",
                        Text = $"¿Está seguro(a) que desea eliminar el licencia actual?",
                        Icon = SweetAlertIcon.Error,
                        ShowCancelButton = true,
                        ConfirmButtonText = "Sí",
                        CancelButtonText = "No"
                    });

                    if (result.IsConfirmed)
                    {
                        respuesta = await genericService.Delete("Licencia", arg.Id.ToString());
                    }
                    else
                    {
                        NavigationManager.NavigateTo(UrlRetorno);
                        return;
                    }
                }
                else
                {
                    respuesta = await genericService.Post("Licencia", listAdd);
                }

                if (respuesta.Id == "0")
                {
                    NavigationManager.NavigateTo(UrlRetorno);
                }
                else
                {
                    await swal.FireAsync("Error", respuesta.Descripcion, SweetAlertIcon.Error);
                }
            }
        }
        catch (Exception e)
        {
            await swal.FireAsync("Error", "Ocurrió un error al ejecutar el proceso. Detalle de Error: " + e.Message, SweetAlertIcon.Error);
        }
        finally
        {
            InProcess = false;
        }

    }

    private async Task GenerarLicencia()
    {
        try
        {
            if (await Validaciones())
            {
                if (product is null)
                    product = await mtoService.GetProducto(licencia!.ProductoId);

                if (product.Tipo == "AG")
                {
                    string strParametros = $"{contract!.Cliente!.Alias}|{licencia!.FechaExpiracion.ToString("yyyyMMdd")}|{licencia.CantidadUsuarios}|{(licencia.NoExpira ? 1 : 0)}|{licencia.BaseDatos}|{product!.Aplicacion}";

                    licencia.LicenciaId = encripta.Encrypt(strParametros);
                }
                else
                {

                    string strLic = $"{licencia!.BaseDatos}°{licencia.CantidadUsuarios}°{(licencia.NoExpira ? "Permanente" : licencia.FechaExpiracion.ToString("yyyy-MM-dd"))}°{licencia.CantidadEmpleados}°{licencia.CantidadDispMoviles}°{(licencia.DistUsuarios == true ? "T" : "F")}°{(licencia.DistEmpleados == true ? "T" : "F")}";
                    licencia!.LicenciaId = FuncionesGlobales.StringToHexadecimal(FuncionesGlobales.Encrypt(strLic));

                }




            }
        }
        catch (Exception e)
        {
            await swal.FireAsync("Error", "Ocurrió un error al ejecutar el proceso. Detalle de Error: " + e.Message, SweetAlertIcon.Error);
        }
        StateHasChanged();

    }

    private async Task<bool> Validaciones()
    {


        if (Modo != 3)
        {
            if (licencia!.ContratoId<=0)
            {
                await swal.FireAsync("Atención", "Debe indicar el número de contrato.", SweetAlertIcon.Info);
                return false;
            }

            if (licencia!.ProductoId<=0)
            {
                await swal.FireAsync("Atención", "Debe indicar el producto asociado a la licencia.", SweetAlertIcon.Info);
                return false;
            }


            if (String.IsNullOrEmpty(licencia!.BaseDatos))
            {
                await swal.FireAsync("Atención", $"Debe indicar el nombre de la {(product!.Tipo == "AG"?"Base de Datos":"Compañía")}.", SweetAlertIcon.Info);
                return false;
            }

            if (String.IsNullOrEmpty(licencia!.EstadoId))
            {
                await swal.FireAsync("Atención", "Debe indicar el estado de la licencia.", SweetAlertIcon.Info);
                return false;
            }

            if (!licencia.NoExpira)
            {
                if (licencia.FechaExpiracion < DateTime.Today.AddMonths(1))
                {
                    await swal.FireAsync("Atención", "La Fecha de expiración debe ser de al menos un mes hacia adelante.", SweetAlertIcon.Info);
                    return false;
                }
            }

            if (product!.Tipo == "AG")
            {
                if (!licencia.Ilimitado)
                {
                    if (licencia!.CantidadUsuarios <= 0)
                    {
                        await swal.FireAsync("Atención", "Debe indicar la cantidad de empleados asociados a la licencia.", SweetAlertIcon.Info);
                        return false;
                    }

                    var licenciasPorContrato = await processService.GetLicencia(licencia.ProductoId, licencia.ContratoId);
                    int empleadosUtilizados = 0;

                    if (licenciasPorContrato is not null)
                    {
                        if (Modo == 1)
                        {
                            empleadosUtilizados = licenciasPorContrato.Sum(e => e.CantidadUsuarios);
                        }
                        else
                        {
                            empleadosUtilizados = licenciasPorContrato.Where(e => e.Id != licencia.Id).Sum(e => e.CantidadUsuarios);
                        }

                    }

                    if ((empleadosUtilizados + licencia.CantidadUsuarios) > contract!.CantidadEmpleadosContrato)
                    {
                        await swal.FireAsync("Atención", $"La cantidad de empleados asignados a la licencia ({licencia.CantidadUsuarios}) supera la cantidad de empleados disponibles en el contrato ({contract!.CantidadEmpleadosContrato - empleadosUtilizados}).", SweetAlertIcon.Info);
                        return false;
                    }
                }
            }
            else
            {

            }
        }


        return true;
    }

    private async Task BuscarContrato()
    {
        if (licencia!.ContratoId<=0)
        {
            licencia.NombreCliente = "";
            licencia.ClienteId = "";
            licencia.AliasCliente = "";
            return;
        }

        contract = await processService.GetContrato(licencia.ContratoId);
        if (contract is not null)
        {
            if (contract.TipoContratoId == "LIC")
            {
                licencia.ClienteId = contract.Cliente!.Id;
                licencia.NombreCliente = contract.Cliente.Nombre;
                licencia.AliasCliente = contract.Cliente.Alias;

                if (Modo == 1)
                {
                    licencia.CantidadUsuarios = contract.CantidadEmpleadosContrato;
                }
            }
            else
            {
                await swal.FireAsync("Atención", "El contrato elegido no es de tipo Licenciamiento, por favor verifique.", SweetAlertIcon.Info);
                licencia.NombreCliente = "";
                licencia.ClienteId = "";
                licencia.AliasCliente = "";
            }

        }
        else
        {
            await swal.FireAsync("Atención", "El contrato no existe", SweetAlertIcon.Info);
            licencia.NombreCliente = "";
            licencia.ClienteId = "";
            licencia.AliasCliente = "";


        }
        StateHasChanged();
    }

    private async Task OnShowModalContratos()
    {

        await dialogService.OpenAsync<ContratosPop>("Contratos",
              new Dictionary<string, object>()
                {
                    { "OnItemSelected", EventCallback.Factory.Create<ContratoExt>(this, HideModalContratos)}
                },
              new DialogOptions()
              {
                  Resizable = true,
                  Draggable = true,
                  Resize = base.OnResize,
                  Drag = base.OnDrag,
                  Width = Settings != null ? Settings.Width : "1000px",
                  Height = Settings != null ? Settings.Height : "512px",
                  Left = Settings != null ? Settings.Left : null,
                  Top = Settings != null ? Settings.Top : null
              });
    }

    private async Task HideModalContratos(ContratoExt args)
    {
        licencia!.ContratoId = args.Id;
        await BuscarContrato();

        dialogService.Close(true);
        await InvokeAsync(StateHasChanged);
    }

    void Cancelar()
    {
        NavigationManager.NavigateTo(UrlRetorno);
    }

    void OnChangeIlimitado(bool? value)
    {
        if (contract is null) return;

        if ((bool)value!)
        {
            licencia!.CantidadUsuarios = 0;
        }
        else
        {
            licencia!.CantidadUsuarios = contract!.CantidadEmpleadosContrato;
        }

    }

    void OnChangeNoExpira(bool? value)
    {
        if (contract is null) return;

        if ((bool)value!)
        {
            licencia!.FechaExpiracion = (DateTime)contract!.FechaFin!;
        }
        else
        {
            licencia!.FechaExpiracion = DateTime.Today.AddMonths(1);
        }

    }

    private async Task OnChangeProducto(object args)
    {
        product = await mtoService.GetProducto(Int32.Parse(args.ToString()!));
    }

    private async Task CopyToClipBoard()
    {
        await ClipboardService.SetTextAsync(licencia!.LicenciaId);
    }


   


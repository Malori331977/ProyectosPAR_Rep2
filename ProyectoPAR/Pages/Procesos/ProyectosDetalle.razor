@page "/proyectosdetalle/{Id:int}/{Modo:int}"
@inherits DialogSettingLayout


@if (InProcess)
{
    <SpinnerControl></SpinnerControl>
}
else
{
    @if (proyecto is not null)
    {
        <div class="card">
            <PageReturn Titulo="@Titulo" UrlRetorno="@UrlRetorno" />

            <div class="card-body">
                <RadzenTemplateForm Data="@proyecto" Submit="@((Proyecto args) => { Guardar(args); })">
                    <RadzenAccordion Multiple="true">
                        <Items>
                            <RadzenAccordionItem Text="Datos Generales del Proyecto" Icon="work_history" Selected="@accordionDG" SelectedChanged="(e) => OnSelectedChance(e, 1)">
                                <RadzenFieldset>
                                    <RadzenStack Gap="0.1rem">
                                        <RadzenRow AlignItems="AlignItems.Center">
                                            <RadzenColumn Size="12" SizeMD="12">
                                                <RadzenLabel Text="Cliente" Component="ClienteId" />
                                                <RadzenRow AlignItems="AlignItems.Center">
                                                    <RadzenColumn Size="12" SizeMD="1">
                                                        <RadzenButton ButtonStyle="ButtonStyle.Info" Icon="search" class="rounded-circle rz-my-1 rz-ms-1" Disabled="@soloLecturaAdd" Size="Radzen.ButtonSize.Medium" Click=@OnShowModalClientes></RadzenButton>
                                                    </RadzenColumn>
                                                    <RadzenColumn Size="12" SizeMD="2">
                                                        <RadzenTextBox Style="width: 100%;" Name="ClienteId" @bind-Value="proyecto.ClienteId" Disabled="@soloLecturaAdd"
                                                        @onfocusout="BuscarCliente" />
                                                    </RadzenColumn>
                                                    <RadzenColumn Size="12" SizeMD="9">
                                                        <RadzenTextBox Style="width: 100%;" Disabled="true" @bind-Value="proyecto.NombreCliente" />
                                                    </RadzenColumn>

                                                </RadzenRow>
                                            </RadzenColumn>

                                        </RadzenRow>

                                        <RadzenRow AlignItems="AlignItems.Center">
                                            <RadzenColumn Size="12" SizeMD="2">
                                                <RadzenLabel Text="Fecha de Inicio" Component="FechaInicio" />
                                                <RadzenStack Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.Center">
                                                    <RadzenColumn Size="12" SizeMD="12" class="w-100">
                                                        <RadzenDatePicker Style="width: 100%;" Name="FechaInicio" @bind-Value="proyecto.FechaInicio" Disabled="@soloLectura"
                                                        ShowCalendarWeek DateFormat="dd/MM/yyyy" />
                                                    </RadzenColumn>
                                                </RadzenStack>
                                            </RadzenColumn>
                                            <RadzenColumn Size="12" SizeMD="2">
                                                <RadzenLabel Text="Fecha de Finalización" Component="FechaFin" />
                                                <RadzenStack Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.Center">
                                                    <RadzenColumn Size="12" SizeMD="12" class="w-100">
                                                        <RadzenDatePicker Style="width: 100%;" Name="FechaFin" @bind-Value="proyecto.FechaFin" Disabled="@soloLectura"
                                                        ShowCalendarWeek DateFormat="dd/MM/yyyy" />
                                                    </RadzenColumn>
                                                </RadzenStack>
                                            </RadzenColumn>
                                            <RadzenColumn Size="12" SizeMD="2">
                                                <RadzenLabel Text="Código de Proyecto" Component="CodProy" />
                                                <RadzenTextBox Style="width: 100%;" Name="CodProy" MaxLength="10" @bind-Value="proyecto.Codigo" Disabled="@soloLectura" />
                                            </RadzenColumn>
                                            <RadzenColumn Size="12" SizeMD="3">
                                                <RadzenLabel Text="Estado" Component="EstadoId" />
                                                <RadzenDropDown @bind-Value="proyecto.EstadoId"
                                                AllowClear="true"
                                                Placeholder="Seleccione Estado"
                                                Data="@listEstadoProyecto" Style="width: 100%;"
                                                ValueProperty="Id"
                                                TextProperty="Descripcion"
                                                Name="EstadoId" Disabled="@soloLectura">
                                                </RadzenDropDown>
                                            </RadzenColumn>
                                            <RadzenColumn Size="12" SizeMD="3">
                                                <RadzenLabel Text="Etapa de Proyecto" Component="EtapaId" />
                                                <RadzenDropDown @bind-Value="proyecto.EtapaId"
                                                AllowClear="true"
                                                Placeholder="Seleccione Etapa"
                                                Data="@listEtapaProyecto" Style="width: 100%;"
                                                ValueProperty="Id"
                                                TextProperty="Descripcion"
                                                Name="EtapaId" Disabled="@soloLectura">
                                                </RadzenDropDown>
                                            </RadzenColumn>

                                        </RadzenRow>

                                        <RadzenRow AlignItems="AlignItems.Center">
                                            <RadzenColumn Size="12" SizeMD="10">
                                                <RadzenLabel Text="Descripción" Component="desc" />
                                                <RadzenTextArea @bind-Value=@proyecto.Descripcion Style="width: 100%;height:125px" Name="desc" Disabled="@soloLectura" />
                                            </RadzenColumn>
                                            <RadzenColumn Size="12" SizeMD="2">
                                                <RadzenRow>
                                                    <RadzenColumn Size="12" SizeMD="12">
                                                        <RadzenLabel Text="Color de Fondo" Component="BackColorId" />
                                                        <RadzenStack Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.Center">
                                                            <RadzenColumn Size="12" SizeMD="1">
                                                                <GColorPicker @bind-ColorHexCode="@proyecto.BackColorId" />
                                                            </RadzenColumn>
                                                            <RadzenColumn Size="12" SizeMD="11" class="w-100">
                                                                <RadzenTextBox Style="width: 100%;" Name="BackColorId" @bind-Value="proyecto.BackColorId" Disabled="@soloLectura" />
                                                            </RadzenColumn>
                                                        </RadzenStack>
                                                    </RadzenColumn>
                                                </RadzenRow>
                                                <RadzenRow>
                                                    <RadzenColumn Size="12" SizeMD="12">
                                                        <RadzenLabel Text="Color de Fuente" Component="FontColorId" />
                                                        <RadzenStack Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.Center">
                                                            <RadzenColumn Size="12" SizeMD="1">
                                                                <GColorPicker @bind-ColorHexCode="@proyecto.FontColorId" />
                                                            </RadzenColumn>
                                                            <RadzenColumn Size="12" SizeMD="11" class="w-100">
                                                                <RadzenTextBox Style="width: 100%;" Name="FontColorId" @bind-Value="proyecto.FontColorId" Disabled="@soloLectura" />
                                                            </RadzenColumn>
                                                        </RadzenStack>
                                                    </RadzenColumn>
                                                </RadzenRow>

                                            </RadzenColumn>
                                        </RadzenRow>
                                    </RadzenStack>
                                    <RadzenStack Orientation="Radzen.Orientation.Horizontal" JustifyContent="JustifyContent.Center" class="rz-mt-1 rz-mb-1">
                                        <RadzenButton class="rz-border-radius-6" ButtonType="Radzen.ButtonType.Submit" Size="Radzen.ButtonSize.Large" Icon="save" Text="Guardar" />
                                        <RadzenButton class="rz-border-radius-6" ButtonStyle="Radzen.ButtonStyle.Light" Variant="Variant.Flat" Size="Radzen.ButtonSize.Large" Icon="cancel" Text="Cancelar" Click="@Cancelar" />
                                    </RadzenStack>
                                </RadzenFieldset>

                            </RadzenAccordionItem>
                            @if (Modo != 1)
                            {
                                <RadzenAccordionItem Text="Tareas del Proyecto" Icon="assignment_add" Selected="@accordionTareas" SelectedChanged="(e) => OnSelectedChance(e,2)">
                                    <RadzenFieldset>
                                        <ProyectosDetalleTareas ProyectoId="@proyecto.Id" ModoGlobal="@Modo"></ProyectosDetalleTareas>
                                    </RadzenFieldset>
                                </RadzenAccordionItem>
                                <RadzenAccordionItem Text="Datos Adicionales" Icon="manage_accounts" Selected="@accordionDA" SelectedChanged="(e) => OnSelectedChance(e,3)">
                                    <RadzenRow Gap="0.2rem">
                                        <RadzenColumn Size="12" SizeMD="6">
                                            <RadzenStack>
                                                <RadzenFieldset Text="Consultores asignados">
                                                    <ProyectosConsultores ProyectoId="@proyecto.Id" ModoGlobal="@Modo"></ProyectosConsultores>
                                                </RadzenFieldset>
                                            </RadzenStack>
                                        </RadzenColumn>
                                        <RadzenColumn Size="12" SizeMD="6">
                                            <RadzenStack>
                                                <RadzenFieldset Text="Documentos Adjuntos">
                                                    <ProyectosDocsAdjuntos ProyectoId="@proyecto.Id" ModoGlobal="@Modo"></ProyectosDocsAdjuntos>
                                                </RadzenFieldset>
                                            </RadzenStack>
                                        </RadzenColumn>
                                    </RadzenRow>
                                </RadzenAccordionItem>

                            }

                        </Items>
                    </RadzenAccordion>
                </RadzenTemplateForm>
            </div>
        </div>

    }



}

@code {
    [Parameter] public int Id { get; set; }
    [Parameter] public int Modo { get; set; }

    private string Titulo = "Proyecto";
    private string UrlRetorno = "./proyectoslist";
    private bool InProcess = true;
    private bool soloLectura = false;
    private bool soloLecturaAdd = false;
    private ProyectoExt? proyecto = new();
    bool accordionDG = true;
    bool accordionTareas = true;
    bool accordionDA = true;

    private IEnumerable<CatalogoGenerico>? listEstadoProyecto;
    private IEnumerable<CatalogoGenerico>? listEtapaProyecto;

    private async Task LoadEstadoProyecto() => listEstadoProyecto = await configService.GetCatalogoGenerico("ESTADO_PROYECTO");
    private async Task LoadEtapaProyecto() => listEtapaProyecto = await configService.GetCatalogoGenerico("ETAPAS_PROYECTO");

    private async Task LoadReporte()
    {
        if (Modo != 1)
        {
            var repo = await processService.GetProyecto(Id);

            if (repo is not null)
            {

                proyecto = new ProyectoExt
                {
                    Id = repo.Id,
                    Descripcion = repo.Descripcion,
                    ClienteId = repo.ClienteId,
                    FechaInicio = repo.FechaInicio,
                    FechaFin = repo.FechaFin,
                    EstadoId = repo.EstadoId,
                    Observaciones = repo.Observaciones,
                    FechaCreacion = repo.FechaCreacion,
                    UsuarioCreacion = repo.UsuarioCreacion,
                    FechaModificacion = repo.FechaModificacion,
                    UsuarioModificacion = repo.UsuarioModificacion,
                    NombreCliente = repo.Cliente!.Nombre,
                    EtapaId = repo.EtapaId,
                    Codigo = repo.Codigo,
                    BackColorId = repo.BackColorId,
                    FontColorId = repo.FontColorId,
                    Cliente = repo.Cliente == null ? null :
                                    new Cliente
                                    {
                                        Id = repo.Cliente.Id,
                                        Nombre = repo.Cliente.Nombre,
                                        Telefono = repo.Cliente.Telefono,
                                        Cedula = repo.Cliente.Cedula,
                                        Direccion = repo.Cliente.Direccion,
                                        Contacto = repo.Cliente.Contacto,
                                        Email = repo.Cliente.Email,
                                        EstadoId = repo.Cliente.EstadoId,
                                        Subsidiaria = repo.Cliente.Subsidiaria,
                                        ClientePadre = repo.Cliente.ClientePadre,
                                        FechaCreacion = repo.Cliente.FechaCreacion,
                                        UsuarioCreacion = repo.Cliente.UsuarioCreacion,
                                        FechaModificacion = repo.Cliente.FechaModificacion,
                                        UsuarioModificacion = repo.Cliente.UsuarioModificacion,
                                    },
                };
            }
        }
    }

    private List<Task> GetLoadTasks()
    {
        return new List<Task>
        {
            LoadEstadoProyecto(),
            LoadEtapaProyecto(),
            LoadReporte(),
        };

    }

    protected override async Task OnInitializedAsync()
    {

        soloLectura = Modo == 3;
        try
        {
            // Definir la lista de tareas a llamar
            var tasks = GetLoadTasks();

            // Esperar a que todas las tareas se completen
            await Task.WhenAll(tasks);

            listEtapaProyecto = listEtapaProyecto!.OrderBy(e=>e.Id);

            //Modos= 1:Insertar 2:Actualizar 3:Borrar 0:Consulta
            if (Modo != 1)
            {
                soloLecturaAdd = true;
            }
            else
            {
                proyecto = new ProyectoExt
                {
                    Id = 0,
                    Descripcion = "",
                    ClienteId = "",
                    FechaInicio = DateTime.Now,
                    FechaFin = DateTime.Now,
                    EstadoId = "D",
                    Observaciones = "",
                    NombreCliente = "",
                    EtapaId = "",
                    FechaCreacion = DateTime.Now,
                    UsuarioCreacion = loginState.User.consultor!.Id.ToString(),
                    FechaModificacion = DateTime.Now,
                    UsuarioModificacion = loginState.User.consultor!.Id.ToString(),
                };
            }
        }
        catch (Exception e)
        {
            await swal.FireAsync("Error", e.Message, SweetAlertIcon.Error);
        }

        InProcess = false;
        StateHasChanged();
    }

    private async Task Guardar(Proyecto arg)
    {
        InProcess = true;
        try
        {
            if (await Validaciones())
            {
                arg.Cliente = null;
                List<Proyecto> listAdd = new List<Proyecto> { arg };

                EventResponse respuesta;
                if (Modo == 3)
                {
                    SweetAlertResult result = await swal.FireAsync(new SweetAlertOptions
                    {
                        Title = "Atención",
                        Text = $"¿Está seguro(a) que desea eliminar el proyecto actual?",
                        Icon = SweetAlertIcon.Error,
                        ShowCancelButton = true,
                        ConfirmButtonText = "Sí",
                        CancelButtonText = "No"
                    });

                    if (result.IsConfirmed)
                    {
                        respuesta = await genericService.Delete("Proyecto", arg.Id.ToString());
                    }
                    else
                    {
                        NavigationManager.NavigateTo(UrlRetorno);
                        return;
                    }
                }
                else
                {
                    respuesta = await genericService.Post("Proyecto", listAdd);
                }

                if (respuesta.Id == "0")
                {
                    NavigationManager.NavigateTo(UrlRetorno);
                }
                else
                {
                    await swal.FireAsync("Error", respuesta.Descripcion, SweetAlertIcon.Error);
                }
            }
        }
        catch (Exception e)
        {
            await swal.FireAsync("Error", "Ocurrió un error al ejecutar el proceso. Detalle de Error: " + e.Message, SweetAlertIcon.Error);
        }
        finally
        {
            InProcess = false;
        }

    }

    private async Task<bool> Validaciones()
    {


        if (Modo != 3)
        {

            if (String.IsNullOrEmpty(proyecto!.ClienteId))
            {
                await swal.FireAsync("Atención", "Debe indicar los datos de Cliente.", SweetAlertIcon.Info);
                return false;
            }
            if (String.IsNullOrEmpty(proyecto.Descripcion))
            {
                await swal.FireAsync("Atención", "Debe indicar la descripción del Proyecto.", SweetAlertIcon.Info);
                return false;
            }
            if (proyecto.FechaInicio == new DateTime(0001,01, 01))
            {
                await swal.FireAsync("Atención", "Debe indicar la fecha de inicio.", SweetAlertIcon.Info);
                return false;
            }
            if (proyecto.FechaFin == new DateTime(0001, 01, 01))
            {
                await swal.FireAsync("Atención", "Debe indicar la fecha de finalización.", SweetAlertIcon.Info);
                return false;
            }
            if (proyecto.FechaInicio > proyecto.FechaFin)
            {
                await swal.FireAsync("Atención", "La fecha de inicio no puede se mayor que la fecha de finalización.", SweetAlertIcon.Info);
                return false;
            }

            if (String.IsNullOrEmpty(proyecto.EtapaId))
            {
                await swal.FireAsync("Atención", "Debe indicar la etapa del Proyecto.", SweetAlertIcon.Info);
                return false;
            }
        }


        return true;
    }

    void Cancelar()
    {
        NavigationManager.NavigateTo(UrlRetorno);
    }


    private async Task BuscarCliente()
    {
        if (String.IsNullOrEmpty(proyecto!.ClienteId))
        {
            proyecto.NombreCliente = "";
            return;
        }

        var cliente = await mtoService.GetCliente(proyecto.ClienteId);
        if (cliente is not null)
        {
            proyecto.NombreCliente = cliente.Nombre;
        }
        StateHasChanged();
    }

    private async Task OnShowModalClientes()
    {
        await dialogService.OpenAsync<ClientesPop>("Clientes",
              new Dictionary<string, object>()
                {
                    { "OnItemSelected", EventCallback.Factory.Create<Cliente>(this, HideModalClientes)}
                },
              new DialogOptions()
              {
                  Resizable = true,
                  Draggable = true,
                  Resize = base.OnResize,
                  Drag = base.OnDrag,
                  Width = Settings != null ? Settings.Width : "700px",
                  Height = Settings != null ? Settings.Height : "512px",
                  Left = Settings != null ? Settings.Left : null,
                  Top = Settings != null ? Settings.Top : null
              });
    }

    private async Task HideModalClientes(Cliente args)
    {
        proyecto!.ClienteId = args.Id;
        proyecto.NombreCliente = args.Nombre;

        dialogService.Close(true);
        await InvokeAsync(StateHasChanged);
    }

    private void OnSelectedChance(bool selected, int index)
    {
        switch (index)
        {
            case 1:
                accordionDG = selected;
                break;
            case 2:
                accordionTareas = selected;
                break;
            case 3:
                accordionDA = selected;
                break;
        }
        
    }

}


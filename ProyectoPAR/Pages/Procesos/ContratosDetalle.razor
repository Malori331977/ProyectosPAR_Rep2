@page "/contratosdetalle/{Id:int}/{Modo:int}"
@inherits DialogSettingLayout


@if (contrato == null)
{
    <SpinnerControl></SpinnerControl>
}
else
{
    <div class="card">
        <PageReturn Titulo="@Titulo" UrlRetorno="@UrlRetorno" />

        <div class="card-body">
            <RadzenTemplateForm Data="@contrato" Submit="@((Contrato args) => { Guardar(args); })">
                <RadzenRow Gap="0.3rem" class="rz-p-0 rz-p-lg-2">                   
                    <RadzenColumn Size="12" SizeMD="12">
                        <RadzenStack>
                            <RadzenFieldset Text="@Titulo">
                                <RadzenStack Gap="0.3rem">
                                    <RadzenRow AlignItems="AlignItems.Center">
                                        @if (Modo != 1)
                                        {
                                            <RadzenColumn Size="12" SizeMD="2">
                                                <RadzenLabel Text="No. de Contrato" Component="id" />
                                                <RadzenNumeric @bind-Value=@contrato.Id Name="id" Disabled="true" />
                                            </RadzenColumn>
                                        }
                                        <RadzenColumn Size="12" SizeMD="@sizeCli">
                                            <RadzenLabel Text="Cliente" Component="ClienteId" />
                                            <RadzenRow AlignItems="AlignItems.Center">
                                                <RadzenColumn Size="12" SizeMD="1">
                                                    <RadzenButton ButtonStyle="ButtonStyle.Info" Icon="search" class="rounded-circle rz-my-1 rz-ms-1" Disabled="@soloLecturaAdd" Size="Radzen.ButtonSize.Medium" Click=@OnShowModalClientes></RadzenButton>
                                                </RadzenColumn>
                                                <RadzenColumn Size="12" SizeMD="2">
                                                    <RadzenTextBox Style="width: 100%;" Name="ClienteId" @bind-Value="contrato.ClienteId" Disabled="@soloLecturaAdd"
                                                    @onfocusout="BuscarCliente" />
                                                </RadzenColumn>
                                                <RadzenColumn Size="12" SizeMD="9">
                                                    <RadzenTextBox Style="width: 100%;" Disabled="true" @bind-Value="NombreCliente" />
                                                </RadzenColumn>
                                            </RadzenRow>
                                        </RadzenColumn>
                                    </RadzenRow>
                                    <RadzenRow AlignItems="AlignItems.Center">                                                                           
                                        <RadzenColumn Size="12">
                                            <RadzenLabel Text="Descrpción" Component="descripcion" />
                                            <RadzenTextArea @bind-Value=@contrato.Descripcion Style="width: 100%;height:100px" Name="descripcion" Disabled="@soloLectura" />
                                        </RadzenColumn>
                                    </RadzenRow>


                                    <RadzenRow AlignItems="AlignItems.Center">
                                        <RadzenColumn Size="12" SizeMD="3">
                                            <RadzenLabel Text="Tipo de Contrato" Component="TipoContratoId" />
                                            <RadzenDropDown @bind-Value="contrato.TipoContratoId"
                                                            AllowClear="false"
                                                            Placeholder="Seleccione Tipo de Contrato"
                                                            Data="@listTipoContrato" Style="width: 100%;"
                                                            ValueProperty="Id"
                                                            TextProperty="Descripcion"
                                                            Name="TipoContratoId" Disabled="@soloLectura">
                                            </RadzenDropDown>
                                        </RadzenColumn>
                                        <RadzenColumn Size="12" SizeMD="3">
                                            <RadzenLabel Text="Estado" Component="EstadoId" />
                                            <RadzenDropDown @bind-Value="contrato.EstadoId"
                                                            AllowClear="false"
                                                            Placeholder="Seleccione Estado"
                                                            Data="@listEstadoContrato" Style="width: 100%;"
                                                            ValueProperty="Id"
                                                            TextProperty="Descripcion"
                                                            Name="EstadoId" Disabled="@soloLectura">
                                            </RadzenDropDown>
                                        </RadzenColumn>
                                        <RadzenColumn Size="12" SizeMD="3">
                                            <RadzenLabel Text="Nivel de Contrato" Component="NivelId" />
                                            <RadzenDropDown @bind-Value="contrato.NivelContratoId"
                                                            AllowClear="false"
                                                            Placeholder="Seleccione Nivel de Contrato"
                                                            Data="@listNivelContrato" Style="width: 100%;"
                                                            ValueProperty="Id"
                                                            TextProperty="Descripcion"
                                                            Name="NivelId" Disabled="@soloLectura">
                                            </RadzenDropDown>
                                        </RadzenColumn>
                                        <RadzenColumn Size="12" SizeMD="3">
                                            <RadzenLabel Text="Forma de Pago" Component="FormaPagoId" />
                                            <RadzenDropDown @bind-Value="contrato.FormaPagoId"
                                                            AllowClear="false"
                                                            Placeholder="Seleccione Forma de Pago"
                                                            Data="@listFormaPago" Style="width: 100%;"
                                                            ValueProperty="Id"
                                                            TextProperty="Descripcion"
                                                            Name="FormaPagoId" Disabled="@soloLectura">
                                            </RadzenDropDown>
                                        </RadzenColumn>
                                    </RadzenRow>
                                    <RadzenRow AlignItems="AlignItems.Center">
                                        <RadzenColumn Size="12" SizeMD="2">
                                            <RadzenLabel Text="Fecha de Inicio" Component="FechaInicio" />                                            
                                            <RadzenDatePicker Style="width: 100%;" Name="FechaInicio" @bind-Value="contrato.FechaInicio" Disabled="@soloLectura"
                                            ShowCalendarWeek DateFormat="MM/dd/yyyy" />
                                        </RadzenColumn>
                                        <RadzenColumn Size="12" SizeMD="2">
                                            <RadzenLabel Text="Fecha de Finalización" Component="FechaFin" />                                       
                                            <RadzenDatePicker Style="width: 100%;" Name="FechaFin" @bind-Value="contrato.FechaFin" Disabled="@soloLectura"
                                            ShowCalendarWeek DateFormat="MM/dd/yyyy" />                                          
                                        </RadzenColumn>
                                        <RadzenColumn Size="12" SizeMD="2">
                                            <RadzenLabel Text="Horas Contratadas" Component="hcontratadas" />
                                            <RadzenNumeric Format="N2" Name="hcontratadas" @bind-Value="contrato.CantidadHorasContratadas" Disabled="@soloLectura" Style="width: 100%" TextAlign="TextAlign.Right"/>
                                        </RadzenColumn>
                                        <RadzenColumn Size="12" SizeMD="2">
                                            <RadzenLabel Text="Horas Consumidas" Component="hconsumidas" />
                                            <RadzenNumeric Format="N2" Name="hcontratadas" @bind-Value="contrato.CantidadHorasConsumidas" Disabled="true" Style="width: 100%" TextAlign="TextAlign.Right" />
                                        </RadzenColumn>
                                        <RadzenColumn Size="12" SizeMD="1">
                                            <RadzenLabel Text="# Empleados" Component="canempl" />
                                            <RadzenNumeric Format="N0" Name="canempl" @bind-Value="contrato.CantidadEmpleadosContrato" Disabled="@soloLectura" Style="width: 100%" TextAlign="TextAlign.Right" />
                                        </RadzenColumn>
                                        <RadzenColumn Size="12" SizeMD="2">
                                            <RadzenLabel Text="Monto del Contrato" Component="monto" />
                                            <RadzenNumeric Format="N2" Name="monto" @bind-Value="contrato.Monto" Disabled="@soloLectura" Style="width: 100%" TextAlign="TextAlign.Right" />
                                        </RadzenColumn>
                                        <RadzenColumn Size="12" SizeMD="1">
                                            <RadzenLabel Text="Moneda" Component="moneda" />
                                            <RadzenDropDown @bind-Value="contrato.MonedaId"
                                            AllowClear="false"
                                            Placeholder="Seleccione Moneda"
                                            Data="@listMoneda" Style="width: 100%;"
                                            ValueProperty="Id"
                                            TextProperty="Descripcion"
                                            Name="moneda" Disabled="@soloLectura">
                                            </RadzenDropDown>
                                        </RadzenColumn>
                                    </RadzenRow>                               
                                </RadzenStack>
                            </RadzenFieldset>
                        </RadzenStack>
                    </RadzenColumn>
                </RadzenRow>
                <RadzenStack Orientation="Radzen.Orientation.Horizontal" JustifyContent="JustifyContent.Center" Gap="0.5rem" class="rz-mt-8 rz-mb-4">
                    <RadzenButton class="rz-border-radius-6" ButtonType="Radzen.ButtonType.Submit" Size="Radzen.ButtonSize.Large" Icon="save" Text="Guardar" />
                    <RadzenButton class="rz-border-radius-6" ButtonStyle="Radzen.ButtonStyle.Light" Variant="Variant.Flat" Size="Radzen.ButtonSize.Large" Icon="cancel" Text="Cancelar" Click="@Cancelar" />
                </RadzenStack>
            </RadzenTemplateForm>
        </div>
    </div>



}

@code {
    [Parameter] public int Id { get; set; }
    [Parameter] public int Modo { get; set; }

    private string Titulo = "Contrato";
    private string UrlRetorno = "./contratoslist";
    private bool InProcess = true;
    private bool soloLectura = false;
    private bool soloLecturaAdd = false;
    private Contrato? contrato = null;
    private string NombreCliente = "";
    int sizeCli = 12;

    private IEnumerable<CatalogoGenerico>? listEstadoContrato;
    private IEnumerable<CatalogoGenerico>? listNivelContrato;
    private IEnumerable<CatalogoGenerico>? listFormaPago;
    private IEnumerable<CatalogoGenerico>? listMoneda;
    private IEnumerable<CatalogoGenerico>? listTipoContrato;
    private async Task LoadEstadoContrato() => listEstadoContrato = await configService.GetCatalogoGenerico("ESTADO_CONTRATO");
    private async Task LoadTipoContrato() => listTipoContrato = await configService.GetCatalogoGenerico("TIPO_CONTRATO");
    private async Task LoadNivelContrato() => listNivelContrato = await configService.GetCatalogoGenerico("NIVEL_CONTRATO");
    private async Task LoadFormaPago() => listFormaPago = await configService.GetCatalogoGenerico("FORMA_PAGO");
    private async Task LoadMoneda() => listMoneda = await configService.GetCatalogoGenerico("MONEDA");
    private async Task LoadContrato()
    {
        if (Modo != 1)
        {
            var repo = await processService.GetContrato(Id);

            if (repo is not null)
            {

                contrato = new Contrato
                {
                    Id = repo.Id,
                    ClienteId = repo.ClienteId,
                    Descripcion = repo.Descripcion,
                    FechaInicio = repo.FechaInicio,
                    FechaFin = repo.FechaFin,
                    EstadoId = repo.EstadoId,
                    FormaPagoId = repo.FormaPagoId,
                    CantidadHorasContratadas = repo.CantidadHorasContratadas,
                    CantidadHorasConsumidas = repo.CantidadHorasConsumidas,
                    NivelContratoId = repo.NivelContratoId,
                    Monto = repo.Monto,
                    FechaCreacion = repo.FechaCreacion,
                    UsuarioCreacion = repo.UsuarioCreacion,
                    FechaModificacion = repo.FechaModificacion,
                    UsuarioModificacion = repo.UsuarioModificacion, 
                    Cliente = repo.Cliente,
                    MonedaId = repo.MonedaId,
                    TipoContratoId = repo.TipoContratoId,
                    CantidadEmpleadosContrato = repo.CantidadEmpleadosContrato,
                };

                NombreCliente = contrato.Cliente != null ? contrato.Cliente.Nombre : "";
            }
        }
    }

    private List<Task> GetLoadTasks()
    {
        return new List<Task>
        {
            LoadEstadoContrato(),
            LoadNivelContrato(),
            LoadFormaPago(),
            LoadContrato(),
            LoadMoneda(),
            LoadTipoContrato(),
        };

    }

    protected override async Task OnInitializedAsync()
    {
        sizeCli = Modo == 1 ? 12 : 10;
        soloLectura = Modo == 3;
        try
        {
            // Definir la lista de tareas a llamar
            var tasks = GetLoadTasks();

            // Esperar a que todas las tareas se completen
            await Task.WhenAll(tasks);

            //Modos= 1:Insertar 2:Actualizar 3:Borrar 0:Consulta
            if (Modo != 1)
            {
                soloLecturaAdd = true;                
            }
            else
            {
                contrato = new Contrato
                {
                    Id = 0,
                    ClienteId = "",
                    Descripcion = "",
                    FechaInicio = DateTime.Now,
                    FechaFin = DateTime.Now,
                    EstadoId = "A",
                    FormaPagoId = "CONT",
                    CantidadHorasContratadas = 0M,
                    CantidadHorasConsumidas = 0M,
                    NivelContratoId = "B",
                    Monto = 0,
                    FechaCreacion = DateTime.Now,
                    UsuarioCreacion = loginState.User.consultor!.Id.ToString(),
                    FechaModificacion = DateTime.Now,
                    UsuarioModificacion = loginState.User.consultor!.Id.ToString(),
                    MonedaId = "USD",
                    TipoContratoId = "SOP",
                    CantidadEmpleadosContrato=0,
                };
            }
        }
        catch (Exception e)
        {
            await swal.FireAsync("Error", e.Message, SweetAlertIcon.Error);
        }

        InProcess = false;
        StateHasChanged();
    }

    private async Task Guardar(Contrato arg)
    {
        InProcess = true;
        try
        {
            if (await Validaciones())
            {

                List<Contrato> listAdd = new List<Contrato> { arg };

                EventResponse respuesta;
                if (Modo == 3)
                {
                    SweetAlertResult result = await swal.FireAsync(new SweetAlertOptions
                    {
                        Title = "Atención",
                        Text = $"¿Está seguro(a) que desea eliminar el contrato actual?",
                        Icon = SweetAlertIcon.Error,
                        ShowCancelButton = true,
                        ConfirmButtonText = "Sí",
                        CancelButtonText = "No"
                    });

                    if (result.IsConfirmed)
                    {
                        respuesta = await genericService.Delete("Contrato", arg.Id.ToString());
                    }
                    else
                    {
                        NavigationManager.NavigateTo(UrlRetorno);
                        return;
                    }
                }
                else
                {
                    respuesta = await genericService.Post("Contrato", listAdd);
                }

                if (respuesta.Id == "0")
                {
                    NavigationManager.NavigateTo(UrlRetorno);
                }
                else
                {
                    await swal.FireAsync("Error", respuesta.Descripcion, SweetAlertIcon.Error);
                }
            }
        }
        catch (Exception e)
        {
            await swal.FireAsync("Error", "Ocurrió un error al ejecutar el proceso. Detalle de Error: " + e.Message, SweetAlertIcon.Error);
        }
        finally
        {
            InProcess = false;
        }

    }

    private async Task<bool> Validaciones()
    {


        if (Modo != 3)
        {
            if (String.IsNullOrEmpty(contrato!.ClienteId))
            {
                await swal.FireAsync("Atención", "Debe indicar el cliente de este contrato.", SweetAlertIcon.Info);
                return false;
            }

            if (String.IsNullOrEmpty(contrato!.Descripcion))
            {
                await swal.FireAsync("Atención", "Debe indicar una descripción para el contrato.", SweetAlertIcon.Info);
                return false;
            }            

            //SI TIPO DE CONTRATO NO ES LICENCIAMIENTO, SE DEBE SOLICITAR HORAS CONTRATADAS Y MONTO DE FORMA OBLIGATORIA
            if (contrato.TipoContratoId != "LIC")
            {
                if (contrato!.CantidadHorasContratadas <= 0)
                {
                    await swal.FireAsync("Atención", "Debe indicar las horas del contrato.", SweetAlertIcon.Info);
                    return false;
                }

                if (contrato!.Monto <= 0)
                {
                    await swal.FireAsync("Atención", "Debe indicar el monto del contrato.", SweetAlertIcon.Info);
                    return false;
                }
            }
            else
            {
                if (contrato!.CantidadEmpleadosContrato <= 0)
                {
                    await swal.FireAsync("Atención", "Debe indicar la cantidad de empleados del contrato.", SweetAlertIcon.Info);
                    return false;
                }
            }


            

        }


        return true;
    }

    

    private async Task BuscarCliente()
    {
        if (String.IsNullOrEmpty(contrato!.ClienteId))
        {
            NombreCliente = "";
            return;
        }

        var cliente = await mtoService.GetCliente(contrato.ClienteId);
        if (cliente is not null)
        {
            NombreCliente = cliente.Nombre;
        }
        else
        {
            await swal.FireAsync("Atención", "El cliente no existe", SweetAlertIcon.Info);
            contrato.ClienteId = "";
            NombreCliente = "";
            

        }
        StateHasChanged();
    }

    private async Task OnShowModalClientes()
    {
        Dictionary<string, object> pd = new Dictionary<string, object>();
        pd.Add("OnItemSelected", HideModalClientes);

        await dialogService.OpenAsync<ClientesPop>("Clientes",
              new Dictionary<string, object>()
                {
                    { "OnItemSelected", EventCallback.Factory.Create<Cliente>(this, HideModalClientes)}
                },
              new DialogOptions()
              {
                  Resizable = true,
                  Draggable = true,
                  Resize = base.OnResize,
                  Drag = base.OnDrag,
                  Width = Settings != null ? Settings.Width : "700px",
                  Height = Settings != null ? Settings.Height : "512px",
                  Left = Settings != null ? Settings.Left : null,
                  Top = Settings != null ? Settings.Top : null
              });
    }

    private async Task HideModalClientes(Cliente args)
    {
        contrato!.ClienteId = args.Id;
        NombreCliente = args.Nombre;

        dialogService.Close(true);
        await InvokeAsync(StateHasChanged);
    }

    void Cancelar()
    {
        NavigationManager.NavigateTo(UrlRetorno);
    }

}


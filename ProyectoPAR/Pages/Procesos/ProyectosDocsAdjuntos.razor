@inherits DialogSettingLayout

<div class="card-body">
    <RadzenStack Gap="0.5rem">

        <RadzenDataGrid @ref="grid" Render="@OnRender" class="rz-border-radius-2"
        TItem="ProyectoDocAdjunto"
        AllowFiltering="true"
        AllowColumnResize="true"
        FilterMode="FilterMode.SimpleWithMenu"
        PageSize="7"
        AllowPaging="true"
        AllowSorting="true"
        AllowMultiColumnSorting="true"
        ShowMultiColumnSortingIndex="true"
        Data="@dataList"
        ColumnWidth="300px"
        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
        FilterCleared=@FilterCleared
        SelectionMode="DataGridSelectionMode.Single"
        @bind-Value=@selectedData
        LogicalFilterOperator="LogicalFilterOperator.Or"
        FilterPopupRenderMode="PopupRenderMode.OnDemand"
        RowDoubleClick="@OnSelect"
        AllowColumnPicking="true"
        AllowColumnReorder="true"
        ColumnReordering="@OnColumnReordering">
            <HeaderTemplate>
                <RadzenStack Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.End" Gap="1rem;" Wrap="FlexWrap.Wrap">
                    <RadzenButton Shade="Shade.Light" ButtonStyle="ButtonStyle.Secondary" Icon="person_add" class="rounded-circle rz-my-1 rz-ms-1" Click="@(args => OnClickAdd())" />
                </RadzenStack>
            </HeaderTemplate>
            <Columns>
                <RadzenDataGridColumn Property="@nameof(ProyectoDocAdjunto.NombreDocumento)"
                FilterValue="@nombre"
                Filterable="true" Title="Nombre de Documento"
                TextAlign="TextAlign.Left">
                </RadzenDataGridColumn>
                @if (ModoGlobal == 2)
                {
                    <RadzenDataGridColumn Context="ProyectoConsultorExt" Width="50px" Filterable="false" Sortable="false" TextAlign="TextAlign.Right" Frozen="true" FrozenPosition="FrozenColumnPosition.Left">
                        <Template Context="ProyectoConsultorExt">
                            <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger"
                            Variant="Variant.Flat" Size="Radzen.ButtonSize.Medium" Shade="Shade.Lighter" class="rounded-circle rz-my-1 rz-ms-1"
                            Click="@(args => OnDelete(ProyectoConsultorExt))" />
                        </Template>
                    </RadzenDataGridColumn>
                }

            </Columns>
        </RadzenDataGrid>
    </RadzenStack>
</div>


@code {
    [Parameter] public int ProyectoId { get; set; }
    [Parameter] public int ModoGlobal { get; set; }

    private bool InProcess = true;
    private int ModoLocal;

    string? nombre;
    RadzenDataGrid<ProyectoDocAdjunto> grid;
    IEnumerable<ProyectoDocAdjunto> dataList;
    IList<ProyectoDocAdjunto> selectedData;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        dataList = await GetDataList();

    }


    async Task FilterCleared()
    {
        nombre = null;
        await grid.FirstPage();
    }

    void OnRender(DataGridRenderEventArgs<ProyectoDocAdjunto> args)
    {
        if (args.FirstRender)
        {
            args.Grid.Sorts.Add(new SortDescriptor() { Property = "FechaCreacion", SortOrder = SortOrder.Ascending });

        }
    }


    private async Task<IEnumerable<ProyectoDocAdjunto>> GetDataList()
    {
        List<ProyectoDocAdjunto> model = new();
        try
        {
            var proyectoDocAdjunto = await processService.GetProyectoDocAdjunto(ProyectoId);

            if (proyectoDocAdjunto is not null)
            {
                model = proyectoDocAdjunto.OrderBy(e=>e.FechaCreacion).ToList();
            }
        }
        catch (Exception)
        {
            await swal.FireAsync("Error", "Error al cargar la información solicitada.", SweetAlertIcon.Info);
        }

        InProcess = false;
        StateHasChanged();
        return model;
    }

    void OnColumnReordering(DataGridColumnReorderingEventArgs<ProyectoDocAdjunto> args)
    {
        if (args.ToColumn.Property == nameof(ProyectoDocAdjunto.NombreDocumento))
        {
            args.Cancel = true;
        }
    }

    private async Task OnClickAdd()
    {

        await dialogService.OpenAsync<ProyectosDocsAdjuntosDetalle>("Documentos del Proyecto",
              new Dictionary<string, object>()
                {
                    { "OnSaveItem", EventCallback.Factory.Create<bool>(this, HideModalDocumentos)},
                    { "ProyectoId", ProyectoId},
                    { "Id", 0},
                    { "ModoGlobal", ModoGlobal},
                    { "Modo", 1},
                },
              new DialogOptions()
              {
                  Resizable = true,
                  Draggable = true,
                  Resize = base.OnResize,
                  Drag = base.OnDrag,
                  Width = Settings != null ? Settings.Width : "1250px",
                  Height = Settings != null ? Settings.Height : "600px",
                  Left = Settings != null ? Settings.Left : null,
                  Top = Settings != null ? Settings.Top : null
              });
    }

    private async Task HideModalDocumentos(bool args)
    {
        if (args)
        {
            dataList = await GetDataList();
            dialogService.Close(true);
        }
    }

    protected async Task OnSelect(DataGridRowMouseEventArgs<ProyectoDocAdjunto> args)
    {
        await dialogService.OpenAsync<ProyectosDocsAdjuntosDetalle>("Documentos del Proyecto",
             new Dictionary<string, object>()
               {
                    { "OnSaveItem", EventCallback.Factory.Create<bool>(this, HideModalDocumentos)},
                    { "ProyectoId", ProyectoId},
                    { "Id", args.Data.Id},
                    { "ModoGlobal", ModoGlobal},
                    { "Modo", 2},
               },
             new DialogOptions()
             {
                 Resizable = true,
                 Draggable = true,
                 Resize = base.OnResize,
                 Drag = base.OnDrag,
                 Width = Settings != null ? Settings.Width : "1250px",
                 Height = Settings != null ? Settings.Height : "600px",
                 Left = Settings != null ? Settings.Left : null,
                 Top = Settings != null ? Settings.Top : null
             });
    }

    protected async void OnDelete(ProyectoDocAdjunto proyectoDocAdjunto)
    {
        try
        {
            SweetAlertResult result = await swal.FireAsync(new SweetAlertOptions
            {
                Title = "Atención",
                Text = $"¿Está seguro(a) que desea eliminar el documento de este proyecto?",
                Icon = SweetAlertIcon.Error,
                ShowCancelButton = true,
                ConfirmButtonText = "Sí",
                CancelButtonText = "No"
            });

            if (result.IsConfirmed)
            {
                var respuesta = await genericService.Delete("ProyectoDocAdjunto", $"{proyectoDocAdjunto.ProyectoId}|{proyectoDocAdjunto.Id}");


                if (respuesta.Id == "0")
                {
                    dataList = await GetDataList();
                    StateHasChanged();
                }
                else
                {
                    await swal.FireAsync("Error al eliminar el documento del proyecto.", respuesta.Descripcion, SweetAlertIcon.Error);
                }
            }
            

        }
        catch (Exception e)
        {
            await swal.FireAsync("Error", "Ocurrió un error al ejecutar el proceso. Detalle de Error: " + e.Message, SweetAlertIcon.Error);
        }
        
    }

    
}

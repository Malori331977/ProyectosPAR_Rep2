@page "/licenciasmobilelist"
@layout MainLayout

<div class="card rz-background-color-base-200">
    <PageMant Titulo="@Titulo" OnClickAddSelected="OnClickAdd" />

    <div class="card-body">
        <RadzenStack Gap="0.5rem">
            @if (InProcess)
            {
                <SpinnerControl></SpinnerControl>
            }
        </RadzenStack>
    </div>

<RadzenAccordion>
    <Items>
        <RadzenAccordionItem Text="Licencias Móviles" Icon="event_available">
            <RadzenStack Gap="0.5rem">
                <RadzenDataGrid @ref="grid" Render="@OnRender" class="rz-border-radius-2"
                                PageSizeOptions="@Utiles.PageSizeOptions()"
                                TItem="LicenciaMobileExt"
                                AllowFiltering="true"
                                AllowColumnResize="true"
                                FilterMode="FilterMode.SimpleWithMenu"
                                PageSize="10"
                                AllowPaging="true"
                                AllowSorting="true"
                                AllowMultiColumnSorting="true"
                                ShowMultiColumnSortingIndex="true"
                                Data="@dataList"
                                ColumnWidth="300px"
                                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                FilterCleared=@FilterCleared
                                SelectionMode="DataGridSelectionMode.Single"
                                @bind-Value=@selectedData
                                LogicalFilterOperator="LogicalFilterOperator.Or"
                                FilterPopupRenderMode="PopupRenderMode.OnDemand"
                                AllowColumnPicking="true"
                                AllowColumnReorder="true"
                                RowDoubleClick="@OnSelect"
                                ColumnReordering="@OnColumnReordering">
                    <Columns>

                        <RadzenDataGridColumn Property="@nameof(LicenciaMobileExt.Id)" Filterable="true" Title="ID" Frozen="true" Width="100px" TextAlign="TextAlign.Center"/>
                        <RadzenDataGridColumn Property="@nameof(LicenciaMobileExt.ClienteId)" Title="Id Cliente" Width="150px" />
                        <RadzenDataGridColumn Property="@nameof(LicenciaMobileExt.AliasCliente)" Title="Alias" Width="200px" />
                        <RadzenDataGridColumn Property="@nameof(LicenciaMobileExt.NombreCliente)" Title="Nombre" Width="200px" />
                        <RadzenDataGridColumn Property="@nameof(LicenciaMobileExt.FechaCreacion)" Title="Creado" FormatString="{0:d}" Width="150px" />
                        <RadzenDataGridColumn Property="@nameof(LicenciaMobileExt.FechaModificacion)" Title="Modificado" FormatString="{0:d}" Width="150px" />
                            <RadzenDataGridColumn Context="LicenciaMobile" Width="50px" Filterable="false" Sortable="false" TextAlign="TextAlign.Right" Frozen="true" FrozenPosition="FrozenColumnPosition.Left">
                                <Template Context="LicenciaMobile">
                                    <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger"
                                                  Variant="Variant.Flat" Size="Radzen.ButtonSize.Medium" Shade="Shade.Lighter" class="rounded-circle rz-my-1 rz-ms-1"
                                                  Click="@(args => OnDelete(LicenciaMobile))" />
                                </Template>
                            </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
            </RadzenStack>
        </RadzenAccordionItem>
    </Items>
</RadzenAccordion>
</div>

    



@code {

    RadzenDataGrid<LicenciaMobileExt> grid;
    IEnumerable<LicenciaMobileExt> dataList;
    IList<LicenciaMobileExt> selectedData;

    public string Titulo { get; set; } = "Licencias Móviles";
    private bool InProcess = true;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        dataList = await GetDataList();
    }


    async Task FilterCleared()
    {
        await grid.FirstPage();
    }

    void OnRender(DataGridRenderEventArgs<LicenciaMobileExt> args)
    {
        if (args.FirstRender)
        {
            args.Grid.Sorts.Add(new SortDescriptor() { Property = "Id", SortOrder = SortOrder.Ascending });
        }
    }


    private async Task<IEnumerable<LicenciaMobileExt>> GetDataList()
    {
        List<LicenciaMobileExt> model = new();
        try
        {

            var licencias = await processService.GetLicenciaMobile();

            if (licencias is not null)
            {
                model = (from e in licencias
                         select new LicenciaMobileExt
                             {
                                 Id = e.Id,
                                 ClienteId = e.ClienteId,
                                 Cliente = e.Cliente == null ? null :
                                        new Cliente
                                        {
                                            Id = e.Cliente.Id,
                                            Nombre = e.Cliente.Nombre,
                                            FechaCreacion = e.Cliente.FechaCreacion,
                                            UsuarioCreacion = e.Cliente.UsuarioCreacion,
                                            FechaModificacion = e.Cliente.FechaModificacion,
                                            UsuarioModificacion = e.Cliente.UsuarioModificacion,
                                        },
                                 AliasCliente = e.Cliente == null ? "" : e.Cliente.Alias,
                                 NombreCliente = e.Cliente == null ? "" : e.Cliente.Nombre!,
                                 FechaCreacion = e.FechaCreacion,
                                 UsuarioCreacion = e.UsuarioCreacion,
                                 FechaModificacion = e.FechaModificacion,
                                 UsuarioModificacion = e.UsuarioModificacion,

                             }).ToList();

            }
        }
        catch (Exception)
        {
            await swal.FireAsync("Error", "Error al cargar la información solicitada.", SweetAlertIcon.Info);
        }
        InProcess = false;
        StateHasChanged();
        return model;
    }

    void OnColumnReordering(DataGridColumnReorderingEventArgs<LicenciaMobileExt> args)
    {
        if (args.ToColumn.Property == nameof(LicenciaMobileExt.Id))
        {
            args.Cancel = true;
        }
    }

    private async Task OnClickAdd()
    {
        NavigationManager.NavigateTo("./licenciasmobiledetalle/0/1");
    }

    protected async Task OnSelect(DataGridRowMouseEventArgs<LicenciaMobileExt> args)
    {
        NavigationManager.NavigateTo("./licenciasmobiledetalle/" + args.Data.Id + "/2");
        await InvokeAsync(() => { StateHasChanged(); });
    }

    protected async void OnDelete(LicenciaMobileExt LicenciaMobile)
    {
        NavigationManager.NavigateTo($"./licenciasmobiledetalle/{LicenciaMobile.Id}/3");
    }

}

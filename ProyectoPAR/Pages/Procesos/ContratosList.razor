@page "/contratoslist"
@layout MainLayout

<div class="card rz-background-color-base-200">
    <PageMant Titulo="@Titulo" OnClickAddSelected="OnClickAdd" />

    <div class="card-body">
        <RadzenStack Gap="0.5rem">
            @if (InProcess)
            {
                <SpinnerControl></SpinnerControl>
            }

            <RadzenDataGrid @ref="grid" Render="@OnRender" class="rz-border-radius-2"
                            PageSizeOptions="@Utiles.PageSizeOptions()"
            TItem="ContratoExt"
            AllowFiltering="true"
            AllowColumnResize="true"
            FilterMode="FilterMode.SimpleWithMenu"
            PageSize="7"
            AllowPaging="true"
            AllowSorting="true"
            AllowMultiColumnSorting="true"
            ShowMultiColumnSortingIndex="true"
            Data="@dataList"
            ColumnWidth="300px"
            FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
            FilterCleared=@FilterCleared
            SelectionMode="DataGridSelectionMode.Single"
            @bind-Value=@selectedData
            LogicalFilterOperator="LogicalFilterOperator.Or"
            FilterPopupRenderMode="PopupRenderMode.OnDemand"
            RowDoubleClick="@OnSelect"
            AllowColumnPicking="true"
            AllowColumnReorder="true"
            RowRender="@RowRender"
            ColumnReordering="@OnColumnReordering">
                <HeaderTemplate>
                    <RadzenStack Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem;" Wrap="FlexWrap.Wrap">
                        <RadzenButton class="rz-border-radius-6" Shade="Shade.Light" ButtonStyle="ButtonStyle.Success" Text="Exportar a XLS" Icon="grid_on" Click="@(args => Export("excel"))" />
                        <RadzenButton class="rz-border-radius-6" Shade="Shade.Light" ButtonStyle="ButtonStyle.Secondary" Text="Exportar a CSV" Icon="wrap_text" Click="@(args => Export("csv"))" />
                    </RadzenStack>
                </HeaderTemplate>
                <Columns>

                    <RadzenDataGridColumn Property="@nameof(ContratoExt.Id)"
                        FilterValue="@ContratoID"
                        Filterable="true" Title="ID"
                        Frozen="true"
                        Width="100px"
                        TextAlign="TextAlign.Center">
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn Property="@nameof(ContratoExt.DesctipoContrato)" Title="Tipo Contrato" Width="120px" />
                    <RadzenDataGridColumn Property="@nameof(ContratoExt.ClienteId)" Title="Id Cliente" Width="100px" />
                    <RadzenDataGridColumn Property="@nameof(ContratoExt.NombreCliente)" Title="Nombre de Cliente" Width="300px" /> 
                    <RadzenDataGridColumn Property="@nameof(ContratoExt.FechaInicio)" Title="Inicio" FormatString="{0:d}" Width="150px" />
                    <RadzenDataGridColumn Property="@nameof(ContratoExt.FechaFin)" Title="Fin" FormatString="{0:d}" Width="150px" />
                    <RadzenDataGridColumn Property="@nameof(ContratoExt.CantidadHorasContratadas)" Title="Horas Contratadas" FormatString="{0:N2}" Width="100px" TextAlign="TextAlign.Right" />
                    <RadzenDataGridColumn Property="@nameof(ContratoExt.CantidadHorasConsumidas)" Title="Horas Consumidas" FormatString="{0:N2}" Width="100px" TextAlign="TextAlign.Right" />
                    <RadzenDataGridColumn Property="@nameof(ContratoExt.HorasPendientes)" Title="Horas Pendientes" FormatString="{0:N2}" Width="100px" TextAlign="TextAlign.Right" />
                    <RadzenDataGridColumn Property="@nameof(ContratoExt.CantidadEmpleadosContrato)" Title="# Empleados" FormatString="{0:N0}" Width="80px" TextAlign="TextAlign.Right" />
                    <RadzenDataGridColumn Property="@nameof(ContratoExt.DescNivelContrato)" Title="Nivel de Contrato" Width="100px" />
                    <RadzenDataGridColumn Property="@nameof(ContratoExt.DescFormaPago)" Title="Forma de Pago" Width="100px" />
                    <RadzenDataGridColumn Property="@nameof(ContratoExt.DescEstado)" Title="Estado" Width="100px" />
                    <RadzenDataGridColumn Property="@nameof(ContratoExt.FechaCreacion)" Title="Creado" FormatString="{0:d}" Width="150px" />
                    <RadzenDataGridColumn Property="@nameof(ContratoExt.FechaModificacion)" Title="Modificado" FormatString="{0:d}" Width="150px" />
                    <RadzenDataGridColumn Context="ContratoExt" Width="50px" Filterable="false" Sortable="false" TextAlign="TextAlign.Right" Frozen="true" FrozenPosition="FrozenColumnPosition.Left">
                        <Template Context="ContratoExt">
                            <RadzenButton  Icon="delete" ButtonStyle="ButtonStyle.Danger"
                            Variant="Variant.Flat" Size="Radzen.ButtonSize.Medium" Shade="Shade.Lighter" class="rounded-circle rz-my-1 rz-ms-1"
                            Click="@(args => OnDelete(ContratoExt))" />
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        </RadzenStack>
    </div>
</div>





@code {
    public string Titulo { get; set; }
    private bool InProcess = true; 

    string? ContratoID;
    RadzenDataGrid<ContratoExt> grid;
    IEnumerable<ContratoExt> dataList;
    IList<ContratoExt> selectedData;
    

    private IEnumerable<CatalogoGenerico>? listEstadoContrato;
    private IEnumerable<CatalogoGenerico>? listNivelContrato;
    private IEnumerable<CatalogoGenerico>? listFormaPago;
    private IEnumerable<CatalogoGenerico>? listTipoContrato;

    private async Task LoadEstadoContrato() => listEstadoContrato = await configService.GetCatalogoGenerico("ESTADO_CONTRATO");
    private async Task LoadNivelContrato() => listNivelContrato = await configService.GetCatalogoGenerico("NIVEL_CONTRATO");
    private async Task LoadFormaPago() => listFormaPago = await configService.GetCatalogoGenerico("FORMA_PAGO");
    private async Task LoadTipoContrato() => listTipoContrato = await configService.GetCatalogoGenerico("TIPO_CONTRATO");

    private List<Task> GetLoadTasks()
    {
        return new List<Task>
        {
            LoadEstadoContrato(),
            LoadNivelContrato(),
            LoadFormaPago(),
            LoadTipoContrato(),
        };

    }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        if (Titulo is null) Titulo = "Contratos";

        // Definir la lista de tareas a llamar
        var tasks = GetLoadTasks();

        // Esperar a que todas las tareas se completen
        await Task.WhenAll(tasks);

        dataList = await GetDataList();
    }


    async Task FilterCleared()
    {
        ContratoID = null;
        await grid.FirstPage();
    }

    void OnRender(DataGridRenderEventArgs<ContratoExt> args)
    {
        if (args.FirstRender)
        {
            args.Grid.Sorts.Add(new SortDescriptor() { Property = "Id", SortOrder = SortOrder.Ascending });

        }
    }


    private async Task<IEnumerable<ContratoExt>> GetDataList()
    {
        List<ContratoExt> model = new();
        try
        {
            var contratos = (await processService.GetContrato()).ToList();

            if (contratos is not null)
            {
                model = (from e in contratos
                         join nc in listNivelContrato! on e.NivelContratoId equals nc.Id
                         join fp in listFormaPago! on e.FormaPagoId equals fp.Id
                         join st in listEstadoContrato! on e.EstadoId equals st.Id
                         join tc in listTipoContrato! on e.TipoContratoId equals tc.Id
                         select new ContratoExt
                         {
                             Id = e.Id,
                             ClienteId = e.ClienteId,
                             Descripcion = e.Descripcion,
                             FechaInicio = e.FechaInicio,
                             FechaFin = e.FechaFin,
                             FormaPagoId = e.FormaPagoId,
                             CantidadHorasContratadas = e.CantidadHorasContratadas,
                             CantidadHorasConsumidas = e.CantidadHorasConsumidas,
                             HorasPendientes = e.CantidadHorasContratadas - e.CantidadHorasConsumidas,
                             EstadoId = e.EstadoId,
                             Monto = e.Monto,
                             FechaCreacion = e.FechaCreacion,
                             UsuarioCreacion = e.UsuarioCreacion,
                             FechaModificacion = e.FechaModificacion,
                             UsuarioModificacion = e.UsuarioModificacion,
                             NivelContratoId = e.NivelContratoId,
                             TipoContratoId = e.TipoContratoId,
                             CantidadEmpleadosContrato = e.CantidadEmpleadosContrato,
                             Cliente = e.Cliente == null ? null :
                                    new Cliente
                                    {
                                        Id = e.Cliente.Id,
                                        Nombre = e.Cliente.Nombre,
                                        Telefono = e.Cliente.Telefono,
                                        Cedula = e.Cliente.Cedula,
                                        Direccion = e.Cliente.Direccion,
                                        Contacto = e.Cliente.Contacto,
                                        Email = e.Cliente.Email,
                                        EstadoId = e.Cliente.EstadoId,
                                        Subsidiaria = e.Cliente.Subsidiaria,
                                        ClientePadre = e.Cliente.ClientePadre,
                                        FechaCreacion = e.Cliente.FechaCreacion,
                                        UsuarioCreacion = e.Cliente.UsuarioCreacion,
                                        FechaModificacion = e.Cliente.FechaModificacion,
                                        UsuarioModificacion = e.Cliente.UsuarioModificacion,
                                    },
                             NombreCliente = e.Cliente != null ? e.Cliente.Nombre :"",
                             DescEstado = st.Descripcion,
                             DescFormaPago = fp.Descripcion,
                             DescNivelContrato = nc.Descripcion,
                             DesctipoContrato = tc.Descripcion,
                         }).ToList();
            }

        }
        catch (Exception)
        {
            await swal.FireAsync("Error", "Error al cargar la información solicitada.", SweetAlertIcon.Info);
        }

        InProcess = false;
        StateHasChanged();
        return model;
    }

    void OnColumnReordering(DataGridColumnReorderingEventArgs<ContratoExt> args)
    {
        if (args.ToColumn.Property == nameof(ContratoExt.Id))
        {
            args.Cancel = true;
        }
    }

    private async Task OnClickAdd()
    {
        NavigationManager.NavigateTo("./contratosdetalle/0/1");
    }

    protected async Task OnSelect(DataGridRowMouseEventArgs<ContratoExt> args)
    {
        NavigationManager.NavigateTo("./contratosdetalle/" + args.Data.Id + "/2");
        await InvokeAsync(() => { StateHasChanged(); });
    }

    protected async void OnDelete(ContratoExt ContratoExt)
    {
        NavigationManager.NavigateTo($"./contratosdetalle/{ContratoExt.Id}/3");
    }

    public async Task Export(string type)
    {
        var queryableList = dataList.AsQueryable();

        var query=new Query()
            {
                OrderBy = grid.Query.OrderBy,
                Filter = grid.Query.Filter,
                Select = string.Join(",", grid.ColumnsCollection.Where(c => c.GetVisible() && !string.IsNullOrEmpty(c.Property))
                                .Select(c => c.Property.Contains(".") ? $"{c.Property} as {c.Property.Replace(".", "_")}" : c.Property))
            };

        await ExportFile(queryableList, type, query);
    }

    public async Task ExportFile(IQueryable<ContratoExt> ContratoExt, string type, Radzen.Query? query = null)
    {
        string fileName = "Contratos";
        if (type == "csv")
        {
            fileName = $"{fileName}.csv";
            await exportData.ToCSV(exportData.ApplyQuery(ContratoExt, query), fileName);
        }
        else
        {
            fileName = $"{fileName}.xlsx";
            await exportData.ToExcel(exportData.ApplyQuery(ContratoExt, query), fileName);
        }
    }

    void RowRender(RowRenderEventArgs<ContratoExt> args)
    {
        switch (args.Data.EstadoId)
        {
            case "C":
                args.Attributes.Add("class", "radzen-grid-row-background-color-yellow-light rz-data-row");
                break;
            case "F":
                args.Attributes.Add("class", "radzen-grid-row-background-color-red-light rz-data-row");
                break;
            case "A":
                args.Attributes.Add("class", "radzen-grid-row-background-color-green-light rz-data-row");
                break;
        }

    }
}

<style>

    .radzen-grid-row-background-color-yellow-light > td {
        background-color: #FFE453 !important;
    }

    .radzen-grid-row-background-color-red-light > td {
        background-color: #FF188E !important;
    }

    .radzen-grid-row-background-color-green-light > td {
        background-color: #44FF47 !important;
    }
</style>
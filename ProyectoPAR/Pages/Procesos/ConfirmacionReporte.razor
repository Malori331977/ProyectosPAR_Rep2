@page "/confirmacionreporte/{id}"
@layout IndexLayout

<style media="screen">
    *,
    *:before,
    *:after {
    padding: 0;
    margin: 0;
    box-sizing: border-box;
    }

    body {
    background-color: #808080;
    }

    .background {
    width: 430px;
    height: 520px;
    position: absolute;
    transform: translate(-50%,-50%);
    left: 50%;
    top: 50%;
    }

    .background .shape {
    height: 200px;
    width: 200px;
    position: absolute;
    border-radius: 50%;
    }


    form {
    height: 520px;
    width: 520px;
    background-color: rgba(255,255,255,0.13);
    position: absolute;
    transform: translate(-50%,-50%);
    top: 50%;
    left: 75%;
    border-radius: 10px;
    backdrop-filter: blur(10px);
    border: 2px solid rgba(255,255,255,0.1);
    box-shadow: 0 0 40px rgba(8,7,16,0.6);
    padding: 50px 35px;
    }

    form * {
    font-family: 'Poppins',sans-serif;
    color: #ffffff;
    letter-spacing: 0.5px;
    outline: none;
    border: none;
    }

    form h3 {
    font-size: 28px;
    font-weight: 400;
    line-height: 42px;
    text-align: center;
    }

    form h5 {
    font-size: 16px;
    font-weight: 400;
    line-height: 24px;
    text-align: center;
    }

    label {
    display: block;
    margin-top: 30px;
    font-size: 16px;
    font-weight: 500;
    }

    input {
    display: block;
    height: 50px;
    width: 100%;
    background-color: azure;
    border-radius: 999px;
    padding: 0 10px;
    margin-top: 8px;
    font-size: 14px;
    font-weight: 300;
    color: black;
    }

    ::placeholder {
    color: #e5e5e5;
    }

    button {
    margin-top: 50px;
    width: 100%;
    background-color: #ffffff;
    border-radius: 999px;
    color: #080710;
    padding: 15px 0;
    font-size: 18px;
    font-weight: 600;
    cursor: pointer;
    }

    img {
    margin-top: -50px;
    margin-left: -50px;
    width: 50%;
    height: 105vh;
    padding: 0 0;
    cursor: pointer;
    }

</style>


<img src="img/ImagenInicio.jpg" />
<div class="background">
</div>

<form>

    <RadzenRow JustifyContent="JustifyContent.Center" AlignItems="AlignItems.Center" class="mt-5">
        <RadzenColumn Size="12" SizeMD="12" class="w-100 rz-text-align-center">
            <RadzenImage Path="img/aceptacion.png" Style="width: 10rem;height: 10rem;" />
        </RadzenColumn>
        <RadzenColumn Size="12" SizeMD="12" class="w-100 rz-text-align-center">
            <RadzenText TextStyle="TextStyle.H4" Text="@RespuestaProceso" TagName="TagName.H4" class="text-white"></RadzenText>
        </RadzenColumn>

    </RadzenRow>


    
    

    

</form>

@code {
    [Parameter] public string id { get; set; } = "";

    private string RespuestaProceso = "";

    protected override async Task OnAfterRenderAsync(bool IsFirstRender)
    {
        if (IsFirstRender)
        {
            await ActualizarReporte();
            StateHasChanged();
        }

    }

    private async Task ActualizarReporte()
    {
        var token=Utiles.Base64StringToAscii(id);

        var data = token.Split("|");

        if (data.Count() == 3)
        {
            var repo = await processService.GetReporte(int.Parse(data[1]));

            if (repo is not null)
            {
                if (!repo.Confirmacion)
                {
                    repo.Confirmacion = true;
                    repo.Consultor = null;
                    repo.Cliente = null;
                    repo.ProyectoDetalle = null;

                    List<Reporte> listUpd = new List<Reporte>()
                    {
                        repo,
                    };
                    EventResponse respuesta;
                    respuesta = await genericService.Put("ReporteConfirmacion", listUpd);

                    if (respuesta.Id == "0")
                        RespuestaProceso = "El reporte fue confirmado con éxito.  Muchas gracias";
                    else
                        RespuestaProceso = "Ocurrió un error al intentar confirmar el reporte.  Por favor informar al correo info@gsitcr.com.";
                }
                else
                    RespuestaProceso = "El reporte ya había sido confirmado.  Muchas gracias";

            }

        }
        else
        {
            NavigationManager.NavigateTo("./error");
        }


    }

   

}

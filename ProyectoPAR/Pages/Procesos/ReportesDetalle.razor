    private void CalculaHorasLaboradas(){

        var horas = (((reporte!.HoraSalida - reporte.HoraEntrada).TotalSeconds/60)/60);

        reporte!.Cantidadhoras = (decimal)horas;
    }

    private async Task BuscarTarea()
    {

        tarea = await processService.GetAgendaConsultorByConsultor((int)reporte!.AgendaId!, loginState.User.consultor!.Id);
        if (tarea is not null)
        {
            reporte.AgendaId = tarea!.Id;
            reporte.ProyectoId = tarea!.ProyectoId;
            reporte.TareaId = tarea!.TareaId;
            reporte.ItemId = tarea!.ItemId;
            reporte.EstadoTareaId = tarea!.EstadoId;
            reporte.HoraInicioTarea = tarea!.HoraInicioPlanificada;
            reporte.HoraFinTarea = tarea!.HoraFinalPlanificada;
            reporte.FechaPlan = tarea!.Fecha;
            reporte.DescProyecto = tarea!.Proyecto!.Descripcion;
            reporte.DescTarea = tarea!.ProyectoDetalle!.Descripcion;
        }
        else
        {
            await swal.FireAsync("Atención", "La tarea no existe en la agenda del consultor", SweetAlertIcon.Info);
            reporte.AgendaId = 0;
            reporte.ProyectoId = 0;
            reporte.TareaId = 0;
            reporte.ItemId = 0;
            reporte.EstadoTareaId = null;
            reporte.HoraInicioTarea = null;
            reporte.HoraFinTarea = null;
            reporte.FechaPlan = null;
            reporte.DescProyecto = "";
            reporte.DescTarea = "";

        }
        StateHasChanged();
    }


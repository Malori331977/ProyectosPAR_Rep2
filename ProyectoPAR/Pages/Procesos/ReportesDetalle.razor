    private async Task CalculaHorasLaboradas()
    {        
        if (reporte!.HoraEntrada > reporte.HoraSalida)
        {
            reporte!.Cantidadhoras = 0;
        }
        else
        {
            var horas = (((reporte!.HoraSalida - reporte.HoraEntrada).TotalSeconds / 60) / 60);

            var horasExactas = Math.Truncate(horas);
            var decimales = horas - Math.Truncate(horas);

            if (horasExactas == 0)
            {
                horasExactas = 1;
                decimales = 0;
            }
            else
            {
                if (decimales > 0)
                {
                    if (decimales <= 0.5)
                        decimales = 0.5;
                    else
                        decimales = 1;
                }
            }

            horas = horasExactas + decimales;

            reporte!.Cantidadhoras = (decimal)horas;
        }
        await InvokeAsync(StateHasChanged);
    }


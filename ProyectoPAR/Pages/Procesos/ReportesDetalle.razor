    private async Task OnChangeHEntrada(DateTime? newValue)
    {
        try
        {
            if (newValue is null)
            {
                hEntrada = new DateTime(DateTime.Now.Year, DateTime.Now.Month, DateTime.Now.Day, 00, 00, 00);
            }

            hEntrada = newValue!;
            reporte!.HoraEntrada = TimeOnly.FromDateTime((DateTime)hEntrada!);
            
        }
        catch (Exception)
        {
            hEntrada = new DateTime(DateTime.Now.Year, DateTime.Now.Month, DateTime.Now.Day, 00, 00, 00);
        }
        await CalculaHorasLaboradas();
       
    }

    private async Task OnChangeHSalida(DateTime? newValue)
    {
        try
        {
            if (newValue is null)
            {
                hSalida = new DateTime(DateTime.Now.Year, DateTime.Now.Month, DateTime.Now.Day, 00, 00, 00);
            }
            hSalida = newValue!;
            reporte!.HoraSalida = TimeOnly.FromDateTime((DateTime)hSalida!);
            
        }
        catch (Exception)
        {
            hSalida = new DateTime(DateTime.Now.Year, DateTime.Now.Month, DateTime.Now.Day, 00, 00, 00);
        }
        await CalculaHorasLaboradas();
       
    }
    

@page "/reportesdetalle/{Id:int}/{Modo:int}"
@inherits DialogSettingLayout


@if (reporte == null)
{
    <SpinnerControl></SpinnerControl>
}
else
{
    <div class="card">
        <PageReturn Titulo="@Titulo" UrlRetorno="@UrlRetorno" />

        <div class="card-body">
            <RadzenTemplateForm Data="@reporte" Submit="@((Reporte args) => { Guardar(args); })">
                <RadzenRow Gap="0.3rem" class="rz-p-0 rz-p-lg-2">
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenStack>
                            <RadzenFieldset Text="Datos del Reporte">
                                <RadzenStack Gap="0.3rem">
                                    <RadzenRow AlignItems="AlignItems.Center">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenLabel Text="Cliente" Component="ClienteId" />
                                            <RadzenRow AlignItems="AlignItems.Center">
                                                <RadzenColumn Size="12" SizeMD="1">
                                                    <RadzenButton ButtonStyle="ButtonStyle.Info" Icon="search" class="rounded-circle rz-my-1 rz-ms-1" Disabled="@soloLecturaAdd" Size="Radzen.ButtonSize.Medium" Click=@OnShowModalClientes></RadzenButton>
                                                </RadzenColumn>
                                                <RadzenColumn Size="12" SizeMD="2">
                                                    <RadzenTextBox Style="width: 100%;" Name="ClienteId" @bind-Value="reporte.ClienteId" Disabled="@soloLecturaAdd"
                                                    @onfocusout="BuscarCliente" />
                                                </RadzenColumn>
                                                <RadzenColumn Size="12" SizeMD="9">
                                                    <RadzenTextBox Style="width: 100%;" Disabled="true" @bind-Value="reporte.NombreCliente" />
                                                </RadzenColumn>
                                            </RadzenRow>
                                        </RadzenColumn>
                                    </RadzenRow>
                                    <RadzenRow AlignItems="AlignItems.Center">
                                        <RadzenColumn Size="12" SizeMD="6">
                                            <RadzenLabel Text="Tipo de Reporte" Component="TipoReporteId" />
                                            <RadzenDropDown @bind-Value="reporte.TipoReporteId"
                                            AllowClear="true"
                                            Placeholder="Seleccione Tipo de Reporte"
                                            Data="@listTiposReporte" Style="width: 100%;"
                                            ValueProperty="Id"
                                            TextProperty="Descripcion"
                                            Name="TipoReporteId">
                                            </RadzenDropDown>
                                        </RadzenColumn>
                                        <RadzenColumn Size="12" SizeMD="6">
                                            <RadzenLabel Text="Categoria de Reporte" Component="CatReporteId" />
                                            <RadzenDropDown @bind-Value="reporte.CategoriaId"
                                            AllowClear="true"
                                            Placeholder="Seleccione Categoria"
                                            Data="@listCategoriasReporte" Style="width: 100%;"
                                            ValueProperty="Id"
                                            TextProperty="Descripcion"
                                            Name="CatReporteId">
                                            </RadzenDropDown>
                                        </RadzenColumn>
                                    </RadzenRow>
                                    <RadzenRow AlignItems="AlignItems.Center">
                                        <RadzenColumn Size="12" SizeMD="3">
                                            <RadzenLabel Text="Fecha" Component="Fecha" />
                                            <RadzenStack Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.Center">
                                                <RadzenColumn Size="12" SizeMD="1">
                                                    <RadzenDatePicker Style="width: 100%;" Name="Fecha" @bind-Value="reporte.Fecha" Disabled="@soloLectura"
                                                    ShowCalendarWeek DateFormat="dd/MM/yyyy" />
                                                </RadzenColumn>
                                            </RadzenStack>
                                        </RadzenColumn>
                                        <RadzenColumn Size="12" SizeMD="3">
                                            <RadzenLabel Text="Hora Entrada" Component="Hentrada" />
                                            <RadzenStack Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.Center">
                                                <RadzenColumn Size="12" SizeMD="1">
                                                    <RadzenDatePicker @bind-Value=@reporte.HoraEntrada ShowTime="true" TimeOnly="true"
                                                    DateFormat="HH:mm" Name="Hentrada" Disabled="@soloLectura" 
                                                    @onfocusout="CalculaHorasLaboradas" />
                                                </RadzenColumn>
                                            </RadzenStack>
                                        </RadzenColumn>
                                        <RadzenColumn Size="12" SizeMD="3">
                                            <RadzenLabel Text="Hora Salida" Component="Hsalida" />
                                            <RadzenStack Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.Center">
                                                <RadzenColumn Size="12" SizeMD="1">
                                                    <RadzenDatePicker @bind-Value=@reporte.HoraSalida ShowTime="true" TimeOnly="true"
                                                    DateFormat="HH:mm" Name="Hsalida" Disabled="@soloLectura" 
                                                    @onfocusout="CalculaHorasLaboradas" />
                                                </RadzenColumn>
                                            </RadzenStack>
                                        </RadzenColumn>
                                        <RadzenColumn Size="12" SizeMD="3">
                                            <RadzenLabel Text="Total Horas" Component="tothoras" />
                                            <RadzenStack Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.Center">
                                                <RadzenColumn Size="12" SizeMD="1">
                                                    <RadzenNumeric Placeholder="0.0" @bind-Value=@reporte.Cantidadhoras Name="tothoras" Disabled="@soloLectura" InputAttributes="@(new Dictionary<string, object>() { { "aria-label", "enter value" } })" />
                                                </RadzenColumn>
                                            </RadzenStack>
                                        </RadzenColumn>
                                    </RadzenRow>
                                    <RadzenRow AlignItems="AlignItems.Center">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenLabel Text="Descripción" Component="desc" />
                                            <RadzenTextArea @bind-Value=@reporte.Descripcion Style="width: 100%;height:125px" Name="desc" Disabled="@soloLectura" />
                                        </RadzenColumn>
                                    </RadzenRow>
                                    <RadzenRow AlignItems="AlignItems.Center">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenLabel Text="Tareas Pendientes" Component="pend" />
                                            <RadzenTextArea @bind-Value=@reporte.TareasPendientes Style="width: 100%;height:125px" Name="pend" Disabled="@soloLectura" />
                                        </RadzenColumn>
                                    </RadzenRow>
                                </RadzenStack>
                            </RadzenFieldset>
                            <RadzenFieldset Text="Encargados de Empresa">
                                <RadzenStack Gap="0.3rem">
                                    <RadzenRow AlignItems="AlignItems.Center">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenLabel Text="Nombre de Encargado" Component="Encargado" />
                                            <RadzenTextBox @bind-Value=@reporte.ResponsableCliente Style="width: 100%" Name="Encargado" Disabled="@soloLectura" />
                                        </RadzenColumn>
                                    </RadzenRow>
                                    <RadzenRow AlignItems="AlignItems.Center">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenLabel Text="Correo" Component="Correo" />
                                            <RadzenTextBox @bind-Value=@reporte.CorreoCliente Style="width: 100%" Name="Correo" Disabled="@soloLectura" />
                                        </RadzenColumn>
                                    </RadzenRow>
                                </RadzenStack>
                            </RadzenFieldset>

                        </RadzenStack>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenStack>
                            <RadzenFieldset Text="Estado de Reporte">
                                <RadzenStack Gap="0.3rem">
                                    <RadzenRow AlignItems="AlignItems.Center">
                                        <RadzenColumn Size="12" SizeMD="2">
                                            <RadzenLabel Text="Confirmado" Component="confirmacion" />
                                            <RadzenStack Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.3rem">
                                                <RadzenSwitch Placeholder="Confirmado" Style="width: 25%;" Name="confirmacion"
                                                @bind-Value="reporte.Confirmacion" Disabled="true" />
                                            </RadzenStack>
                                        </RadzenColumn>
                                        <RadzenColumn Size="12" SizeMD="2">
                                            <RadzenLabel Text="Facturado" Component="Facturado" />
                                            <RadzenStack Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.3rem">
                                                <RadzenColumn Size="12" SizeMD="1">
                                                    <RadzenSwitch Disabled="true" Placeholder="Facturado" Style="width: 25%;" Name="Facturado" @bind-Value="reporte.Facturado" />
                                                </RadzenColumn>
                                            </RadzenStack>
                                        </RadzenColumn>
                                        <RadzenColumn Size="12" SizeMD="4">
                                            <RadzenLabel Text="Estado" Component="EstadoId" />
                                            <RadzenStack Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.3rem">
                                                <RadzenColumn Size="12" SizeMD="1">
                                                    <RadzenDropDown @bind-Value="reporte.EstadoId"
                                                    AllowClear="true"
                                                    Placeholder="Estado"
                                                    Disabled="true"
                                                    Data="@listEstadoReporte" Style="width: 100%;"
                                                    ValueProperty="Id"
                                                    TextProperty="Descripcion"
                                                    Name="CatReporteId">
                                                    </RadzenDropDown>
                                                </RadzenColumn>
                                            </RadzenStack>
                                        </RadzenColumn>
                                        <RadzenColumn Size="12" SizeMD="4">
                                            <RadzenLabel Text="Creado" Component="Creado" />
                                            <RadzenStack Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.3rem">
                                                <RadzenColumn Size="12" SizeMD="1">
                                                    <RadzenDatePicker Style="width: 100%;" Name="Creado" @bind-Value="reporte.FechaCreacion" Disabled="true" />
                                                </RadzenColumn>
                                            </RadzenStack>
                                        </RadzenColumn>
                                    </RadzenRow>
                                </RadzenStack>
                            </RadzenFieldset>
                            <RadzenFieldset Text="Datos de Proyecto">
                                <RadzenStack Gap="0.3rem">
                                    <RadzenRow AlignItems="AlignItems.Center">
                                        <RadzenColumn Size="12" SizeMD="3">
                                            <RadzenLabel Text="Programado" Component="Programado" />
                                            <RadzenStack Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.3rem">
                                                <RadzenRow AlignItems="AlignItems.Start">
                                                    <RadzenColumn Size="12" SizeMD="2">
                                                        <RadzenSwitch Placeholder="Programado" Style="width: 25%;" Name="Programado"
                                                                      @bind-Value="reporte.Programado" Disabled="@soloLecturaAdd" />
                                                    </RadzenColumn>
                                                </RadzenRow>
                                            </RadzenStack>
                                        </RadzenColumn>
                                        <RadzenColumn Size="12" SizeMD="3">
                                            <RadzenLabel Text="Agenda" Component="AgendaId" />
                                            <RadzenStack Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.3rem">
                                                <RadzenRow AlignItems="AlignItems.Center">
                                                    <RadzenColumn Size="12" SizeMD="3">
                                                        <RadzenButton ButtonStyle="ButtonStyle.Info" Icon="search" class="rounded-circle rz-my-1 rz-ms-1" Disabled="@soloLecturaAdd" Size="Radzen.ButtonSize.Medium" Click=@OnShowModalTarea></RadzenButton>
                                                    </RadzenColumn>
                                                    <RadzenColumn Size="12" SizeMD="9">
                                                        <RadzenNumeric Name="AgendaId" @bind-Value="reporte.AgendaId" Disabled="@soloLecturaAdd" />
                                                    </RadzenColumn>
                                                </RadzenRow>
                                            </RadzenStack>
                                        </RadzenColumn>
                                        <RadzenColumn Size="12" SizeMD="3">
                                            <RadzenLabel Text="Proyecto" Component="proyectoId" />
                                            <RadzenStack Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.3rem">
                                                <RadzenRow AlignItems="AlignItems.Center">
                                                    <RadzenColumn Size="12" SizeMD="12">
                                                        <RadzenNumeric Name="proyectoId" @bind-Value="reporte.ProyectoId" Disabled="true" />
                                                    </RadzenColumn>
                                                </RadzenRow>
                                            </RadzenStack>
                                        </RadzenColumn>
                                        <RadzenColumn Size="12" SizeMD="3">
                                            <RadzenLabel Text="Tarea" Component="tareaId" />
                                            <RadzenStack Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.3rem">
                                                <RadzenRow AlignItems="AlignItems.Center">
                                                    <RadzenColumn Size="12" SizeMD="12">
                                                        <RadzenNumeric Name="tareaId" @bind-Value="reporte.TareaId" Disabled="true" />
                                                    </RadzenColumn>
                                                </RadzenRow>
                                            </RadzenStack>
                                        </RadzenColumn>
                                    </RadzenRow>
                                    <RadzenRow AlignItems="AlignItems.Center">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenLabel Text="Descripcion del Proyecto" Component="descProy" />
                                            <RadzenTextBox @bind-Value=@reporte.DescProyecto Style="width: 100%" Name="descProy" Disabled="true" />
                                        </RadzenColumn>
                                    </RadzenRow>
                                    <RadzenRow AlignItems="AlignItems.Center">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenLabel Text="Descripcion de Tarea" Component="descTarea" />
                                            <RadzenTextBox @bind-Value=@reporte.DescTarea Style="width: 100%" Name="descTarea" Disabled="true" />
                                        </RadzenColumn>
                                    </RadzenRow>
                                    <RadzenRow AlignItems="AlignItems.Center">
                                        <RadzenColumn Size="12" SizeMD="4">
                                            <RadzenLabel Text="Fecha Planeada" Component="ftar" />
                                            <RadzenDatePicker Style="width: 100%;" Name="ftar" @bind-Value="reporte!.FechaPlan" Disabled="true"
                                            ShowCalendarWeek DateFormat="dd/MM/yyyy" Max="DateTime.MaxValue" />
                                        </RadzenColumn>
                                        <RadzenColumn Size="12" SizeMD="4">
                                            <RadzenLabel Text="Hora Inicio Planeada" Component="hInicioReal" />
                                            <RadzenDatePicker @bind-Value=@reporte!.HoraInicioTarea ShowTime="true" TimeOnly="true"
                                            DateFormat="HH:mm" Name="hInicioReal" Disabled="true" Style="width: 100%;" />
                                        </RadzenColumn>
                                        <RadzenColumn Size="12" SizeMD="4">
                                            <RadzenLabel Text="Hora Fin Planeada" Component="hFinReal" />
                                            <RadzenDatePicker @bind-Value=@reporte!.HoraFinTarea ShowTime="true" TimeOnly="true"
                                            DateFormat="HH:mm" Name="hFinReal" Disabled="true" Style="width: 100%;" />
                                        </RadzenColumn>
                                    </RadzenRow>

                                    <RadzenRow AlignItems="AlignItems.Center">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenLabel Text="Estado" Component="EstadoId" />
                                            <RadzenDropDown @bind-Value="reporte!.EstadoTareaId"
                                            Placeholder="Seleccione Estado"
                                            Data="@listEstadoTarea" Style="width: 100%;"
                                            ValueProperty="Id"
                                            TextProperty="Descripcion"
                                            Name="EstadoId" Disabled="@soloLectura">
                                            </RadzenDropDown>
                                        </RadzenColumn>
                                    </RadzenRow>
                                </RadzenStack>                               

                            </RadzenFieldset>

                        </RadzenStack>
                    </RadzenColumn>
                </RadzenRow>
                <RadzenStack Orientation="Radzen.Orientation.Horizontal" JustifyContent="JustifyContent.Center" Gap="0.5rem" class="rz-mt-8 rz-mb-4">
                    <RadzenButton class="rz-border-radius-6" ButtonType="Radzen.ButtonType.Submit" Size="Radzen.ButtonSize.Large" Icon="save" Text="Guardar" />
                    <RadzenButton class="rz-border-radius-6" ButtonStyle="Radzen.ButtonStyle.Light" Variant="Variant.Flat" Size="Radzen.ButtonSize.Large" Icon="cancel" Text="Cancelar" Click="@Cancelar" />
                </RadzenStack>
            </RadzenTemplateForm>
        </div>
    </div>



}

@code {
    [Parameter] public int Id { get; set; }
    [Parameter] public int Modo { get; set; }

    private string Titulo = "Reporte";
    private string UrlRetorno = "./reporteslist";
    private bool InProcess = true;
    private bool soloLectura = false;
    private bool soloLecturaAdd = false;
    private ReporteExt? reporte = null;
    private AgendaConsultor? tarea;

    private IEnumerable<CatalogoGenerico>? listCategoriasReporte;
    private IEnumerable<CatalogoGenerico>? listTiposReporte;
    private IEnumerable<CatalogoGenerico>? listEstadoReporte;
    private IEnumerable<CatalogoGenerico>? listEstadoTarea;

    private async Task LoadEstadoTarea() => listEstadoTarea = await configService.GetCatalogoGenerico("ESTADO_PROYECTO_TAREA");
    private async Task LoadCategoriasReporte() => listCategoriasReporte = await configService.GetCatalogoGenerico("CATEGORIA_REPORTE");
    private async Task LoadTiposReporte() => listTiposReporte = await configService.GetCatalogoGenerico("TIPO_REPORTE");
    private async Task LoadEstadoReporte() => listEstadoReporte = await configService.GetCatalogoGenerico("ESTADO_REPORTE");
    private async Task LoadReporte()
    {
        if (Modo != 1)
        {
            var repo = await processService.GetReporte(Id);

            if (repo is not null)
            {

                reporte = new ReporteExt
                    {
                        Id = repo.Id,
                        Confirmacion = repo.Confirmacion,
                        Facturado = repo.Facturado,
                        EstadoId = repo.EstadoId,
                        ClienteId = repo.ClienteId,
                        Fecha = repo.Fecha,
                        CategoriaId = repo.CategoriaId,
                        TipoReporteId = repo.TipoReporteId,
                        Cantidadhoras = repo.Cantidadhoras,
                        HoraEntrada = repo.HoraEntrada,
                        HoraSalida = repo.HoraSalida,
                        Descripcion = repo.Descripcion,
                        TareasPendientes = repo.TareasPendientes,
                        ConsultorId = repo.ConsultorId,
                        ResponsableCliente = repo.ResponsableCliente,
                        CorreoCliente = repo.CorreoCliente,
                        Programado = repo.Programado,
                        AgendaId = repo.AgendaId,
                        ProyectoId = repo.ProyectoId,
                        TareaId = repo.TareaId,
                        ItemId = repo.ItemId,
                        FechaCreacion = repo.FechaCreacion,
                        UsuarioCreacion = repo.UsuarioCreacion,
                        FechaModificacion = repo.FechaModificacion,
                        UsuarioModificacion = repo.UsuarioModificacion,
                        EstadoTareaId = repo.EstadoTareaId,
                        Cliente = repo.Cliente == null ? null :
                                     new Cliente
                                     {
                                         Id = repo.Cliente.Id,
                                         Nombre = repo.Cliente.Nombre,
                                         Telefono = repo.Cliente.Telefono,
                                         Cedula = repo.Cliente.Cedula,
                                         Direccion = repo.Cliente.Direccion,
                                         Contacto = repo.Cliente.Contacto,
                                         Email = repo.Cliente.Email,
                                         EstadoId = repo.Cliente.EstadoId,
                                         Subsidiaria = repo.Cliente.Subsidiaria,
                                         ClientePadre = repo.Cliente.ClientePadre,
                                         FechaCreacion = repo.Cliente.FechaCreacion,
                                         UsuarioCreacion = repo.Cliente.UsuarioCreacion,
                                         FechaModificacion = repo.Cliente.FechaModificacion,
                                         UsuarioModificacion = repo.Cliente.UsuarioModificacion,
                                     },
                        Consultor = repo.Consultor == null ? null :
                                     new Consultor
                                     {
                                         Id = repo.Consultor.Id,
                                         Usuario = repo.Consultor.Usuario,
                                         Nombre = repo.Consultor.Nombre,
                                         PrimerApellido = repo.Consultor.PrimerApellido,
                                         SegundoApellido = repo.Consultor.SegundoApellido,
                                         Email = repo.Consultor.Email,
                                         Telefono = repo.Consultor.Telefono,
                                         Activo = repo.Consultor.Activo,
                                         FechaCreacion = repo.Consultor.FechaCreacion,
                                         UsuarioCreacion = repo.Consultor.UsuarioCreacion,
                                         FechaModificacion = repo.Consultor.FechaModificacion,
                                         UsuarioModificacion = repo.Consultor.UsuarioModificacion,
                                     },
                        NombreCliente = repo.Cliente!.Nombre,
                        NombreConsultor = repo.Consultor!.Nombre
                    };

                if (reporte.AgendaId is not null && reporte.AgendaId>0)
                { 
                    string statusTarea = reporte.EstadoTareaId;
                    await BuscarTarea();
                    reporte.EstadoTareaId = statusTarea;
                }
            }
        }
    }

    private List<Task> GetLoadTasks()
    {
        return new List<Task>
        {
            LoadCategoriasReporte(),
            LoadTiposReporte(),
            LoadEstadoReporte(),
            LoadReporte(),
            LoadEstadoTarea(),
        };

    }

    protected override async Task OnInitializedAsync()
    {

        soloLectura = Modo == 3;
        try
        {
            // Definir la lista de tareas a llamar
            var tasks = GetLoadTasks();

            // Esperar a que todas las tareas se completen
            await Task.WhenAll(tasks);

            //Modos= 1:Insertar 2:Actualizar 3:Borrar 0:Consulta
            if (Modo != 1)
            {
                soloLecturaAdd = true;                
            }
            else
            {
                reporte = new ReporteExt
                {
                    Id = 0,
                    Confirmacion = false,
                    Facturado = false,
                    EstadoId = "R",
                    ClienteId = "",
                    Fecha = DateTime.Now,
                    CategoriaId = "0",
                    TipoReporteId = "0",
                    Cantidadhoras = 0,
                    HoraEntrada = new TimeOnly( 07, 00, 00),
                    HoraSalida = new TimeOnly(17, 00, 00),
                    Descripcion = "",
                    TareasPendientes = "",
                    ConsultorId = loginState.User.consultor!.Id,
                    ResponsableCliente = "",
                    CorreoCliente = "",
                    Programado = false,
                    AgendaId = null,
                    ProyectoId = null,
                    TareaId = null,
                    ItemId = null,
                    FechaCreacion = DateTime.Now,
                    UsuarioCreacion = loginState.User.consultor!.Id.ToString(),
                    FechaModificacion = DateTime.Now,
                    UsuarioModificacion = loginState.User.consultor!.Id.ToString(),
                    NombreCliente = "",
                    NombreConsultor="",
                    EstadoTareaId = null,
                };
            }
        }
        catch (Exception e)
        {
            await swal.FireAsync("Error", e.Message, SweetAlertIcon.Error);
        }

        InProcess = false;
        StateHasChanged();
    }

    private async Task Guardar(Reporte arg)
    {
        InProcess = true;
        try
        {
            if (await Validaciones())
            {

                List<Reporte> listAdd = new List<Reporte> { arg };

                EventResponse respuesta;
                if (Modo == 3)
                {
                    SweetAlertResult result = await swal.FireAsync(new SweetAlertOptions
                    {
                        Title = "Atención",
                        Text = $"¿Está seguro(a) que desea eliminar el reporte actual?",
                        Icon = SweetAlertIcon.Error,
                        ShowCancelButton = true,
                        ConfirmButtonText = "Sí",
                        CancelButtonText = "No"
                    });

                    if (result.IsConfirmed)
                    {
                        respuesta = await genericService.Delete("Cliente", arg.Id.ToString());
                    }
                    else
                    {
                        NavigationManager.NavigateTo(UrlRetorno);
                        return;
                    }
                }
                else
                {
                    respuesta = await genericService.Post("Reporte", listAdd);
                }

                if (respuesta.Id == "0")
                {
                    NavigationManager.NavigateTo(UrlRetorno);
                }
                else
                {
                    await swal.FireAsync("Error", respuesta.Descripcion, SweetAlertIcon.Error);
                }
            }
        }
        catch (Exception e)
        {
            await swal.FireAsync("Error", "Ocurrió un error al ejecutar el proceso. Detalle de Error: " + e.Message, SweetAlertIcon.Error);
        }
        finally
        {
            InProcess = false;
        }

    }

    private async Task<bool> Validaciones()
    {


        if (Modo != 3)
        {

            if (String.IsNullOrEmpty(reporte!.ClienteId))
            {
                await swal.FireAsync("Atención", "Debe indicar los datos de Cliente.", SweetAlertIcon.Info);
                return false;
            }

            if (reporte.HoraEntrada == new TimeOnly(0,0))
            {
                await swal.FireAsync("Atención", "Debe indicar la hora de entrada.", SweetAlertIcon.Info);
                return false;
            }
            if (reporte.HoraSalida == new TimeOnly(0, 0))
            {
                await swal.FireAsync("Atención", "Debe indicar la hora de salida.", SweetAlertIcon.Info);
                return false;
            }
            if (reporte.Cantidadhoras <= 0)
            {
                await swal.FireAsync("Atención", "Debe indicar la cantidad de horas.", SweetAlertIcon.Info);
                return false;
            }
            if (String.IsNullOrEmpty(reporte.Descripcion))
            {
                await swal.FireAsync("Atención", "Debe indicar la descripción de las actividades realizadas.", SweetAlertIcon.Info);
                return false;
            }
            if (String.IsNullOrEmpty(reporte.CorreoCliente))
            {
                await swal.FireAsync("Atención", "Debe indicar el correo del encargado por parte del cliente.", SweetAlertIcon.Info);
                return false;
            }
            if (String.IsNullOrEmpty(reporte.ResponsableCliente))
            {
                await swal.FireAsync("Atención", "Debe indicar nombre del encargado por parte del cliente.", SweetAlertIcon.Info);
                return false;
            }





        }


        return true;
    }

    void Cancelar()
    {
        NavigationManager.NavigateTo(UrlRetorno);
    }


    private async Task BuscarCliente()
    {
        if (String.IsNullOrEmpty(reporte!.ClienteId))
        {
            reporte.NombreCliente = "";
            return;
        } 

        var cliente = await mtoService.GetCliente(reporte.ClienteId);
        if (cliente is not null)
        {
            reporte.NombreCliente = cliente.Nombre;
        }
        StateHasChanged();
    }


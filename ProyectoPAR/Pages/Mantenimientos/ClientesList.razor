@page "/clienteslist"
@layout MainLayout

<div class="card rz-background-color-base-200">
    <PageMant Titulo="@Titulo" OnClickAddSelected="OnClickAdd" />

    <div class="card-body">
        <RadzenStack Gap="0.5rem">
            @if (InProcess)
            {
                <SpinnerControl></SpinnerControl>
            }

            <RadzenDataGrid @ref="grid" Render="@OnRender" class="rz-border-radius-2"
                            PageSizeOptions="@Utiles.PageSizeOptions()"
                            TItem="Cliente"
                            AllowFiltering="true"
                            AllowColumnResize="true"
                            FilterMode="FilterMode.SimpleWithMenu"
                            PageSize="7"
                            AllowPaging="true"
                            AllowSorting="true"
                            AllowMultiColumnSorting="true"
                            ShowMultiColumnSortingIndex="true"
                            Data="@dataList"
                            ColumnWidth="300px"
                            FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                            FilterCleared=@FilterCleared
                            SelectionMode="DataGridSelectionMode.Single"
                            @bind-Value=@selectedData
                            LogicalFilterOperator="LogicalFilterOperator.Or"
                            FilterPopupRenderMode="PopupRenderMode.OnDemand"
                            RowDoubleClick="@OnSelect"
                            AllowColumnPicking="true"
                            AllowColumnReorder="true"
                            RowRender="@RowRender"
                            ColumnReordering="@OnColumnReordering">
                <HeaderTemplate>
                    <RadzenStack Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem;" Wrap="FlexWrap.Wrap">
                        <RadzenButton class="rz-border-radius-6" Shade="Shade.Light" ButtonStyle="ButtonStyle.Success" Text="Exportar a XLS" Icon="grid_on" Click="@(args => Export("excel"))" />
                        <RadzenButton class="rz-border-radius-6" Shade="Shade.Light" ButtonStyle="ButtonStyle.Secondary" Text="Exportar a CSV" Icon="wrap_text" Click="@(args => Export("csv"))" />
                    </RadzenStack>
                </HeaderTemplate>
                <Columns>

                    <RadzenDataGridColumn Property="@nameof(Cliente.Id)"
                                          FilterValue="@ClienteID"
                                          Filterable="true" Title="ID"
                                          Frozen="true"
                                          Width="100px"
                                          TextAlign="TextAlign.Center">
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn Property="@nameof(Cliente.Alias)" Title="Nombre Corto" Width="100px" />
                    <RadzenDataGridColumn Property="@nameof(Cliente.Nombre)" Title="Nombre" Width="300px" />
                    <RadzenDataGridColumn Property="@nameof(Cliente.Cedula)" Title="Cédula" Width="150px" />
                    <RadzenDataGridColumn Property="@nameof(Partner.Nombre)" Title="Partner" Width="150px" />
                    <RadzenDataGridColumn Title="Partner" Width="150px">
                        <Template 
                            Context="Cliente">@Cliente.Partner?.Nombre
                        </Template> 
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn Property="@nameof(Cliente.Contacto)" Title="Contacto" Width="150px" />
                    <RadzenDataGridColumn Property="@nameof(Cliente.Email)" Title="Email" Width="200px" />
                    <RadzenDataGridColumn Property="@nameof(Cliente.Telefono)" Title="Teléfono" Width="150px" />
                    <RadzenDataGridColumn Property="@nameof(Cliente.Subsidiaria)" Title="Subsidiaria" Width="80px">
                        <Template Context="Cliente">
                            <RadzenSwitch @bind-Value=@Cliente.Subsidiaria Disabled="true"></RadzenSwitch>
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn Property="@nameof(Cliente.EstadoId)" Title="Estado" Width="80px">
                        <Template Context="Cliente">
                            @{bool bEstado = Cliente.EstadoId == "A";}
                            <RadzenSwitch @bind-Value=@bEstado Disabled="true"></RadzenSwitch>
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn Property="@nameof(Cliente.FechaCreacion)" Title="Creado" FormatString="{0:d}" Width="150px" />
                    <RadzenDataGridColumn Property="@nameof(Cliente.FechaModificacion)" Title="Modificado" FormatString="{0:d}" Width="150px" />
                    <RadzenDataGridColumn Context="Cliente" Width="50px" Filterable="false" Sortable="false" TextAlign="TextAlign.Right" Frozen="true" FrozenPosition="FrozenColumnPosition.Left">
                        <Template Context="Cliente">
                            <RadzenButton  Icon="delete" ButtonStyle="ButtonStyle.Danger"
                                          Variant="Variant.Flat" Size="Radzen.ButtonSize.Medium" Shade="Shade.Lighter" class="rounded-circle rz-my-1 rz-ms-1"
                                          Click="@(args => OnDelete(Cliente))" />

                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        </RadzenStack>
    </div>
</div>
   


    

@code {
    public string Titulo { get; set; }
    private bool InProcess = true; 

    string? ClienteID;
    RadzenDataGrid<Cliente> grid;
    IEnumerable<Cliente> dataList;
    IList<Cliente> selectedData;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        if (Titulo is null) Titulo = "Clientes";
        dataList = await GetDataList();
    }


    async Task FilterCleared()
    {
        ClienteID = null;
        await grid.FirstPage();
    }

    void OnRender(DataGridRenderEventArgs<Cliente> args)
    {
        if (args.FirstRender)
        {
            args.Grid.Sorts.Add(new SortDescriptor() { Property = "Id", SortOrder = SortOrder.Ascending });

        }
    }


    private async Task<IEnumerable<Cliente>> GetDataList()
    {
        List<Cliente> model = new();
        try
        {
            model = (await mtoService.GetCliente()).ToList();
        }
        catch (Exception)
        {
            await swal.FireAsync("Error", "Error al cargar la información solicitada.", SweetAlertIcon.Info);
        }

        InProcess = false;
        StateHasChanged();
        return model;
    }

    void OnColumnReordering(DataGridColumnReorderingEventArgs<Cliente> args)
    {
        if (args.ToColumn.Property == nameof(Cliente.Id))
        {
            args.Cancel = true;
        }
    }

    private async Task OnClickAdd()
    {
        NavigationManager.NavigateTo("./clientesdetalle/0/1");
    }

    protected async Task OnSelect(DataGridRowMouseEventArgs<Cliente> args)
    {
        NavigationManager.NavigateTo("./clientesdetalle/" + args.Data.Id + "/2");
        await InvokeAsync(() => { StateHasChanged(); });
    }

    protected async void OnDelete(Cliente Cliente)
    {
        NavigationManager.NavigateTo($"./clientesdetalle/{Cliente.Id}/3");
    }

    public async Task Export(string type)
    {
        var queryableList = dataList.AsQueryable();

        var query=new Query()
            {
                OrderBy = grid.Query.OrderBy,
                Filter = grid.Query.Filter,
                Select = string.Join(",", grid.ColumnsCollection.Where(c => c.GetVisible() && !string.IsNullOrEmpty(c.Property))
                                .Select(c => c.Property.Contains(".") ? $"{c.Property} as {c.Property.Replace(".", "_")}" : c.Property))
            };

        await ExportFile(queryableList, type, query);
    }

    public async Task ExportFile(IQueryable<Cliente> Cliente, string type, Radzen.Query? query = null)
    {
        string fileName = "Clientes";
        if (type == "csv")
        {
            fileName = $"{fileName}.csv";
            await exportData.ToCSV(exportData.ApplyQuery(Cliente, query), fileName);
        }
        else
        {
            fileName = $"{fileName}.xlsx";
            await exportData.ToExcel(exportData.ApplyQuery(Cliente, query), fileName);
        }
    }

    void RowRender(RowRenderEventArgs<Cliente> args)
    {
        switch (args.Data.EstadoId)
        {
            case "I":
                args.Attributes.Add("class", "radzen-grid-row-background-color-red-light rz-data-row");
                break;
        }

    }
}

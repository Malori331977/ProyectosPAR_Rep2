@page "/clientesdetalle/{Id}/{Modo:int}"

@layout MainLayout

@inject SweetAlertService swal;
@inherits DialogSettingLayout

<div class="card">

    <PageReturn Titulo="@Titulo" UrlRetorno="@UrlRetorno" />

    <div class="card-body">
        @if (cliente is not null)
        {
            <RadzenTemplateForm Data="@cliente" Submit="@((Cliente args) => { Guardar(args); })">
                <RadzenRow Gap="0.3rem" class="rz-p-0 rz-p-lg-2">
                    <RadzenColumn Size="12" SizeMD="12">
                        <RadzenStack>
                            <RadzenFieldset Text="@Titulo">
                                <RadzenStack Gap="0.3rem">
                                    <RadzenRow AlignItems="AlignItems.Center">
                                        <RadzenColumn Size="12" SizeMD="2">
                                            <RadzenLabel Text="Id de Cliente" Component="id" />
                                            <RadzenTextBox @bind-Value=@cliente.Id Style="width: 100%" Name="id" Disabled="@soloLecturaAdd" />
                                        </RadzenColumn>
                                        <RadzenColumn Size="12" SizeMD="2">
                                            <RadzenLabel Text="Nombre Corto (alias)" Component="alias" />
                                            <RadzenTextBox @bind-Value=@cliente.Alias Maxlength="10" Style="width: 100%" Name="alias" Disabled="@soloLectura" />
                                        </RadzenColumn>
                                        <RadzenColumn Size="12" SizeMD="8">
                                            <RadzenLabel Text="Nombre Completo" Component="nombre" />
                                            <RadzenTextBox @bind-Value=@cliente.Nombre Maxlength="255" Style="width: 100%" Name="nombre" Disabled="@soloLectura" />
                                        </RadzenColumn>
                                    </RadzenRow>

                                    <RadzenRow AlignItems="AlignItems.Center">
                                        <RadzenColumn Size="12" SizeMD="3">
                                            <RadzenLabel Text="Cédula" Component="ced" />
                                            <RadzenTextBox @bind-Value=@cliente.Cedula Maxlength="25" Style="width: 100%" Name="ced" Disabled="@soloLectura" />
                                        </RadzenColumn>
                                        <RadzenColumn Size="12" SizeMD="3">
                                            <RadzenLabel Text="Teléfono" Component="tel" />
                                            <RadzenTextBox @bind-Value=@cliente.Telefono Maxlength="50" Style="width: 100%" Name="tel" Disabled="@soloLectura" />
                                        </RadzenColumn>                                        
                                        <RadzenColumn Size="12" SizeMD="3">
                                            <RadzenLabel Text="Email" Component="email" />
                                            <RadzenTextBox @bind-Value=@cliente.Email Maxlength="100" Style="width: 100%" typeof="email"
                                            Name="email" Disabled="@soloLectura" />
                                            <RadzenEmailValidator Component="email"  Text="Debe proporcionar un email correcto."  />
                                        </RadzenColumn>
                                        <RadzenColumn Size="12" SizeMD="3">
                                            <RadzenLabel Text="Estado" Component="EstadoId" />
                                            <RadzenDropDown @bind-Value="cliente.EstadoId"
                                            AllowClear="true"
                                            Placeholder="Seleccione Estado del Cliente"
                                            Disabled="@soloLectura"
                                            Data="@listEstado" Style="width: 100%;"
                                            ValueProperty="Id"
                                            TextProperty="Descripcion"
                                            Name="EstadoId">
                                            </RadzenDropDown>
                                        </RadzenColumn>
                                    </RadzenRow>
                                    <RadzenRow AlignItems="AlignItems.Center">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenLabel Text="Dirección" Component="dir" />
                                            <RadzenTextArea @bind-Value=@cliente.Direccion Maxlength="500" Style="width: 100%"
                                            Name="dir" Disabled="@soloLectura" />
                                        </RadzenColumn>
                                    </RadzenRow>

                                    <RadzenRow AlignItems="AlignItems.Center">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenLabel Text="Contacto" Component="contacto" />
                                            <RadzenTextBox @bind-Value=@cliente.Contacto Maxlength="100" Style="width: 100%"
                                            Name="contacto" Disabled="@soloLectura" />
                                        </RadzenColumn>
                                    </RadzenRow>


                                    <RadzenRow AlignItems="AlignItems.Center">
                                        <RadzenColumn Size="12" SizeMD="1">
                                            <RadzenLabel Text="Es Subsidiaria" Component="subs" />
                                            <RadzenStack Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.Center">
                                                <RadzenSwitch Disabled="@soloLectura" Placeholder="Facturado" Style="width: 25%;" Name="subs"
                                                @bind-Value="cliente.Subsidiaria" />
                                            </RadzenStack>
                                        </RadzenColumn>
                                        @if (cliente.Subsidiaria)
                                        {
                                            <RadzenColumn Size="12" SizeMD="11">
                                                <RadzenLabel Text="Compañía a la que pertenece como subsidiaria" Component="ClientePadre" />
                                                <RadzenRow AlignItems="AlignItems.Center">
                                                    <RadzenColumn Size="12" SizeMD="1">
                                                        <RadzenButton ButtonStyle="ButtonStyle.Info" Icon="search" class="rounded-circle rz-my-1 rz-ms-1" Disabled="@soloLectura" Size="Radzen.ButtonSize.Medium" Click=@OnShowModalClientes></RadzenButton>
                                                    </RadzenColumn>
                                                    <RadzenColumn Size="12" SizeMD="2">
                                                        <RadzenTextBox Style="width: 100%;" Name="ClientePadre" @bind-Value="cliente.ClientePadre" Disabled="@soloLectura"
                                                        @onfocusout="BuscarPadre" />
                                                    </RadzenColumn>
                                                    <RadzenColumn Size="12" SizeMD="9">
                                                        <RadzenTextBox Style="width: 100%;" Disabled="true" @bind-Value="NombreClientePadre" />
                                                    </RadzenColumn>
                                                </RadzenRow>
                                            </RadzenColumn>
                                        }


                                    </RadzenRow>
                                </RadzenStack>
                            </RadzenFieldset>
                        </RadzenStack>
                    </RadzenColumn>
                </RadzenRow>
                <RadzenStack Orientation="Radzen.Orientation.Horizontal" JustifyContent="JustifyContent.Center" Gap="0.5rem" class="rz-mt-8 rz-mb-4">
                    @if (Modo != 3)
                    {
                        <RadzenButton class="rz-border-radius-6" ButtonType="Radzen.ButtonType.Submit" Size="Radzen.ButtonSize.Large" Icon="save" Text="Guardar" ButtonStyle="ButtonStyle.Primary" />
                    }
                    else
                    {
                        <RadzenButton class="rz-border-radius-6" ButtonType="Radzen.ButtonType.Submit" Size="Radzen.ButtonSize.Large" Icon="delete" Text="Eliminar" ButtonStyle="ButtonStyle.Danger" />
                    }

                    <RadzenButton class="rz-border-radius-6" ButtonStyle="Radzen.ButtonStyle.Light" Variant="Variant.Flat" Size="Radzen.ButtonSize.Large" Icon="cancel" Text="Cancelar" Click="@Cancelar"  />
                </RadzenStack>
            </RadzenTemplateForm>
        }
    </div>
</div>



@code {
    [Parameter] public string Id { get; set; }
    [Parameter] public int Modo { get; set; }

    private string Titulo = "Clientes";
    private string UrlRetorno = "./clienteslist";
    private bool InProcess = true;
    private bool soloLectura = false;
    private bool soloLecturaAdd = false;
    private Cliente cliente = new();
    private IEnumerable<CatalogoGenerico>? listEstado;
    string NombreClientePadre = "";

    protected override async Task OnInitializedAsync()
    {

        soloLectura = Modo == 3;
        try
        {
            listEstado = await configService.GetCatalogoGenerico("ESTADO_GLOBAL");
            //Modos= 1:Insertar 2:Actualizar 3:Borrar 0:Consulta
            if (Modo != 1)
            {
                soloLecturaAdd = true;
                cliente = await mtoService.GetCliente(Id);
                await BuscarPadre();
            }
            else
            {
                cliente = new Cliente
                {
                    Id = "",
                    Cedula = "",
                    Contacto = "",
                    Direccion = "",                    
                    EstadoId = "A",
                    Nombre = "",
                    Email="",
                    Telefono = "",                    
                    FechaCreacion = DateTime.Now,
                    FechaModificacion = DateTime.Now,
                    UsuarioCreacion = "",
                    UsuarioModificacion = "",
                    Subsidiaria = false,
                    ClientePadre = null,
                };
            }
        }
        catch (Exception e)
        {
            await swal.FireAsync("Error", e.Message, SweetAlertIcon.Error);
        }

        InProcess = false;
        StateHasChanged();
    }

    private async Task Guardar(Cliente arg)
    {
        InProcess = true;
        try
        {
            if (await Validaciones())
            {
                arg.FechaCreacion = DateTime.Now;
                arg.FechaModificacion = DateTime.Now;
                arg.UsuarioCreacion = loginState.User.consultor!.Id.ToString();
                arg.UsuarioModificacion = loginState.User.consultor.Id.ToString();

                List<Cliente> listAdd = new List<Cliente> { arg };

                EventResponse respuesta;
                if (Modo == 3)
                {
                    SweetAlertResult result = await swal.FireAsync(new SweetAlertOptions
                        {
                            Title = "Atención",
                            Text = $"¿Está seguro(a) que desea eliminar el cliente actual?",
                            Icon = SweetAlertIcon.Error,
                            ShowCancelButton = true,
                            ConfirmButtonText = "Sí",
                            CancelButtonText = "No"
                        });

                    if (result.IsConfirmed)
                    {
                        respuesta = await genericService.Delete("Cliente", cliente.Id.ToString());
                    }
                    else
                    {
                        NavigationManager.NavigateTo(UrlRetorno);
                        return;
                    }
                }
                else
                {
                    respuesta = await genericService.Post("Cliente", listAdd);
                }

                if (respuesta.Id == "0")
                {
                    NavigationManager.NavigateTo(UrlRetorno);
                }
                else
                {
                    await swal.FireAsync("Error", respuesta.Descripcion, SweetAlertIcon.Error);
                }
            }
        }
        catch (Exception e)
        {
            await swal.FireAsync("Error", "Ocurrió un error al ejecutar el proceso. Detalle de Error: " + e.Message, SweetAlertIcon.Error);
        }
        finally
        {
            InProcess = false;
        }
    }

    

    private async Task<bool> Validaciones()
    {

        if (String.IsNullOrEmpty(cliente.Id))
        {
            await swal.FireAsync("Atención", "Debe indicar el código de Cliente.", SweetAlertIcon.Info);
            return false;
        }

        if (Modo != 3)
        {
            
            if (String.IsNullOrEmpty(cliente.Nombre))
            {
                await swal.FireAsync("Atención", "Debe indicar el Nombre del Cliente.", SweetAlertIcon.Info);
                return false;
            }
            // if (String.IsNullOrEmpty(cliente.Cedula))
            // {
            //     await swal.FireAsync("Atención", "Debe indicar la Cédula.", SweetAlertIcon.Info);
            //     return false;
            // }
            // if (String.IsNullOrEmpty(cliente.Telefono))
            // {
            //     await swal.FireAsync("Atención", "Debe indicar el Telefono.", SweetAlertIcon.Info);
            //     return false;
            // }
            if (String.IsNullOrEmpty(cliente.Direccion))
            {
                await swal.FireAsync("Atención", "Debe indicar la Dirección.", SweetAlertIcon.Info);
                return false;
            }
            if (String.IsNullOrEmpty(cliente.Contacto))
            {
                await swal.FireAsync("Atención", "Debe indicar el Contacto.", SweetAlertIcon.Info);
                return false;
            }
            if (cliente.EstadoId=="0")
            {
                await swal.FireAsync("Atención", "Debe indicar el Estado.", SweetAlertIcon.Info);
                return false;
            }
            if (cliente.Subsidiaria && String.IsNullOrEmpty(cliente.ClientePadre))
            {
                await swal.FireAsync("Atención", "Debe indicar el cliente de la compañia a la que pertenece como subsidiaria.", SweetAlertIcon.Info);
                return false;
            }
        }
        
        
        return true;
    }

    private async Task BuscarPadre()
    {
       
        if (String.IsNullOrEmpty(cliente.ClientePadre))
        {
            NombreClientePadre = "";
            return;
        }

        var clientePadre = await mtoService.GetCliente(cliente.ClientePadre);
        if (clientePadre is not null)
        {
            NombreClientePadre = clientePadre.Nombre;
        }
        StateHasChanged();
    }

    private async Task OnShowModalClientes()
    {
        Dictionary<string, object> pd = new Dictionary<string, object>();
        pd.Add("OnItemSelected", HideModalClientes);

        await dialogService.OpenAsync<ClientesPop>("Clientes",
              new Dictionary<string, object>()
                {
                    { "OnItemSelected", EventCallback.Factory.Create<Cliente>(this, HideModalClientes)}
                },
              new DialogOptions()
              {
                  Resizable = true,
                  Draggable = true,
                  Resize = base.OnResize,
                  Drag = base.OnDrag,
                  Width = Settings != null ? Settings.Width : "900px",
                  Height = Settings != null ? Settings.Height : "512px",
                  Left = Settings != null ? Settings.Left : null,
                  Top = Settings != null ? Settings.Top : null
              });
    }

    private async Task HideModalClientes(Cliente args)
    {
        cliente!.ClientePadre = args.Id;
        NombreClientePadre = args.Nombre;

        dialogService.Close(true);
        await InvokeAsync(StateHasChanged);
    }

    void Cancelar()
    {
        NavigationManager.NavigateTo(UrlRetorno);
    }
}
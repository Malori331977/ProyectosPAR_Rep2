@page "/consultoreslist"
@layout MainLayout


<div class="card rz-background-color-base-200">
    <PageMant Titulo="@Titulo" OnClickAddSelected="OnClickAdd" />

    <div class="card-body">

        <RadzenStack Gap="1rem">
            @if (InProcess)
            {
                <SpinnerControl></SpinnerControl>
            }

            <RadzenDataGrid @ref="grid" Render="@OnRender" class="rz-border-radius-2"
                            PageSizeOptions="@Utiles.PageSizeOptions()"
                            TItem="Consultor"
                            AllowFiltering="true" 
                            AllowColumnResize="true" 
                            FilterMode="FilterMode.SimpleWithMenu" 
                            PageSize="7"
                            AllowPaging="true"
                            AllowSorting="true" 
                            AllowMultiColumnSorting="true" 
                            ShowMultiColumnSortingIndex="true"
                            Data="@dataList"
                            ColumnWidth="300px"
                            FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"                           
                            FilterCleared=@FilterCleared
                            SelectionMode="DataGridSelectionMode.Single" 
                            @bind-Value=@selectedData
                            LogicalFilterOperator="LogicalFilterOperator.Or"
                            FilterPopupRenderMode="PopupRenderMode.OnDemand"
                            RowDoubleClick="@OnSelect"
                            AllowColumnPicking="true"
                            AllowColumnReorder="true" 
                            ColumnReordering="@OnColumnReordering">
                <HeaderTemplate>
                    <RadzenStack Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem;" Wrap="FlexWrap.Wrap">
                        <RadzenButton Shade="Shade.Light" ButtonStyle="ButtonStyle.Success" Text="Exportar a XLS" Icon="grid_on" Click="@(args => Export("excel"))" />
                        <RadzenButton Shade="Shade.Light" ButtonStyle="ButtonStyle.Secondary" Text="Exportar a CSV" Icon="wrap_text" Click="@(args => Export("csv"))" />
                    </RadzenStack>
                </HeaderTemplate>
                <Columns>

                    <RadzenDataGridColumn Property="@nameof(Consultor.Id)"
                                          FilterValue="@consultorID" 
                                          Filterable="true" Title="ID" 
                                          Frozen="true" 
                                          Width="80px" 
                                          TextAlign="TextAlign.Center">
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn Property="@nameof(Consultor.Usuario)" Title="Usuario" Width="150px" />
                    <RadzenDataGridColumn Property="@nameof(Consultor.PrimerApellido)" Title="Primer Apellido" Width="150px" />
                    <RadzenDataGridColumn Property="@nameof(Consultor.SegundoApellido)" Title="Segundo Apellido" Width="150px" />
                    <RadzenDataGridColumn Property="@nameof(Consultor.Nombre)" Title="Nombre" Width="150px" />
                    <RadzenDataGridColumn Property="@nameof(Consultor.Email)" Title="Email" Width="200px" />
                    <RadzenDataGridColumn Property="@nameof(Consultor.Telefono)" Title="Teléfono" Width="150px" />
                    <RadzenDataGridColumn Property="@nameof(Consultor.Activo)" Title="Activo" Width="80px">
                        <Template Context="Consultor">
                            <RadzenSwitch @bind-Value=@Consultor.Activo Disabled="true"></RadzenSwitch>
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn Property="@nameof(Consultor.FechaCreacion)" Title="Creado" FormatString="{0:d}" Width="150px" />
                    <RadzenDataGridColumn Property="@nameof(Consultor.FechaModificacion)" Title="Modificado" FormatString="{0:d}" Width="150px" />
                    <RadzenDataGridColumn Context="Consultor" Width="50px" Filterable="false" Sortable="false" TextAlign="TextAlign.Right" Frozen="true" FrozenPosition="FrozenColumnPosition.Left">
                        <Template Context="Consultor">
                            <RadzenButton  Icon="delete" ButtonStyle="ButtonStyle.Danger"
                                          Variant="Variant.Flat" Size="Radzen.ButtonSize.Medium" Shade="Shade.Lighter" class="rounded-circle rz-my-1 rz-ms-1"
                                          Click="@(args => OnDelete(Consultor))" />
                       </Template>
                       
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        </RadzenStack>
        
    </div>
</div>

@code {
    public string Titulo { get; set; }
    private bool InProcess = true; 

    int? consultorID;
    RadzenDataGrid<Consultor> grid;
    IEnumerable<Consultor> dataList;
    IList<Consultor> selectedData;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        if (Titulo is null) Titulo = "Consultores";
        dataList = await GetDataList();
    }


    async Task FilterCleared()
    {
        consultorID = null;
        await grid.FirstPage();
    }

    void OnRender(DataGridRenderEventArgs<Consultor> args)
    {
        if (args.FirstRender)
        {
            args.Grid.Sorts.Add(new SortDescriptor() { Property = "Id", SortOrder = SortOrder.Ascending });

        }
    }


    private async Task<IEnumerable<Consultor>> GetDataList()
    {
        List<Consultor> model = new();
        try
        {
            model = (await mtoService.GetConsultor()).ToList();

        }
        catch (Exception)
        {
            await swal.FireAsync("Error", "Error al cargar la información solicitada.", SweetAlertIcon.Info);
        }

        InProcess = false;
        StateHasChanged();
        return model;
    }

    void OnColumnReordering(DataGridColumnReorderingEventArgs<Consultor> args)
    {
        if (args.ToColumn.Property == nameof(Consultor.Id))
        {
            args.Cancel = true;
        }
    }

    private async Task OnClickAdd()
    {
        NavigationManager.NavigateTo("./consultoresdetalle/0/1");
    }

    protected async Task OnSelect(DataGridRowMouseEventArgs<Consultor> args)
    {
        NavigationManager.NavigateTo("./consultoresdetalle/" + args.Data.Id + "/2");
        await InvokeAsync(() => { StateHasChanged(); });
    }

    protected async void OnDelete(Consultor consultor)
    {
        NavigationManager.NavigateTo($"./consultoresdetalle/{consultor.Id}/3");
    }

    public async Task Export(string type)
    {
        var queryableList = dataList.AsQueryable();

        var query=new Query()
            {
                OrderBy = grid.Query.OrderBy,
                Filter = grid.Query.Filter,
                Select = string.Join(",", grid.ColumnsCollection.Where(c => c.GetVisible() && !string.IsNullOrEmpty(c.Property))
                                .Select(c => c.Property.Contains(".") ? $"{c.Property} as {c.Property.Replace(".", "_")}" : c.Property))
            };

        await ExportFile(queryableList, type, query);
    }

    public async Task ExportFile(IQueryable<Consultor> consultor, string type, Radzen.Query? query = null)
    {
        string fileName = "Consultores";
        if (type == "csv")
        {
            fileName = $"{fileName}.csv";
            await exportData.ToCSV(exportData.ApplyQuery(consultor, query), fileName);
        }
        else
        {
            fileName = $"{fileName}.xlsx";
            await exportData.ToExcel(exportData.ApplyQuery(consultor, query), fileName);
        }
    }
}

@page "/partnersdetalle/{Id:int}/{Modo:int}"
@inherits DialogSettingLayout

@if (partner == null)
{
    <SpinnerControl></SpinnerControl>
}
else
{
    <div class="card">
        <PageReturn Titulo="@Titulo" UrlRetorno="@UrlRetorno" />

        <div class="card-body">
            <RadzenTemplateForm Data="@partner" Submit="@((Partner args) => { Guardar(args); })">
                <RadzenRow Gap="0.3rem" class="rz-p-0 rz-p-lg-2">
                    <RadzenColumn Size="12" SizeMD="12">
                        <RadzenStack>
                            <RadzenFieldset Text="@Titulo">
                                <RadzenStack Gap="0.3rem">
                                    <RadzenRow AlignItems="AlignItems.Center">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenLabel Text="Nombre" Component="nombre" />
                                            <RadzenTextBox @bind-Value=@partner.Nombre Style="width: 100%" Name="nombre" Disabled="@soloLectura" />
                                        </RadzenColumn>
                                    </RadzenRow>
                                    <RadzenRow AlignItems="AlignItems.Center">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenLabel Text="Descrpción" Component="descripcion" />
                                            <RadzenTextBox @bind-Value=@partner.Descripcion Style="width: 100%" Name="nombre" Disabled="@soloLectura" />
                                        </RadzenColumn>
                                    </RadzenRow>
                                    <RadzenRow AlignItems="AlignItems.Center">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenLabel Text="Estado" Component="EstadoId" />
                                            <RadzenDropDown @bind-Value="partner.EstadoId"
                                                            AllowClear="true"
                                                            Placeholder="Seleccione Estado del Partner"
                                                            Data="@listEstadoPartner" Style="width: 100%;"
                                                            ValueProperty="Id"
                                                            TextProperty="Descripcion"
                                                            Disabled="@soloLectura"
                                                            Name="EstadoId">
                                            </RadzenDropDown>
                                        </RadzenColumn>
                                    </RadzenRow>
                                </RadzenStack>
                            </RadzenFieldset>
                        </RadzenStack>
                    </RadzenColumn>
                </RadzenRow>
                <RadzenStack Orientation="Radzen.Orientation.Horizontal" JustifyContent="JustifyContent.Center" Gap="0.5rem" class="rz-mt-8 rz-mb-4">
                    @if (Modo == 3)
                    {
                        <RadzenButton class="rz-border-radius-6" ButtonType="Radzen.ButtonType.Submit" ButtonStyle="ButtonStyle.Danger" Size="Radzen.ButtonSize.Large" Icon="delete" Text="Eliminar" />
                    }
                    else
                    {
                        <RadzenButton class="rz-border-radius-6" ButtonType="Radzen.ButtonType.Submit" Size="Radzen.ButtonSize.Large" Icon="save" Text="Guardar" />
                    }
                    <RadzenButton class="rz-border-radius-6" ButtonStyle="Radzen.ButtonStyle.Light" Variant="Variant.Flat" Size="Radzen.ButtonSize.Large" Icon="cancel" Text="Cancelar" Click="@Cancelar" />
                </RadzenStack>
            </RadzenTemplateForm>
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }
    [Parameter] public int Modo { get; set; }

    private string Titulo = "Detalle Partner";
    private string UrlRetorno = "./partnerslist";
    private bool InProcess = true;
    private bool soloLectura = false;
    private bool soloLecturaAdd = false;
    private Partner? partner = null;
    private IEnumerable<CatalogoGenerico>? listEstadoPartner;

    private async Task LoadEstadoPartner() => listEstadoPartner = await configService.GetCatalogoGenerico("ESTADO_GLOBAL");
    private async Task LoadPartner()
    {
        if (Modo != 1)
        {
            var repo = await mtoService.GetPartner(Id);
            if (repo is not null)
            {
                partner = new Partner
                {
                    Id = repo.Id,
                    Nombre = repo.Nombre,
                    Descripcion = repo.Descripcion,
                    EstadoId = repo.EstadoId,
                    FechaCreacion = repo.FechaCreacion,
                    UsuarioCreacion = repo.UsuarioCreacion,
                    FechaModificacion = repo.FechaModificacion,
                    UsuarioModificacion = repo.UsuarioModificacion,
                };
            }
        }
    }

    private List<Task> GetLoadTasks()
    {
        return new List<Task>
        {
            LoadEstadoPartner(),
            LoadPartner(),
        };
    }

    protected override async Task OnInitializedAsync()
    {
        soloLectura = Modo == 3;
        try
        {
            // Definir la lista de tareas a llamar
            var tasks = GetLoadTasks();

            // Esperar a que todas las tareas se completen
            await Task.WhenAll(tasks);

            //Modos= 1:Insertar 2:Actualizar 3:Borrar 0:Consulta
            if (Modo != 1)
            {
                soloLecturaAdd = true;
            }
            else
            {
                partner = new Partner
                {
                    Id = 0,
                    Nombre = "",
                    Descripcion = "",
                    EstadoId = "A",
                    FechaCreacion = DateTime.Now,
                    UsuarioCreacion = loginState.User.consultor!.Id.ToString(),
                    FechaModificacion = DateTime.Now,
                    UsuarioModificacion = loginState.User.consultor!.Id.ToString(),
                };
            }
        }
        catch (Exception e)
        {
            await swal.FireAsync("Error", e.Message, SweetAlertIcon.Error);
        }
        InProcess = false;
        StateHasChanged();
    }

    private async Task Guardar(Partner arg)
    {
        InProcess = true;
        try
        {
            if (await Validaciones())
            {
                List<Partner> listAdd = new List<Partner> { arg };
                EventResponse respuesta;

                if (Modo == 3)
                {
                    SweetAlertResult result = await swal.FireAsync(new SweetAlertOptions
                    {
                        Title = "Atención",
                        Text = $"¿Está seguro(a) que desea eliminar el partner actual?",
                        Icon = SweetAlertIcon.Error,
                        ShowCancelButton = true,
                        ConfirmButtonText = "Sí",
                        CancelButtonText = "No"
                    });

                    if (result.IsConfirmed)
                    {
                        respuesta = await genericService.Delete("Partner", arg.Id.ToString());
                    }
                    else
                    {
                        NavigationManager.NavigateTo(UrlRetorno);
                        return;
                    }
                }
                else
                {
                    respuesta = await genericService.Post("Partner", listAdd);
                }

                if (respuesta.Id == "0")
                {
                    NavigationManager.NavigateTo(UrlRetorno);
                }
                else
                {
                    await swal.FireAsync("Error", respuesta.Descripcion, SweetAlertIcon.Error);
                }
            }
        }
        catch (Exception e)
        {
            await swal.FireAsync("Error", "Ocurrió un error al ejecutar el proceso. Detalle de Error: " + e.Message, SweetAlertIcon.Error);
        }
        finally
        {
            InProcess = false;
        }
    }

    private async Task<bool> Validaciones()
    {
        if (Modo != 3)
        {
            if (String.IsNullOrEmpty(partner!.Nombre))
            {
                await swal.FireAsync("Atención", "Debe indicar el nombre del partner.", SweetAlertIcon.Info);
                return false;
            }
            if (String.IsNullOrEmpty(partner!.Descripcion))
            {
                await swal.FireAsync("Atención", "Debe indicar la descripción del partner.", SweetAlertIcon.Info);
                return false;
            }
            if (String.IsNullOrEmpty(partner!.EstadoId))
            {
                await swal.FireAsync("Atención", "Debe seleccionar el estado del partner.", SweetAlertIcon.Info);
                return false;
            }
        }
        return true;
    }

    void Cancelar()
    {
        NavigationManager.NavigateTo(UrlRetorno);
    }
}


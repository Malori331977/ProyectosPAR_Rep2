@page "/tareaslist"
@layout MainLayout

<div class="card rz-background-color-base-200">
    <PageMant Titulo="@Titulo" OnClickAddSelected="OnClickAdd" />

    <div class="card-body">
        <RadzenStack Gap="0.5rem">
            @if (InProcess)
            {
                <SpinnerControl></SpinnerControl>
            }

            <RadzenDataGrid @ref="grid" Render="@OnRender" class="rz-border-radius-2"
                            PageSizeOptions="@Utiles.PageSizeOptions()"
                            TItem="Tarea"
                            AllowFiltering="true"
                            AllowColumnResize="true"
                            FilterMode="FilterMode.SimpleWithMenu"
                            PageSize="7"
                            AllowPaging="true"
                            AllowSorting="true"
                            AllowMultiColumnSorting="true"
                            ShowMultiColumnSortingIndex="true"
                            Data="@dataList"
                            ColumnWidth="300px"
                            FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                            FilterCleared=@FilterCleared
                            SelectionMode="DataGridSelectionMode.Single"
                            @bind-Value=@selectedData
                            LogicalFilterOperator="LogicalFilterOperator.Or"
                            FilterPopupRenderMode="PopupRenderMode.OnDemand"
                            RowDoubleClick="@OnSelect"
                            AllowColumnPicking="true"
                            AllowColumnReorder="true"
                            ColumnReordering="@OnColumnReordering">
                <HeaderTemplate>
                    <RadzenStack Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem;" Wrap="FlexWrap.Wrap">
                        <RadzenButton class="rz-border-radius-6" Shade="Shade.Light" ButtonStyle="ButtonStyle.Success" Text="Exportar a XLS" Icon="grid_on" Click="@(args => Export("excel"))" />
                        <RadzenButton class="rz-border-radius-6" Shade="Shade.Light" ButtonStyle="ButtonStyle.Secondary" Text="Exportar a CSV" Icon="wrap_text" Click="@(args => Export("csv"))" />
                    </RadzenStack>
                </HeaderTemplate>
                <Columns>

                    <RadzenDataGridColumn Property="@nameof(Tarea.Id)"
                                          FilterValue="@TareaID"
                                          Filterable="true" Title="ID"
                                          Frozen="true"
                                          Width="100px"
                                          TextAlign="TextAlign.Center">
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn Property="@nameof(Tarea.Codigo)" Title="Codigo" Width="150px" />
                    <RadzenDataGridColumn Property="@nameof(Tarea.Descripcion)" Title="Descripcion" Width="300px" />
                    <RadzenDataGridColumn Property="@nameof(Tarea.EstadoId)" Title="Estado" Width="150px" />                    
                    <RadzenDataGridColumn Property="@nameof(Tarea.FechaCreacion)" Title="Creado" FormatString="{0:d}" Width="150px" />
                    <RadzenDataGridColumn Property="@nameof(Tarea.FechaModificacion)" Title="Modificado" FormatString="{0:d}" Width="150px" />
                    <RadzenDataGridColumn Context="Tarea" Width="50px" Filterable="false" Sortable="false" TextAlign="TextAlign.Right" Frozen="true" FrozenPosition="FrozenColumnPosition.Left">
                        <Template Context="Tarea">
                            <RadzenButton  Icon="delete" ButtonStyle="ButtonStyle.Danger"
                                          Variant="Variant.Flat" Size="Radzen.ButtonSize.Medium" Shade="Shade.Lighter" class="rounded-circle rz-my-1 rz-ms-1"
                                          Click="@(args => OnDelete(Tarea))" />

                        </Template>

                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        </RadzenStack>
    </div>
</div>
   


    

@code {
    public string Titulo { get; set; }
    private bool InProcess = true; 

    string? TareaID;
    RadzenDataGrid<Tarea> grid;
    IEnumerable<Tarea> dataList;
    IList<Tarea> selectedData;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        if (Titulo is null) Titulo = "Tareas";
        dataList = await GetDataList();
    }


    async Task FilterCleared()
    {
        TareaID = null;
        await grid.FirstPage();
    }

    void OnRender(DataGridRenderEventArgs<Tarea> args)
    {
        if (args.FirstRender)
        {
            args.Grid.Sorts.Add(new SortDescriptor() { Property = "Id", SortOrder = SortOrder.Ascending });

        }
    }


    private async Task<IEnumerable<Tarea>> GetDataList()
    {
        List<Tarea> model = new();
        try
        {
            model = (await mtoService.GetTarea()).ToList();

        }
        catch (Exception)
        {
            await swal.FireAsync("Error", "Error al cargar la información solicitada.", SweetAlertIcon.Info);
        }

        InProcess = false;
        StateHasChanged();
        return model;
    }

    void OnColumnReordering(DataGridColumnReorderingEventArgs<Tarea> args)
    {
        if (args.ToColumn.Property == nameof(Tarea.Id))
        {
            args.Cancel = true;
        }
    }

    private async Task OnClickAdd()
    {
        NavigationManager.NavigateTo("./tareasdetalle/0/1");
    }

    protected async Task OnSelect(DataGridRowMouseEventArgs<Tarea> args)
    {
        NavigationManager.NavigateTo("./Tareasdetalle/" + args.Data.Id + "/2");
        await InvokeAsync(() => { StateHasChanged(); });
    }

    protected async void OnDelete(Tarea Tarea)
    {
        NavigationManager.NavigateTo($"./tareasdetalle/{Tarea.Id}/3");
    }

    public async Task Export(string type)
    {
        var queryableList = dataList.AsQueryable();

        var query=new Query()
            {
                OrderBy = grid.Query.OrderBy,
                Filter = grid.Query.Filter,
                Select = string.Join(",", grid.ColumnsCollection.Where(c => c.GetVisible() && !string.IsNullOrEmpty(c.Property))
                                .Select(c => c.Property.Contains(".") ? $"{c.Property} as {c.Property.Replace(".", "_")}" : c.Property))
            };

        await ExportFile(queryableList, type, query);
    }

    public async Task ExportFile(IQueryable<Tarea> Tarea, string type, Radzen.Query? query = null)
    {
        string fileName = "Tareas";
        if (type == "csv")
        {
            fileName = $"{fileName}.csv";
            await exportData.ToCSV(exportData.ApplyQuery(Tarea, query), fileName);
        }
        else
        {
            fileName = $"{fileName}.xlsx";
            await exportData.ToExcel(exportData.ApplyQuery(Tarea, query), fileName);
        }
    }
}

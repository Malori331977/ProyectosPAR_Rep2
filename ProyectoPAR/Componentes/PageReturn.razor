@inject NavigationManager NavigationManager

<div class="card-header  rz-background-color-base rz-text-contrast-color">
    <RadzenRow>
        <RadzenColumn>
            <RadzenStack Orientation="Radzen.Orientation.Horizontal" JustifyContent="JustifyContent.Start" Gap="0">
                <RadzenStack Orientation="Radzen.Orientation.Horizontal" JustifyContent="JustifyContent.End" Wrap="FlexWrap.Wrap">
                    <RadzenButton ButtonStyle="ButtonStyle.Secondary" Variant="Variant.Flat" Size="Radzen.ButtonSize.Medium" Shade="Shade.Lighter"
                                  Icon="arrow_back"  class="rounded-circle rz-my-1 rz-ms-1"
                                  Click=@(args => OnClickRetorno())  />
                </RadzenStack>
            </RadzenStack>
        </RadzenColumn>
        <RadzenColumn>
            <RadzenStack Orientation="Radzen.Orientation.Horizontal" JustifyContent="JustifyContent.Center" Gap="0">
                <h3>@Titulo</h3>
            </RadzenStack>
        </RadzenColumn>
        <RadzenColumn>            
        </RadzenColumn>

    </RadzenRow>

</div>


@code {
    [Parameter]
    public string Titulo { get; set; }

    [Parameter]
    public string UrlRetorno { get; set; }

    private async Task OnClickRetorno()
    {
        NavigationManager.NavigateTo(UrlRetorno);

    }
}



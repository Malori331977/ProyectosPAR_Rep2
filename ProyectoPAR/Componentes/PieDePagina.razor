

<div class="row">
	<div class="col-2 text-start">
		<Icon Name="IconName.Person" Size="IconSize.x6" /> @consultor
	</div>
	<div class="col-8 text-center ">
		&copy; @DateTime.Now.Year - Powered by GeoTime
	</div>
	<div class="col-2 text-end">
		@versionSistema
	</div>
</div>


@code {


	private string versionSistema = "";
	string compania = "";
	string consultor = "";

	protected override async Task OnInitializedAsync()
	{
		try
		{
			Version version = typeof(Program).Assembly.GetName().Version;
			versionSistema = $"v.{version.Major}.{version.Minor}.{version.Build}";

			if (loginState.User is not null)
				if (loginState.User.consultor is not null)
					consultor = $"{loginState.User.consultor.Nombre} {loginState.User.consultor.PrimerApellido} {loginState.User.consultor.SegundoApellido}";

		}
		catch (Exception e)
		{
			Console.WriteLine(e);
		}

	}

}
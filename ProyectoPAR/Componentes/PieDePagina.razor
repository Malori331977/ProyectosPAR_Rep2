

	<div class="row">
		<div class="col-2 text-start">
			<Icon Name="IconName.BuildingFillCheck" Size="IconSize.x6" />
		</div>
		<div class="col-8 text-center ">
			&copy; @DateTime.Now.Year - Powered by GeoTime
		</div>
		<div class="col-2 text-end">
			@versionSistema
		</div>
	</div>


@code {


	private string versionSistema = "";
	string compania = "";

	protected override async Task OnInitializedAsync()
	{
		try
		{
			Version version = typeof(Program).Assembly.GetName().Version;
			versionSistema = $"v.{version.Major}.{version.Minor}.{version.Build}";
			
		}
		catch (Exception e)
		{
			Console.WriteLine(e);
		}

	}

}
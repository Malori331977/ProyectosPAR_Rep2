@page "/userCambioContrasena"


@implements IDisposable
@layout IndexLayout

<style media="screen">
    *,
    *:before,
    *:after {
        padding: 0;
        margin: 0;
        box-sizing: border-box;
    }

    body {
        background-color: #808080;
    }

    .background {
        width: 430px;
        height: 720px;
        position: absolute;
        transform: translate(-50%,-50%);
        left: 50%;
        top: 50%;
    }

        .background .shape {
            height: 200px;
            width: 200px;
            position: absolute;
            border-radius: 50%;
        }


    form {
        height: 520px;
        width: 400px;
        background-color: rgba(255,255,255,0.13);
        position: absolute;
        transform: translate(-50%,-50%);
        top: 50%;
        left: 75%;
        border-radius: 10px;
        backdrop-filter: blur(10px);
        border: 2px solid rgba(255,255,255,0.1);
        box-shadow: 0 0 40px rgba(8,7,16,0.6);
        padding: 50px 35px;
    }

        form * {
            font-family: 'Poppins',sans-serif;
            color: #ffffff;
            letter-spacing: 0.5px;
            outline: none;
            border: none;
        }

        form h3 {
            font-size: 28px;
            font-weight: 400;
            line-height: 42px;
            text-align: center;
        }

        form h5 {
            font-size: 16px;
            font-weight: 400;
            line-height: 24px;
            text-align: center;
        }

    button {
        margin-top: 30px;
        width: 100%;
        background-color: #ffffff;
        border-radius: 999px;
        color: #080710;
        padding: 15px 0;
        font-size: 18px;
        font-weight: 600;
        cursor: pointer;
    }

    label {
        display: block;
        margin-top: 30px;
        font-size: 16px;
        font-weight: 500;
    }

    input {
        display: block;
        height: 50px;
        width: 100%;
        background-color: azure;
        border-radius: 999px;
        padding: 0 10px;
        margin-top: 8px;
        font-size: 14px;
        font-weight: 300;
        color: black;
    }


    ::placeholder {
        color: darkgray;
    }



    img {
        margin-top: -50px;
        margin-left: -50px;
        width: 50%;
        height: 105vh;
        padding: 0 0;
        cursor: pointer;
    }

</style>

<img src="./img/ImagenInicio.jpg" @onclick="Retorno" />
<div class="background">
</div>

<EditForm Model="@dataPassword" OnValidSubmit="cambiarPassword">
    <DataAnnotationsValidator />
    <h3><Icon CustomIconName="fa-solid fa-user-pen" Size="IconSize.x2" /> @Titulo</h3>

    <h5 class="text-center">
        Ahora ya puedes cambiar tu contraseña
    </h5>

    <label for="password">Indica tu nueva Contraseña</label>
    <InputText type="password" placeholder="Nueva Contraseña" id="password"
               @bind-Value="dataPassword.Password" />
    <ValidationMessage For="@(() => dataPassword.Password)" />

    <label for="ConfirmPassword">Confirma tu nueva Contraseña</label>
    <InputText type="password" placeholder="Confirmación de Contraseña" id="ConfirmPassword"
               @bind-Value="dataPassword.ConfirmPassword" />
    <ValidationMessage For="@(() => dataPassword.ConfirmPassword)" />

    <button type="submit" class="mb-3">
        Cambiar Contraseña
    </button>
</EditForm>


@code {
    private UserLogin usuario = new();
    private DataPassword dataPassword = new();
    private string Titulo = "Cambiar Contraseña";
    bool InProcess = false;

    protected override void OnInitialized()
    {
        loginState.OnChange += StateHasChanged;
    }

    private async Task cambiarPassword()
    {
        try
        {
            InProcess = true;

            usuario = await configService.GetUserLogin(loginState.User.consultor!.Id);

            if (usuario is not null)
            {
                if (dataPassword.Password == dataPassword.ConfirmPassword)
                {
                    usuario.Clave = dataPassword.ConfirmPassword;

                    var respuesta = await genericService.Post("UsuarioCambioClave", usuario);

                    if (respuesta.Id=="0"){
                        await swal.FireAsync("Atención", "Se ha realizado el cambio de Contraseña exitosamente", SweetAlertIcon.Success);
                        RedirectTo("./");
                    }
                    else{
                        await swal.FireAsync("Atención", respuesta.Descripcion, SweetAlertIcon.Error);
                    }

                }
                else{
                    await swal.FireAsync("Atención", "Los datos ingresados no coinciden, verifique la contraseña ingresada.", SweetAlertIcon.Error);
                }
                
            }
            else
            {
                await swal.FireAsync("Atención", "No se encontraron los datos del usuario.", SweetAlertIcon.Error);
            }
        }
        catch (Exception e)
        {
            Console.WriteLine(e);
            await swal.FireAsync("Error", "Se presentó un error al procesar solicitud: " + e.Message, "Cerrar ");
            RedirectTo("./");
        }
        finally{
            InProcess = false;
        }
    }

    void Retorno() => RedirectTo("./");

    void RedirectTo(string path) => NavigationManager.NavigateTo(path);

    public void Dispose()
    {
        loginState.OnChange -= StateHasChanged;
    }
}

@page "/userOlvidoContrasena"

@implements IDisposable
@layout IndexLayout


<style media="screen">
    *,
    *:before,
    *:after {
    padding: 0;
    margin: 0;
    box-sizing: border-box;
    }

    body {
    background-color: #808080;
    }

    .background {
    width: 430px;
    height: 520px;
    position: absolute;
    transform: translate(-50%,-50%);
    left: 50%;
    top: 50%;
    }

    .background .shape {
    height: 200px;
    width: 200px;
    position: absolute;
    border-radius: 50%;
    }


    form {
    height: 620px;
    width: 400px;
    background-color: rgba(255,255,255,0.13);
    position: absolute;
    transform: translate(-50%,-50%);
    top: 50%;
    left: 75%;
    border-radius: 10px;
    backdrop-filter: blur(10px);
    border: 2px solid rgba(255,255,255,0.1);
    box-shadow: 0 0 40px rgba(8,7,16,0.6);
    padding: 50px 35px;
    }

    form * {
    font-family: 'Poppins',sans-serif;
    color: #ffffff;
    letter-spacing: 0.5px;
    outline: none;
    border: none;
    }

    form h3 {
    font-size: 28px;
    font-weight: 400;
    line-height: 42px;
    text-align: center;
    }

    form h5 {
    font-size: 16px;
    font-weight: 400;
    line-height: 24px;
    text-align: center;
    }

    button {
    margin-top: 50px;
    width: 100%;
    background-color: #ffffff;
    border-radius: 999px;
    color: #080710;
    padding: 15px 0;
    font-size: 18px;
    font-weight: 600;
    cursor: pointer;
    }

    label {
    display: block;
    margin-top: 30px;
    font-size: 16px;
    font-weight: 500;
    }

    input {
    display: block;
    height: 50px;
    width: 100%;
    background-color: azure;
    border-radius: 999px;
    padding: 0 10px;
    margin-top: 8px;
    font-size: 14px;
    font-weight: 300;
    color:black;
    }

    ::placeholder {
    color: darkgray;
    }

    select {
    display: block;
    height: 50px;
    width: 100%;
    background-color: azure;
    border-radius: 999px;
    padding: 0 10px;
    margin-top: 8px;
    font-size: 14px;
    font-weight: 300;
    color: black;
    }




    img {
    margin-top: -50px;
    margin-left: -50px;
    width: 50%;
    height: 105vh;
    padding: 0 0;
    cursor: pointer;
    }

</style>

<img src="img/ImagenInicio.png" @onclick="Retorno" />
<div class="background">
</div>

<EditForm Model="@user" OnValidSubmit="ValidarCorreo">
    <DataAnnotationsValidator />
    <h3><Icon CustomIconName="fa-solid fa-user-gear" Size="IconSize.x2" /> Olvidaste tu contraseña</h3>

    <h5 class="text-center">
        Para restablecer tu contraseña, introduce tu código de usuario del sistema
    </h5>

    <label for="usuario">Código de Usuario</label>
    <InputText maxlength="20" placeholder="Código de Usuario" id="usuario"
    @bind-Value="user.consultor!.Usuario"/> 
    <ValidationMessage For="@(() => user.consultor!.Usuario)" />

    <button type="submit" class="mb-3">
        ¡Enviar!
    </button>
</EditForm>



@code {

    private UserData user = new UserData
    {
        consultor = new Consultor(),
        userLogin = new UserLogin()
    };
    private string Titulo = "Olvidaste tu Contraseña";
    bool InProcess = false;


    protected override async void OnInitialized()
    {
        InProcess = true;
        try
        {
            loginState.OnChange += StateHasChanged;

        }
        catch (Exception e)
        {
            Console.WriteLine(e);
            RedirectTo("./");
        }
        finally
        {
            InProcess = false;
        }
        StateHasChanged();

    }


    private async Task ValidarCorreo()
    {
        try
        {
            InProcess = true;

            var consultor = await mtoService.GetConsultorByUsuario(user.consultor!.Usuario);

            if (consultor is null)
            {
                await swal.FireAsync("Atención", "No fue posible encontrar una cuenta con éste código de usuario. Por favor verifique el código de usuario que ha ingresado.", SweetAlertIcon.Error);
                return;
            }

            if (!consultor.Activo)
            {
                await swal.FireAsync("Atención", "Su código de usuario se encuentra inactivo. Por favor comúniquese con los adminsitradores del sistema para verificar el estado.", SweetAlertIcon.Error);
                return;
            }

            if (consultor.Email is not null)
            {
                var userLogin = await configService.GetUserLogin(consultor!.Id);
                user.consultor = consultor;
                user.userLogin = userLogin;

                loginState.SetLogin(user);

                user.userLogin.CodigoSeguridad = Utiles.GeneraCodigoSeguridad();
                user.userLogin.FechaModificacion = DateTime.Now;
                user.userLogin.Clave = "";

                var respuesta = await genericService.Post("UserLogin", user.userLogin);

                if (respuesta.Id == "0")
                {
                    //Emviar Correo
                    await emailRepo.EnviaCorreoCambioPassword(user);

                    await swal.FireAsync("Atención", "Pronto recibirás un correo con el código de seguridad con el que podrás restablecer tu contraseña.", SweetAlertIcon.Success);
                    RedirectTo("./userCodigoContrasena");
                }
                else
                {
                    await swal.FireAsync("Error", respuesta.Descripcion, SweetAlertIcon.Error);
                }
            }
            else
            {
                await swal.FireAsync("Atención", "No fue posible encontrar una cuenta con éste correo. Por favor verifique la dirección de correo que ha ingresado.", SweetAlertIcon.Error);
            }

        }
        catch (Exception e)
        {
            Console.WriteLine(e);
            await swal.FireAsync("Error", "Se presentó un error al procesar solicitud: " + e.Message, "Cerrar ");
            RedirectTo("./");
        }
        finally{
            InProcess = false;
        }

    }
   
        
    void Retorno() => RedirectTo("./");

    void RedirectTo(string path) => NavigationManager.NavigateTo(path);

    public void Dispose()
    {
        loginState.OnChange -= StateHasChanged;
    }

   
}

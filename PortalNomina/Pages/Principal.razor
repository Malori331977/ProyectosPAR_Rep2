@page "/principal"

@layout MainLayout

<style>

    .card_img {
        width: 10rem;
        height: 10rem;
        overflow: hidden;
        border-radius: 100%;
        max-width: 10rem;
    }
</style>

<PageTitle>Principal</PageTitle>

<div class="container-fluid px-0 py-0">
    <div class="card  mb-0 px-0 py-0">
        <div class="card-body shadow mb-2 h-100 py-3 px-3">
            <div class="row">

                @if (menuPrincipal is not null)
                {
                    @foreach (var itemMenu in menuPrincipal)
                    {

                        <div class="col mb-3 d-flex flex-col justify-content-center">
                            <div class="card card_img shadow mb-1 text-center h-100 bi">
                                <br />
                                <a class="nav-lnk" href="./secundario/@itemMenu.ID.ToString()">
                                    <span class="material-icons md-84">
                                        settings
                                    </span>
                                </a>
                                <label style="font-size:small">@itemMenu.MENUTEXT</label><br />
                            </div>
                        </div>

                    }
                }
            </div>
        </div>
    </div>
    
</div>

@code {

    IEnumerable<MenuPrincipal> menuPrincipal;


    protected override async Task OnInitializedAsync()
    {

        try
        {
            if (loginState.User is null)
            {
                NavigationManager.NavigateTo("./");
                return;
            }
            else
            {
                if (loginState.User.Id == null)
                {
                    NavigationManager.NavigateTo("./");
                    return;
                }
            }

            menuPrincipal = await configService.GetMenuPrincipal();

        }
        catch (Exception e)
        {
            await swal.FireAsync("Atención", "Se presentó un error al cargar el Menú Principal: " + e.Message, SweetAlertIcon.Error);
            NavigationManager.NavigateTo("./");
            Console.WriteLine(e.Message);
        }

        StateHasChanged();
    }




}
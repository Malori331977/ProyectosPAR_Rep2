@page "/puestoslist"

@layout MainLayout

<div class="card">
    <PageMant Titulo="@Titulo" OnClickAddSelected="OnClickAdd" />
    <div class="card-body">
        @if (InProcess)
        {
            <SpinnerControl></SpinnerControl>
        }
        <Grid @ref="grid" TItem="Puesto" class="table custom-table table-hover table-bordered table-striped"
              DataProvider="modelDataProvider" AllowFiltering="true" Responsive="true"
              AllowPaging="true" PageSize="10" AllowSorting="true" Height="600"
              HeaderRowCssClass="custom-header border-bottom-0"
              FiltersRowCssClass="custom-filter text-white border-bottom-0"
              AllowRowClick="true"
              OnRowClick="OnSelect">

            <GridColumns>
                <GridColumn TItem="Puesto" HeaderText="Id" PropertyName="Id" SortKeySelector="item => item.Id">
                    @context.Id
                </GridColumn>
                <GridColumn TItem="Puesto" HeaderText="Descripción" PropertyName="Descripcion" SortKeySelector="item => item.Descripcion">
                    @context.Descripcion
                </GridColumn>
                <GridColumn TItem="Puesto" HeaderText="Activo" PropertyName="Activo" SortKeySelector="item => item.Activo">
                    <Switch Class="ml-5" @bind-Value="@context.Activo" Disabled />
                </GridColumn>
                <GridColumn TItem="Puesto" HeaderText="Salario Mínimo" PropertyName="SalarioMinimo" SortKeySelector="item => item.SalarioMinimo">
                    @context.SalarioMinimo
                </GridColumn>
                <GridColumn TItem="Puesto" HeaderText="Salario Máximo" PropertyName="SalarioMaximo" SortKeySelector="item => item.SalarioMaximo">
                    @context.SalarioMaximo
                </GridColumn>
                <GridColumn TItem="Puesto" HeaderText="Salario Actual" PropertyName="SalarioActual" SortKeySelector="item => item.SalarioActual">
                    @context.SalarioActual
                </GridColumn>
                <GridColumn TItem="Puesto" HeaderText="Notas" PropertyName="Notas">
                    @context.Notas
                </GridColumn>
                <GridColumn TItem="Puesto" HeaderText="Acción" PropertyName="action" Filterable="false" TextAlignment="Alignment.Center">
                    <button class="btn btn-danger rounded-circle text-white" type="submit" @onclick="@((e)=> OnDelete(e, context))">
                        <Icon Name="IconName.Trash" Size="IconSize.x6" />
                    </button>
                </GridColumn>
            </GridColumns>
        </Grid>
    </div>
</div>

@code {
    public string Titulo { get; set; }

    BlazorBootstrap.Grid<Puesto> grid;
    private IEnumerable<Puesto> dataList;
    private bool InProcess = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Titulo is null) Titulo = "Puestos";
        await base.OnAfterRenderAsync(firstRender);
    }

    private async Task<GridDataProviderResult<Puesto>> modelDataProvider(GridDataProviderRequest<Puesto> request)
    {
        if (dataList is null)
            dataList = await GetDataList();
        return await Task.FromResult(request.ApplyTo(dataList));
    }

    private async Task<IEnumerable<Puesto>> GetDataList()
    {
        List<Puesto> model = new();
        try
        {
            model = (await mtoService.GetPuesto()).ToList();
        }
        catch (Exception)
        {
            await swal.FireAsync("Error", "Error al cargar la información solicitada.", SweetAlertIcon.Info);
        }

        InProcess = false;
        StateHasChanged();
        return model;
    }

    private async Task OnClickAdd()
    {
        NavigationManager.NavigateTo("./puestosdetalle/0/1");
    }
    protected async void OnSelect(GridRowEventArgs<Puesto> args)
    {
        NavigationManager.NavigateTo("./puestosdetalle/" + args.Item.Id + "/2");
    }
    protected async void OnDelete(MouseEventArgs mouseEventArgs, Puesto args)
    {
        NavigationManager.NavigateTo($"./puestosdetalle/{args.Id}/3");
    }
}





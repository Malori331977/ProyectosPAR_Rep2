@page "/tipoausenciaslist"

@layout MainLayout

<div class="card">
    <PageMant Titulo="@Titulo" OnClickAddSelected="OnClickAdd" />
    <div class="card-body">
        @if (InProcess)
        {
            <SpinnerControl></SpinnerControl>
        }
        <Grid @ref="grid" TItem="TipoAusencia" class="table table-hover table-bordered table-striped "
              DataProvider="modelDataProvider" AllowFiltering="true" Responsive="true"
              AllowPaging="false" PageSize="10" PageSizeSelectorVisible="false" PageSizeSelectorItems="@(new int[] {10,50,100,200,500})"
              PaginationItemsTextFormat="{0} - {1} of {2} items" ItemsPerPageText=""
              HeaderRowCssClass="custom-header border-bottom-0"
              FiltersRowCssClass="custom-filter text-white border-bottom-0"
              FiltersTranslationProvider="gridExtensions.GridFiltersTranslationProvider"
              AllowRowClick="true"
              FixedHeader="true"
              Height="500"
              Unit="Unit.Px"
              OnRowDoubleClick="OnSelect">

            <GridColumn TItem="TipoAusencia" HeaderText="Id" PropertyName="Id" Style="width:200px">
                @context.Id
            </GridColumn>
            <GridColumn TItem="TipoAusencia" HeaderText="Descripción" PropertyName="Descripcion">
                @context.Descripcion
            </GridColumn>
            <GridColumn TItem="TipoAusencia" HeaderText="Activo" PropertyName="Activo">
                <Switch Class="ml-5" @bind-Value="@context.Activo" Disabled />
            </GridColumn>
            <GridColumn TItem="TipoAusencia" HeaderText="Justificada" PropertyName="Justificada">
                @context.Justificada
            </GridColumn>
            <GridColumn TItem="TipoAusencia" HeaderText="Pago" PropertyName="Pago">
                @context.Pago
            </GridColumn>
            <GridColumn TItem="TipoAusencia" HeaderText="Acción" PropertyName="action" Filterable="false" TextAlignment="Alignment.Center">
                <button class="btn btn-danger rounded-circle text-white" type="submit" @onclick="@((e)=> OnDelete(e, context))">
                    <Icon Name="IconName.Trash" Size="IconSize.x6" />
                </button>
            </GridColumn>
        </Grid>
    </div>
</div>

@code {
    public string Titulo { get; set; }

    BlazorBootstrap.Grid<TipoAusencia> grid;
    private IEnumerable<TipoAusencia> dataList;
    private bool InProcess = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Titulo is null) Titulo = "Tipo Ausencias";
        await base.OnAfterRenderAsync(firstRender);
    }

    private async Task<GridDataProviderResult<TipoAusencia>> modelDataProvider(GridDataProviderRequest<TipoAusencia> request)
    {
        if (dataList is null)
            dataList = await GetDataList();
        return await Task.FromResult(request.ApplyTo(dataList));
    }

    private async Task<IEnumerable<TipoAusencia>> GetDataList()
    {
        List<TipoAusencia> model = new();
        try
        {
            model = (await mtoService.GetTipoAusencia()).ToList();
        }
        catch (Exception)
        {
            await swal.FireAsync("Error", "Error al cargar la información solicitada.", SweetAlertIcon.Info);
        }

        InProcess = false;
        StateHasChanged();
        return model;
    }

    private async Task OnClickAdd()
    {
        NavigationManager.NavigateTo("./tipoausenciasdetalle/0/1");
    }
    protected async void OnSelect(GridRowEventArgs<TipoAusencia> args)
    {
        NavigationManager.NavigateTo("./tipoausenciasdetalle/" + args.Item.Id + "/2");
    }
    protected async void OnDelete(MouseEventArgs mouseEventArgs, TipoAusencia args)
    {
        NavigationManager.NavigateTo($"./tipoausenciasdetalle/{args.Id}/3");
    }
}





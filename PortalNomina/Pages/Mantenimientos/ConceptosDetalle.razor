@page "/conceptosdetalle/{Id}/{Modo:int}"

@layout MainLayout

@inject SweetAlertService swal;

<div class="card">
    <PageReturn Titulo="@Titulo" UrlRetorno="@UrlRetorno" />
    <div class="card-body">
        @if (concepto is not null)
        {
            <EditForm Model="@concepto" OnSubmit="GuardarCambios">
                <div class="input-group rounded-border">
                    <div class="row">
                        <label class="align-content-between lbl-xs">
                            Id
                        </label>
                    </div>
                    <div class="input-group w-100" id="btnGroupAddon">
                        <InputText class="form-control br8 rounded-border"
                                   maxlength="25"
                                   placeholder="Id" id="id"
                                   Disabled="@soloLecturaAdd"
                                   @ref="txtId"
                                   @bind-Value="concepto.Id"
                                   oninput="this.value=this.value.toUpperCase()" />
                    </div>
                </div>
                <div class="input-group rounded-border">
                    <div class="row">
                        <label class="align-content-between lbl-xs">
                            Descripción
                        </label>
                    </div>
                    <div class="input-group w-100" id="btnGroupAddon">
                        <InputTextArea class="form-control br8 rounded-border"
                                       maxlength="200"
                                       placeholder="Descripción" id="desc"
                                       Disabled="@soloLecturaAdd"
                                       @ref="txtDescripcion"
                                       @bind-Value="concepto.Descripcion"
                                       oninput="this.value=this.value.toUpperCase()" />
                    </div>
                </div>
                <div class="input-group rounded-border">
                    <div class="row">
                        <label class="align-content-between lbl-xs">
                            Activo
                        </label>
                    </div>
                    <div class="input-group w-100" id="btnGroupAddon">
                        <div class="d-block text-dark text-decoration-none">
                            <Switch @bind-Value="@concepto.Activo" Disabled="@soloLectura" />
                        </div>
                    </div>
                </div>             
                <div class="input-group rounded-border">
                    <div class="row">
                        <label class="align-content-between lbl-xs">
                            Alias
                        </label>
                    </div>
                    <div class="input-group w-100" id="btnGroupAddon">
                        <InputText class="form-control br8 rounded-border"
                                   maxlength="15"
                                   placeholder="Alias" id="alias"
                                   Disabled="@soloLectura"
                                   @bind-Value="concepto.Alias" />
                    </div>
                </div>
                <div class="input-group rounded-border">
                    <div class="row">
                        <label class="align-content-between lbl-xs">
                            Tipo Concepto
                        </label>
                    </div>
                    <div class="input-group w-100" id="btnGroupAddon">
                        <InputText class="form-control br8 rounded-border"
                                   maxlength="1"
                                   placeholder="Tipo Concepto" id="tipoConcepto"
                                   Disabled="@soloLectura"
                                   @bind-Value="concepto.TipoConcepto"
                                   oninput="this.value=this.value.toUpperCase()" />
                    </div>
                </div>
                <div class="input-group rounded-border">
                    <div class="row">
                        <label class="align-content-between lbl-xs">
                            Unidades
                        </label>
                    </div>
                    <div class="input-group w-100" id="btnGroupAddon">
                        <InputText class="form-control br8 rounded-border"
                                   maxlength="10"
                                   placeholder="Unidades" id="unidades"
                                   Disabled="@soloLectura"
                                   @bind-Value="concepto.Unidades" />
                    </div>
                </div>
                <div class="input-group rounded-border">
                    <div class="row">
                        <label class="align-content-between lbl-xs">
                            Salarial
                        </label>
                    </div>
                    <div class="input-group w-100" id="btnGroupAddon">
                        <InputText class="form-control br8 rounded-border"
                                   maxlength="1"
                                   placeholder="Salarial" id="salarial"
                                   Disabled="@soloLectura"
                                   @bind-Value="concepto.Salarial"
                                   oninput="this.value=this.value.toUpperCase()" />
                    </div>
                </div>
                <div class="input-group rounded-border">
                    <div class="row">
                        <label class="align-content-between lbl-xs">
                            Fijo
                        </label>
                    </div>
                    <div class="input-group w-100" id="btnGroupAddon">
                        <InputText class="form-control br8 rounded-border"
                                   maxlength="1"
                                   placeholder="Fijo" id="fijo"
                                   Disabled="@soloLectura"
                                   @bind-Value="concepto.Fijo"
                                   oninput="this.value=this.value.toUpperCase()" />
                    </div>
                </div>
                <div class="input-group rounded-border">
                    <div class="row">
                        <label class="align-content-between lbl-xs">
                            Liquidable
                        </label>
                    </div>
                    <div class="input-group w-100" id="btnGroupAddon">
                        <InputText class="form-control br8 rounded-border"
                                   maxlength="1"
                                   placeholder="Liquidable" id="liquidable"
                                   Disabled="@soloLectura"
                                   @bind-Value="concepto.Liquidable"
                                   oninput="this.value=this.value.toUpperCase()" />
                    </div>
                </div>
                <div class="input-group rounded-border">
                    <div class="row">
                        <label class="align-content-between lbl-xs">
                            Excluyente
                        </label>
                    </div>
                    <div class="input-group w-100" id="btnGroupAddon">

                    </div>
                </div>
                <div class="input-group rounded-border">
                    <div class="row">
                        <label class="align-content-between lbl-xs">
                            Variable Decisión
                        </label>
                    </div>
                    <div class="input-group w-100" id="btnGroupAddon">
                        <InputText class="form-control br8 rounded-border"
                                   maxlength="15"
                                   placeholder="Variable Decisión" id="variableDecision"
                                   Disabled="@soloLectura"
                                   @bind-Value="concepto.VariableDecision" />
                    </div>
                </div>
                <div class="input-group rounded-border">
                    <div class="row">
                        <label class="align-content-between lbl-xs">
                            Cantidad Editable
                        </label>
                    </div>
                    <div class="input-group w-100" id="btnGroupAddon">
                        <InputText class="form-control br8 rounded-border"
                                   maxlength="1"
                                   placeholder="Cantidad Editable" id="cantidadEditable"
                                   Disabled="@soloLectura"

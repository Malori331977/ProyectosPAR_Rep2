                                </button>
                            </div>
                        }
                    </div>
                </div>
                <br />
            </EditForm>
        }
    </div>
</div>

@code {
    [Parameter] public string Id { get; set; }
    [Parameter] public int Modo { get; set; }

    private string Titulo = "Concepto";
    private string UrlRetorno = "./conceptoslist";
    private InputText txtId = new();
    private InputTextArea txtDescripcion = new();

    private bool InProcess = true;
    private bool soloLecturaAdd = false;
    private bool soloLectura = false;
    private Concepto concepto = new();

    protected override async Task OnInitializedAsync()
    {
        soloLectura = Modo == 3;
        try
        {
            //Modos= 1:Insertar 2:Actualizar 3:Borrar 0:Consulta
            if (Modo != 1)
            {
                soloLecturaAdd = true;
                concepto = await mtoService.GetConcepto(Id);
            }
            else
            {
                concepto = new Concepto
                    {
                        Id = "",
                        Descripcion = "",
                        Activo = false,
                        Alias = "",

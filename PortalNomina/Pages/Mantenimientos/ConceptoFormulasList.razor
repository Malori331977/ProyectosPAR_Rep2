@page "/conceptoformulaslist"

@layout MainLayout

<div class="card">
    <PageMant Titulo="@Titulo" OnClickAddSelected="OnClickAdd" />
    <div class="card-body">
        @if (InProcess)
        {
            <SpinnerControl></SpinnerControl>
        }
        <Grid @ref="grid" TItem="ConceptoFormula" class="table table-hover table-bordered table-striped "
              DataProvider="modelDataProvider" AllowFiltering="true" Responsive="true"
              AllowPaging="false" PageSize="10" PageSizeSelectorVisible="false" PageSizeSelectorItems="@(new int[] {10,50,100,200,500})"
              PaginationItemsTextFormat="{0} - {1} of {2} items" ItemsPerPageText=""
              HeaderRowCssClass="custom-header border-bottom-0"
              FiltersRowCssClass="custom-filter text-white border-bottom-0"
              FiltersTranslationProvider="gridExtensions.GridFiltersTranslationProvider"
              AllowRowClick="true"
              FixedHeader="true"
              Height="500"
              Unit="Unit.Px"
              OnRowDoubleClick="OnSelect">

            <GridColumn TItem="ConceptoFormula" HeaderText="Id" PropertyName="Id" Style="width:200px">
                @context.Id
            </GridColumn>
            <GridColumn TItem="ConceptoFormula" HeaderText="Secuencia" PropertyName="Secuencia">
                @context.Secuencia
            </GridColumn>
            <GridColumn TItem="ConceptoFormula" HeaderText="Descripción" PropertyName="Descripcion">
                @context.Descripcion
            </GridColumn>
            <GridColumn TItem="ConceptoFormula" HeaderText="Activo" PropertyName="Activo">
                <Switch Class="ml-5" @bind-Value="@context.Activo" Disabled />
            </GridColumn>
            <GridColumn TItem="ConceptoFormula" HeaderText="Valor Inicial" PropertyName="ValorInicial">
                @context.ValorInicial
            </GridColumn>
            <GridColumn TItem="ConceptoFormula" HeaderText="Valor Final" PropertyName="ValorFinal">
                @context.ValorFinal
            </GridColumn>
            <GridColumn TItem="ConceptoFormula" HeaderText="Cantidad" PropertyName="Cantidad">
                @context.Cantidad
            </GridColumn>
            <GridColumn TItem="ConceptoFormula" HeaderText="Monto" PropertyName="Monto">
                @context.Monto
            </GridColumn>
            <GridColumn TItem="ConceptoFormula" HeaderText="Formula" PropertyName="Formula">
                @context.Formula
            </GridColumn>
            <GridColumn TItem="ConceptoFormula" HeaderText="NivelFormula" PropertyName="NivelFormula">
                @context.NivelFormula
            </GridColumn>
            <GridColumn TItem="ConceptoFormula" HeaderText="Acción" PropertyName="action" Filterable="false" TextAlignment="Alignment.Center">
                <button class="btn btn-danger rounded-circle text-white" type="submit" @onclick="@((e)=> OnDelete(e, context))">
                    <Icon Name="IconName.Trash" Size="IconSize.x6" />
                </button>
            </GridColumn>
        </Grid>
    </div>
</div>

@code {
    public string Titulo { get; set; }

    BlazorBootstrap.Grid<ConceptoFormula> grid;
    private IEnumerable<ConceptoFormula> dataList;
    private bool InProcess = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Titulo is null) Titulo = "Concepto Formulas";
        await base.OnAfterRenderAsync(firstRender);
    }

    private async Task<GridDataProviderResult<ConceptoFormula>> modelDataProvider(GridDataProviderRequest<ConceptoFormula> request)
    {
        if (dataList is null)
            dataList = await GetDataList();
        return await Task.FromResult(request.ApplyTo(dataList));
    }

    private async Task<IEnumerable<ConceptoFormula>> GetDataList()
    {
        List<ConceptoFormula> model = new();
        try
        {
            model = (await mtoService.GetConceptoFormula()).ToList();
        }
        catch (Exception)
        {
            await swal.FireAsync("Error", "Error al cargar la información solicitada.", SweetAlertIcon.Info);
        }

        InProcess = false;
        StateHasChanged();
        return model;
    }

    private async Task OnClickAdd()
    {
        NavigationManager.NavigateTo("./conceptoformulasdetalle/0/1");
    }
    protected async void OnSelect(GridRowEventArgs<ConceptoFormula> args)
    {
        NavigationManager.NavigateTo($"./conceptoformulasdetalle/{args.Item.Id}|{args.Item.Secuencia}/2");
    }
    protected async void OnDelete(MouseEventArgs mouseEventArgs, ConceptoFormula args)
    {
        NavigationManager.NavigateTo($"./conceptoformulasdetalle/{args.Id}|{args.Secuencia}/3");
    }
}




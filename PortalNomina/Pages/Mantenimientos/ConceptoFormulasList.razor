@page "/conceptoformulaslist"

@layout MainLayout

<div class="card">
    <PageMant Titulo="@Titulo" OnClickAddSelected="OnClickAdd" />
    <div class="card-body">
        @if (InProcess)
        {
            <SpinnerControl></SpinnerControl>
        }
        <Grid @ref="grid" TItem="ConceptoFormula" class="table custom-table table-hover table-bordered table-striped"
              DataProvider="modelDataProvider" AllowFiltering="true" Responsive="true"
              AllowPaging="true" PageSize="10" AllowSorting="true" Height="600"
              HeaderRowCssClass="custom-header border-bottom-0"
              FiltersRowCssClass="custom-filter text-white border-bottom-0"
              AllowRowClick="true"
              OnRowClick="OnSelect">

            <GridColumns>
                <GridColumn TItem="ConceptoFormula" HeaderText="Id" PropertyName="Id" SortKeySelector="item => item.Id">
                    @context.Id
                </GridColumn>
                <GridColumn TItem="ConceptoFormula" HeaderText="Secuencia" PropertyName="Secuencia" SortKeySelector="item => item.Secuencia">
                    @context.Secuencia
                </GridColumn>
                <GridColumn TItem="ConceptoFormula" HeaderText="Descripción" PropertyName="Descripcion" SortKeySelector="item => item.Descripcion">
                    @context.Descripcion
                </GridColumn>
                <GridColumn TItem="ConceptoFormula" HeaderText="Activo" PropertyName="Activo" SortKeySelector="item => item.Activo">
                    <Switch Class="ml-5" @bind-Value="@context.Activo" Disabled />
                </GridColumn>
                <GridColumn TItem="ConceptoFormula" HeaderText="Valor Inicial" PropertyName="ValorInicial" SortKeySelector="item => item.ValorInicial">
                    @context.ValorInicial
                </GridColumn>
                <GridColumn TItem="ConceptoFormula" HeaderText="Valor Final" PropertyName="ValorFinal" SortKeySelector="item => item.ValorFinal">
                    @context.ValorFinal
                </GridColumn>
                <GridColumn TItem="ConceptoFormula" HeaderText="Cantidad" PropertyName="Cantidad" SortKeySelector="item => item.Cantidad">
                    @context.Cantidad
                </GridColumn>
                <GridColumn TItem="ConceptoFormula" HeaderText="Monto" PropertyName="Monto" SortKeySelector="item => item.Monto">
                    @context.Monto
                </GridColumn>
                <GridColumn TItem="ConceptoFormula" HeaderText="Formula" PropertyName="Formula" SortKeySelector="item => item.Formula">
                    @context.Formula
                </GridColumn>
                <GridColumn TItem="ConceptoFormula" HeaderText="NivelFormula" PropertyName="NivelFormula" SortKeySelector="item => item.NivelFormula">
                    @context.NivelFormula
                </GridColumn>
                <GridColumn TItem="ConceptoFormula" HeaderText="Acción" PropertyName="action" Filterable="false" TextAlignment="Alignment.Center">
                    <button class="btn btn-danger rounded-circle text-white" type="submit" @onclick="@((e)=> OnDelete(e, context))">
                        <Icon Name="IconName.Trash" Size="IconSize.x6" />
                    </button>
                </GridColumn>
            </GridColumns>
        </Grid>
    </div>
</div>

@code {
    public string Titulo { get; set; }

    BlazorBootstrap.Grid<ConceptoFormula> grid;
    private IEnumerable<ConceptoFormula> dataList;
    private bool InProcess = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Titulo is null) Titulo = "Concepto Formulas";
        await base.OnAfterRenderAsync(firstRender);
    }

    private async Task<GridDataProviderResult<ConceptoFormula>> modelDataProvider(GridDataProviderRequest<ConceptoFormula> request)
    {
        if (dataList is null)
            dataList = await GetDataList();
        return await Task.FromResult(request.ApplyTo(dataList));
    }

    private async Task<IEnumerable<ConceptoFormula>> GetDataList()
    {
        List<ConceptoFormula> model = new();
        try
        {
            model = (await mtoService.GetConceptoFormula()).ToList();
        }
        catch (Exception)
        {
            await swal.FireAsync("Error", "Error al cargar la información solicitada.", SweetAlertIcon.Info);
        }

        InProcess = false;
        StateHasChanged();
        return model;
    }

    private async Task OnClickAdd()
    {
        NavigationManager.NavigateTo("./conceptoformulasdetalle/0/1");
    }
    protected async void OnSelect(GridRowEventArgs<ConceptoFormula> args)
    {
        NavigationManager.NavigateTo($"./conceptoformulasdetalle/{args.Item.Id}|{args.Item.Secuencia}/2");
    }
    protected async void OnDelete(MouseEventArgs mouseEventArgs, ConceptoFormula args)
    {
        NavigationManager.NavigateTo($"./conceptoformulasdetalle/{args.Id}|{args.Secuencia}/3");
    }
}




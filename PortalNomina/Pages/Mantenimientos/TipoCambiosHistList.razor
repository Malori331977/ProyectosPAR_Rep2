@page "/tipocambioshistlist"

@layout MainLayout

<div class="card">
    <PageMant Titulo="@Titulo" OnClickAddSelected="OnClickAdd" />
    <div class="card-body">
        @if (InProcess)
        {
            <SpinnerControl></SpinnerControl>
        }
        <Grid @ref="grid" TItem="TipoCambioHist" class="table custom-table table-hover table-bordered table-striped"
              DataProvider="modelDataProvider" AllowFiltering="true" Responsive="true"
              AllowPaging="true" PageSize="10" AllowSorting="true" Height="600"
              HeaderRowCssClass="custom-header border-bottom-0"
              FiltersRowCssClass="custom-filter text-white border-bottom-0"
              AllowRowClick="true"
              OnRowClick="OnSelect">

            <GridColumns>
                <GridColumn TItem="TipoCambioHist" HeaderText="Id" PropertyName="Id" SortKeySelector="item => item.Id">
                    @context.Id
                </GridColumn>
                <GridColumn TItem="TipoCambioHist" HeaderText="Fecha" PropertyName="Fecha" SortKeySelector="item => item.Fecha">
                    @context.Fecha
                </GridColumn>
                <GridColumn TItem="TipoCambioHist" HeaderText="Descripción" PropertyName="Descripcion" SortKeySelector="item => item.Descripcion">
                    @context.Descripcion
                </GridColumn>
                <GridColumn TItem="TipoCambioHist" HeaderText="Activo" PropertyName="Activo" SortKeySelector="item => item.Activo">
                    <Switch Class="ml-5" @bind-Value="@context.Activo" Disabled />
                </GridColumn>
                <GridColumn TItem="TipoCambioHist" HeaderText="Usuario" PropertyName="Usuario" SortKeySelector="item => item.Usuario">
                    @context.Usuario
                </GridColumn>
                <GridColumn TItem="TipoCambioHist" HeaderText="Monto" PropertyName="Monto" SortKeySelector="item => item.Monto">
                    @context.Monto
                </GridColumn>           
                <GridColumn TItem="TipoCambioHist" HeaderText="Acción" PropertyName="action" Filterable="false" TextAlignment="Alignment.Center">
                    <button class="btn btn-danger rounded-circle text-white" type="submit" @onclick="@((e)=> OnDelete(e, context))">
                        <Icon Name="IconName.Trash" Size="IconSize.x6" />
                    </button>
                </GridColumn>
            </GridColumns>
        </Grid>
    </div>
</div>

@code {
    public string Titulo { get; set; }

    BlazorBootstrap.Grid<TipoCambioHist> grid;
    private IEnumerable<TipoCambioHist> dataList;
    private bool InProcess = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Titulo is null) Titulo = "Tipo Cambios Históricos";
        await base.OnAfterRenderAsync(firstRender);
    }

    private async Task<GridDataProviderResult<TipoCambioHist>> modelDataProvider(GridDataProviderRequest<TipoCambioHist> request)
    {
        if (dataList is null)
            dataList = await GetDataList();
        return await Task.FromResult(request.ApplyTo(dataList));
    }

    private async Task<IEnumerable<TipoCambioHist>> GetDataList()
    {
        List<TipoCambioHist> model = new();
        try
        {
            model = (await mtoService.GetTipoCambioHist()).ToList();
        }
        catch (Exception)
        {
            await swal.FireAsync("Error", "Error al cargar la información solicitada.", SweetAlertIcon.Info);
        }

        InProcess = false;
        StateHasChanged();
        return model;
    }

    private async Task OnClickAdd()
    {
        NavigationManager.NavigateTo("./tipocambioshistdetalle/0/1");
    }
    protected async void OnSelect(GridRowEventArgs<TipoCambioHist> args)
    {       
        NavigationManager.NavigateTo($"./tipocambioshistdetalle/{args.Item.Id}|{args.Item.Fecha.ToString().Replace("/", "-")}/2");
    }
    protected async void OnDelete(MouseEventArgs mouseEventArgs, TipoCambioHist args)
    {
        NavigationManager.NavigateTo($"./tipocambioshistdetalle/{args.Id}|{args.Fecha.ToString().Replace("/", "-")}/3");
    }
}




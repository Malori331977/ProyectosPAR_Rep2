@page "/conceptoslist"

@layout MainLayout

<div class="card">
    <PageMant Titulo="@Titulo" OnClickAddSelected="OnClickAdd" />
    <div class="card-body">
        @if (InProcess)
        {
            <SpinnerControl></SpinnerControl>
        }
        <Grid @ref="grid" TItem="Concepto" class="table custom-table table-hover table-bordered table-striped"
              DataProvider="modelDataProvider" AllowFiltering="true" Responsive="true"
              AllowPaging="true" PageSize="10" AllowSorting="true" Height="600"
              HeaderRowCssClass="custom-header border-bottom-0"
              FiltersRowCssClass="custom-filter text-white border-bottom-0"
              AllowRowClick="true"
              OnRowClick="OnSelect">

            <GridColumns>
                <GridColumn TItem="Concepto" HeaderText="Id" PropertyName="Id" SortKeySelector="item => item.Id">
                    @context.Id
                </GridColumn>
                <GridColumn TItem="Concepto" HeaderText="Descripción" PropertyName="Descripcion" SortKeySelector="item => item.Descripcion">
                    @context.Descripcion
                </GridColumn>
                <GridColumn TItem="Concepto" HeaderText="Activo" PropertyName="Activo" SortKeySelector="item => item.Activo">
                    <Switch Class="ml-5" @bind-Value="@context.Activo" Disabled />
                </GridColumn>
                <GridColumn TItem="Concepto" HeaderText="Alias" PropertyName="Alias" SortKeySelector="item => item.Alias">
                    @context.Alias
                </GridColumn>
                <GridColumn TItem="Concepto" HeaderText="Tipo Concepto" PropertyName="TipoConcepto" SortKeySelector="item => item.TipoConcepto">
                    @context.TipoConcepto
                </GridColumn>
                <GridColumn TItem="Concepto" HeaderText="Salarial" PropertyName="Salarial" SortKeySelector="item => item.Salarial">
                    @context.Salarial
                </GridColumn>
                <GridColumn TItem="Concepto" HeaderText="Unidades" PropertyName="Unidades" SortKeySelector="item => item.Unidades">
                    @context.Unidades
                </GridColumn>
                <GridColumn TItem="Concepto" HeaderText="Acción" PropertyName="action" Filterable="false" TextAlignment="Alignment.Center">
                    <button class="btn btn-danger rounded-circle text-white" type="submit" @onclick="@((e)=> OnDelete(e, context))">
                        <Icon Name="IconName.Trash" Size="IconSize.x6" />
                    </button>
                </GridColumn>
            </GridColumns>
        </Grid>
    </div>
</div>

@code {
    public string Titulo { get; set; }

    BlazorBootstrap.Grid<Concepto> grid;
    private IEnumerable<Concepto> dataList;
    private bool InProcess = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Titulo is null) Titulo = "Conceptos";
        await base.OnAfterRenderAsync(firstRender);
    }

    private async Task<GridDataProviderResult<Concepto>> modelDataProvider(GridDataProviderRequest<Concepto> request)
    {
        if (dataList is null)
            dataList = await GetDataList();
        return await Task.FromResult(request.ApplyTo(dataList));
    }

    private async Task<IEnumerable<Concepto>> GetDataList()
    {
        List<Concepto> model = new();
        try
        {
            model = (await mtoService.GetConcepto()).ToList();
        }
        catch (Exception)
        {
            await swal.FireAsync("Error", "Error al cargar la información solicitada.", SweetAlertIcon.Info);
        }

        InProcess = false;
        StateHasChanged();
        return model;
    }

    private async Task OnClickAdd()
    {
        NavigationManager.NavigateTo("./conceptosdetalle/0/1");
    }
    protected async void OnSelect(GridRowEventArgs<Concepto> args)
    {
        NavigationManager.NavigateTo($"./conceptosdetalle/{args.Item.Id}/2");
    }
    protected async void OnDelete(MouseEventArgs mouseEventArgs, Concepto args)
    {
        NavigationManager.NavigateTo($"./conceptosdetalle/{args.Id}/3");
    }
}



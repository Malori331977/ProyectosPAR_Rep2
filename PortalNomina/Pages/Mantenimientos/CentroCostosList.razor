@page "/centrocostoslist"
@layout MainLayout


<div class="card">
    <PageMant Titulo="@Titulo" OnClickAddSelected="OnClickAdd" />

    <div class="card-body">

        <RadzenStack Gap="1rem">
            @if (InProcess)
            {
                <SpinnerControl></SpinnerControl>
            }

            <RadzenDataGrid @ref="grid" Render="@OnRender" class="rz-border-radius-2"
                            AllowFiltering="true" 
                            AllowColumnResize="true" 
                            FilterMode="FilterMode.SimpleWithMenu" 
                            PageSize="10"
                            AllowPaging="true"
                            AllowSorting="true" 
                            AllowMultiColumnSorting="true" 
                            ShowMultiColumnSortingIndex="true"
                            Data="@dataList"
                            ColumnWidth="300px"
                            FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                            TItem="CentroCosto"
                            FilterCleared=@FilterCleared
                            SelectionMode="DataGridSelectionMode.Single" 
                            @bind-Value=@selectedData
                            LogicalFilterOperator="LogicalFilterOperator.Or"
                            FilterPopupRenderMode="PopupRenderMode.OnDemand"
                            RowDoubleClick="@OnSelect"
                            AllowColumnPicking="true"
                            AllowColumnReorder="true" 
                            ColumnReordering="@OnColumnReordering">
                <HeaderTemplate>
                    <RadzenStack Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem;" Wrap="FlexWrap.Wrap">
                        <RadzenButton Shade="Shade.Light" ButtonStyle="ButtonStyle.Success" Text="Exportar a XLS" Icon="grid_on" Click="@(args => Export("excel"))" />
                        <RadzenButton Shade="Shade.Light" ButtonStyle="ButtonStyle.Secondary" Text="Exportar a CSV" Icon="wrap_text" Click="@(args => Export("csv"))" />
                    </RadzenStack>
                </HeaderTemplate>
                <Columns>

                    <RadzenDataGridColumn Property="@nameof(CentroCosto.Id)"
                                          FilterValue="@centroCostoID" 
                                          Filterable="true" Title="ID" 
                                          Frozen="true" 
                                          Width="80px" 
                                          TextAlign="TextAlign.Center">
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn Property="@nameof(CentroCosto.Descripcion)" Title="Descripción" />
                    <RadzenDataGridColumn Property="@nameof(CentroCosto.Activo)" Title="Activo" Width="80px" />
                    <RadzenDataGridColumn Property="@nameof(CentroCosto.FechaCreacion)" Title="Creado" FormatString="{0:d}" />
                    <RadzenDataGridColumn Property="@nameof(CentroCosto.FechaActualizacion)" Title="Modificado" FormatString="{0:d}" />
                    <RadzenDataGridColumn Context="CentroCosto" Width="50px" Filterable="false" Sortable="false" TextAlign="TextAlign.Right" Frozen="true" FrozenPosition="FrozenColumnPosition.Left">
                        <Template Context="CentroCosto">
                            <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger"
                                          Variant="Variant.Flat" Size="Radzen.ButtonSize.Medium" Shade="Shade.Lighter" class="rz-my-1 rz-ms-1"
                                          Click="@(args => OnDelete(CentroCosto))" />
                       </Template>
                       
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        </RadzenStack>
        
    </div>
</div>

@code {
    public string Titulo { get; set; }
    private bool InProcess = true; 

    string? centroCostoID;
    RadzenDataGrid<CentroCosto> grid;
    IEnumerable<CentroCosto> dataList;
    IList<CentroCosto> selectedData;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        if (Titulo is null) Titulo = "Centros de Costo";
        dataList = await GetDataList();
    }


    async Task FilterCleared()
    {
        centroCostoID = null;
        await grid.FirstPage();
    }

    void OnRender(DataGridRenderEventArgs<CentroCosto> args)
    {
        if (args.FirstRender)
        {
            args.Grid.Sorts.Add(new SortDescriptor() { Property = "Id", SortOrder = SortOrder.Ascending });

        }
    }


    private async Task<IEnumerable<CentroCosto>> GetDataList()
    {
        List<CentroCosto> model = new();
        try
        {
            model = (await mtoService.GetCentroCosto()).ToList();

        }
        catch (Exception)
        {
            await swal.FireAsync("Error", "Error al cargar la información solicitada.", SweetAlertIcon.Info);
        }

        InProcess = false;
        StateHasChanged();
        return model;
    }

    void OnColumnReordering(DataGridColumnReorderingEventArgs<CentroCosto> args)
    {
        if (args.ToColumn.Property == nameof(CentroCosto.Id))
        {
            args.Cancel = true;
        }
    }

    private async Task OnClickAdd()
    {
        NavigationManager.NavigateTo("./centrocostosdetalle/0/1");
    }

    protected async Task OnSelect(DataGridRowMouseEventArgs<CentroCosto> args)
    {
        NavigationManager.NavigateTo("./centrocostosdetalle/" + args.Data.Id + "/2");
        await InvokeAsync(() => { StateHasChanged(); });
    }

    protected async void OnDelete(CentroCosto centroCosto)
    {
        NavigationManager.NavigateTo($"./centrocostosdetalle/{centroCosto.Id}/3");
    }

    public async Task Export(string type)
    {
        var queryableList = dataList.AsQueryable();

        var query=new Query()
            {
                OrderBy = grid.Query.OrderBy,
                Filter = grid.Query.Filter,
                Select = string.Join(",", grid.ColumnsCollection.Where(c => c.GetVisible() && !string.IsNullOrEmpty(c.Property))
                                .Select(c => c.Property.Contains(".") ? $"{c.Property} as {c.Property.Replace(".", "_")}" : c.Property))
            };

        await ExportFile(queryableList, type, query);
    }

    public async Task ExportFile(IQueryable<CentroCosto> centrosCosto, string type, Radzen.Query? query = null)
    {
        string fileName = "CentroCosto";
        if (type == "csv")
        {
            fileName = $"{fileName}.csv";
            await exportData.ToCSV(exportData.ApplyQuery(centrosCosto, query), fileName);
        }
        else
        {
            fileName = $"{fileName}.xlsx";
            await exportData.ToExcel(exportData.ApplyQuery(centrosCosto, query), fileName);
        }
    }
}

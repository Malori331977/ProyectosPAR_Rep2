@page "/opcionsistemalist"


@layout MainLayout


<div class="card">
    <PageMant Titulo="@Titulo" OnClickAddSelected="OnClickAdd" />

    <div class="card-body">
        @if (InProcess)
        {
            <SpinnerControl></SpinnerControl>
        }

        <Grid @ref="grid" TItem="OpcionSistemaExt" class="table table-hover table-bordered table-striped "
              DataProvider="modelDataProvider" AllowFiltering="true" Responsive="true"
              AllowPaging="false" PageSize="10" PageSizeSelectorVisible="false" PageSizeSelectorItems="@(new int[] {10,50,100,200,500})"
              PaginationItemsTextFormat="{0} - {1} of {2} items" ItemsPerPageText=""
              HeaderRowCssClass="custom-header border-bottom-0"
              FiltersRowCssClass="custom-filter text-white border-bottom-0"
              FiltersTranslationProvider="gridExtensions.GridFiltersTranslationProvider"
              AllowRowClick="true"
              FixedHeader="true"
              Height="500"
              Unit="Unit.Px"
              OnRowDoubleClick="OnSelect">
            <GridColumn TItem="OpcionSistemaExt" HeaderText="Menú Principal" PropertyName="DescMenuPrincipal">
                @context.DescMenuPrincipal
            </GridColumn>
            <GridColumn TItem="OpcionSistemaExt" HeaderText="Id" PropertyName="ID">
                @context.ID
            </GridColumn>
            <GridColumn TItem="OpcionSistemaExt" HeaderText="Descripción" PropertyName="MENUTEXT">
                @context.MENUTEXT
            </GridColumn>
            <GridColumn TItem="OpcionSistemaExt" HeaderText="Href" PropertyName="HREF">
                @context.HREF
            </GridColumn>
            <GridColumn TItem="OpcionSistemaExt" HeaderText="Imagen" PropertyName="ICONID" Filterable="false" TextAlignment="Alignment.Center">
                @{
                    IconName iName = (IconName)context.ICONID;
                 }
                <Icon Name="@iName" Size="IconSize.x3" />                
            </GridColumn>   
        </Grid>
    </div>
</div>



@code {
    [Parameter]
    public string Titulo { get; set; }

    BlazorBootstrap.Grid<OpcionSistemaExt> grid;
    private IEnumerable<OpcionSistemaExt> opcionesSistema;
    private bool InProcess = true; 

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Titulo is null) Titulo = "Menús Secundarios";
        await base.OnAfterRenderAsync(firstRender);
    }

    private async Task<GridDataProviderResult<OpcionSistemaExt>> modelDataProvider(GridDataProviderRequest<OpcionSistemaExt> request)
    {
        if (opcionesSistema is null) 
            opcionesSistema = await GetOpcionesSistema(); 


        return await Task.FromResult(request.ApplyTo(opcionesSistema));
    }

    private async Task<IEnumerable<OpcionSistemaExt>> GetOpcionesSistema()
    {
        List<OpcionSistemaExt> model = new();
        try
        {
            var opcionSistema = await configService.GetOpcionSistema();

            model = (from e in opcionSistema
                     select new OpcionSistemaExt
                         {
                             PARENTID = e.PARENTID,
                             ID = e.ID,
                             MENUTEXT = e.MENUTEXT,
                             HREF = e.HREF,
                             ICONID = e.ICONID,
                             ACTIVO = e.ACTIVO,
                             DescMenuPrincipal = e.MenuPrincipal == null ? "" : e.MenuPrincipal.MENUTEXT,
                             MenuPrincipal = e.MenuPrincipal == null ? null :
                                 new MenuPrincipal
                                    {
                                        ID = e.PARENTID,
                                        MENUTEXT = e.MenuPrincipal.MENUTEXT,
                                        ICONID = e.MenuPrincipal.ICONID,
                                    },
                         }).ToList();
        }
        catch (Exception e)
        {
            await swal.FireAsync("Error", "Error al cargar las opciones de sistema.", SweetAlertIcon.Info);
        }

        InProcess = false;
        StateHasChanged();
        return model;
    }

    private async Task OnClickAdd()
    {
        NavigationManager.NavigateTo("./opcionsistemadetalle/0/1");
    }

    protected async void OnSelect(GridRowEventArgs<OpcionSistemaExt> args)
    {
        NavigationManager.NavigateTo("./opcionsistemadetalle/" + args.Item.ID + "/2");

    }

}

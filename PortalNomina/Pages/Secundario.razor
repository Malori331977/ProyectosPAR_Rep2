@page "/secundario/{id}"

@layout MainLayout

<div class="container-fluid px-0 py-0">
    <div class="card  mb-0 px-0 py-0">
        <div class="card-body shadow mb-2 h-100 py-3 px-3">
            <div class="row">

                @if (listOpcionesUsuario is not null)
                {
                    @foreach (var itemMenu in listOpcionesUsuario)
                    {

                        <div class="col mb-3 d-flex flex-col justify-content-center">
                            <div class="card shadow mb-1 text-center h-100 bi" style="width: 10rem;max-width: 10rem;">
                                <a class="nav-lnk" href="/@itemMenu.HREF">
                                    <span class="material-icons md-84">
                                        touch_app
                                    </span>
                                    <br />
                                    <span style="font-size:small">@itemMenu.MENUTEXT</span>
                                </a>
                            </div>
                        </div>

                    }
                }
            </div>
        </div>
    </div>

</div>

@code {
    [Parameter] public string id { get; set; }

    IEnumerable<OpcionSistema>? listOpcionesUsuario;


    protected override async Task OnInitializedAsync()
    {

        try
        {
            if (loginState.User is null)
            {
                NavigationManager.NavigateTo("./");
                return;
            }
            else
            {
                if (loginState.User.Id == null)
                {
                    NavigationManager.NavigateTo("./");
                    return;
                }
            }


            listOpcionesUsuario = await GetOpcionesUsuario();
        }
        catch (Exception e)
        {
            await swal.FireAsync("Atención", "Se presentó un error al cargar las opciones del usuario: " + e.Message, SweetAlertIcon.Error);
            NavigationManager.NavigateTo("./");
            Console.WriteLine(e.Message);
        }

        StateHasChanged();
    }

    private async Task<IEnumerable<OpcionSistema>> GetOpcionesUsuario()
    {
        List<OpcionSistema> listOpcionesRol = new();
        try
        {

            var usuario = await configService.GetUsuario(loginState.User.Id, loginState.User.Id);
            var opcionSistema = await configService.GetOpcionSistema();
            if (usuario is null)
            {
                var rolesSistema = await configService.GetRol();

                if (rolesSistema is not null)
                {
                    var rolesUsuario = rolesSistema.FirstOrDefault(e => e.TipoUsuario == loginState.User.TipoUsuario);

                    if (rolesUsuario!.Habilitado)
                    {
                        if (rolesUsuario.RolDet is not null)
                        {
                            var ops = (from e in rolesUsuario.RolDet.Where(e => e.Habilitado == true && e.MenuPrincipalId==id)
                                       join o in opcionSistema on new { mp = e.MenuPrincipalId, opc = e.OpcionSistemaId } equals new { mp = o.PARENTID, opc = o.ID }
                                       select new OpcionSistema
                                           {
                                               PARENTID = e.MenuPrincipalId,
                                               ID = e.OpcionSistemaId,
                                               MENUTEXT = o.MENUTEXT,
                                               HREF = o.HREF,
                                           }).ToList();

                            listOpcionesRol.AddRange(ops);
                        }
                    }
                    listOpcionesRol = (listOpcionesRol.Distinct()).ToList();

                }
            }
            else
            {
                foreach (var rol in usuario.UsuarioRol!.Where(e => e.Habilitado == true))
                {
                    var rolBuscar = await configService.GetRol(rol.RolId);
                    if (rolBuscar.Habilitado)
                    {
                        if (rolBuscar.RolDet is not null)
                        {
                            var ops = (from e in rolBuscar.RolDet.Where(e => e.Habilitado == true && e.MenuPrincipalId == id)
                                       join o in opcionSistema on new { mp=e.MenuPrincipalId, opc = e.OpcionSistemaId } equals new { mp = o.PARENTID, opc = o.ID }
                                       select new OpcionSistema
                                           {
                                               PARENTID = e.MenuPrincipalId,
                                               ID = e.OpcionSistemaId,
                                               MENUTEXT = o.MENUTEXT,
                                               HREF = o.HREF,
                                               
                                           }).ToList();

                            listOpcionesRol.AddRange(ops);
                        }
                    }
                    listOpcionesRol = (listOpcionesRol.Distinct()).ToList();
                }
            }


        }
        catch (Exception e)
        {
            Console.WriteLine(e.Message);
        }

        return listOpcionesRol;


    }



}
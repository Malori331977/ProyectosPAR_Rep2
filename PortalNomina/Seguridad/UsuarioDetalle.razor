@page "/usuariodetalle/{Id}/{Modo:int}"
@layout MainLayout



<div class="card">

    <PageReturn Titulo="@Titulo" UrlRetorno="@UrlRetorno" />
    <div class="card-body">
        @if (InProcess)
        {
            <SpinnerControl></SpinnerControl>
        }
        @if (usuario is not null)
        {
            <EditForm Model="@usuario" OnSubmit="GuardarCambios">

                <div class="row mb-2">
                    <div class="col">
                        <div class="input-group">
                            <div class="row w-100">
                                <label class="text-left lbl-xs">
                                    Código de Usuario
                                </label>
                            </div>
                            <div class="input-group w-100" id="btnGroupAddon">
                                <InputText class="form-control br8"
                                           placeholder="Código del Usuario"
                                           maxlength="20"
                                           readonly="@soloLectura"
                                           @bind-Value="usuario.Id" />
                            </div>
                        </div>
                    </div>

                    <div class="col">
                        <div class="input-group">
                            <div class="row w-100">
                                <label class="text-left lbl-xs">
                                    Nombre
                                </label>
                            </div>
                            <div class="input-group w-100" id="btnGroupAddon">
                                <InputText class="form-control br8"
                                           placeholder="Nombre del Empleado"
                                           maxlength="150"
                                           readonly="@soloLectura"
                                           @bind-Value="usuario.Nombre" />
                            </div>
                        </div>
                    </div>
                    <div class="col">
                        <div class="input-group">
                            <div class="row w-100">
                                <label class="text-left lbl-xs">
                                    Correo electrónico
                                </label>
                            </div>
                            <div class="input-group w-100" id="btnGroupAddon">
                                <InputText class="form-control br8"
                                           placeholder="Correo Electrónico"
                                           maxlength="100"
                                           readonly="@soloLectura"
                                           @bind-Value="usuario.Email" />
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row  mb-2">
                    <div class="col ml-5">
                        <Switch @bind-Value="usuario.Activo" Label="Usuario Activo" Disabled="@soloLectura" />
                    </div>
                </div>
                <div class="row  mb-2">
                    <div class="col ml-5">
                        <Switch @bind-Value="bloqueado" Label="Usuario Bloqueado" Disabled="@soloLecturaBloq" />
                    </div>                    
                </div>

               
                <div class="row">
                    <div class="col">
                        @if (Modo == 3)
                        {
                            <button type="submit" class="btn btn-danger w-100">
                                Eliminar
                                <span class="oi oi-trash" aria-hidden="true" />
                            </button>
                        }
                        else
                        {
                            <button type="submit" class="btn btn-primary w-100">
                                Aceptar
                                <span class="oi oi-refresh" aria-hidden="true" />
                            </button>
                        }
                    </div>
                </div>
                <br />

            </EditForm>


            <UsuarioDetalleRoles ModoGlobal="@Modo" OnItemsChanged="OnRolesUsuarioChanged" rolesActivos="@listUsuarioRol" IdUsuario="usuario.Id"></UsuarioDetalleRoles>
        }
       
            
        

        
    </div>
</div>

        
    
    


@code {

    [Parameter] public string Id { get; set; }
    [Parameter] public int Modo { get; set; }

    private string Titulo = "Datos del Usuario";
    private string UrlRetorno = "./usuarioslist";
    private bool InProcess = true;

    private bool soloLectura = false;
    private bool bloqueado = false;
    private bool soloLecturaBloq = true;

    private Usuario? usuario = null;
    private UserLogin DatosSeguridad = new();
    private List<UsuarioRol> listUsuarioRol = new(); 

    protected override async Task OnInitializedAsync()
    {
        soloLectura = Modo == 3;
        //Modos= 1:Insertar 2:Actualizar 3:Borrar 0:Consulta
        if (Modo != 1)
        {
            usuario = await configService.GetUsuario(Id, Id);
            if (usuario.UsuarioRol is not null)
                listUsuarioRol = usuario.UsuarioRol.ToList();


            var userLogin = await configService.GetUserLogin(Id);
            if (userLogin is not null)
            {
                bloqueado = userLogin.Bloqueado;
                soloLecturaBloq = Modo == 3;
            }
            else
            {
                soloLecturaBloq = true;
            }
        }
        else
        {
            usuario = new();
            usuario.Id = "";
        }
        
            
        InProcess = false;
        StateHasChanged();
    }


    private async Task GuardarCambios()
    {
        InProcess = true;
        try
        {
            if (!(await Validaciones()))
                return;

            usuario.FechaCreacion = DateTime.Now;
            usuario.FechaUltModificacion = DateTime.Now;
            usuario.UsuarioCreacion = loginState.User.Id;
            usuario.UsuarioUltModificacion = loginState.User.Id;

            usuario.UsuarioRol = listUsuarioRol;

            EventResponse respuesta;
            if (Modo == 3)
                respuesta = await genericService.Delete("Usuario", usuario.Id!);
            else
                respuesta = await genericService.Post("Usuario", usuario);

            if (respuesta.Id == "0")
            {
                if (Modo == 1)
                {
                    UserLogin userLogin = new UserLogin
                        {
                            Id = usuario.Id!,
                            Email = usuario.Email!,
                            Nombre = usuario.Nombre!,
                            Activo = usuario.Activo,
                            Bloqueado = false,
                            CodigoSeguridad = Utiles.GeneraCodigoSeguridad(),
                            Clave = DateTime.Now.ToString("ddMMyyyyHHmmss"),
                            FechaCreacion = DateTime.Now,
                            FechaUltModificacion = DateTime.Now,
                            IntentosFallidos=0,
                        };
                    var respAdd = await genericService.Post("UserLogin", userLogin);
                }
                NavigationManager.NavigateTo(UrlRetorno);
            }
            else
            {
                await swal.FireAsync("Error", respuesta.Descripcion, SweetAlertIcon.Error);
            }

        }
        catch (Exception e)
        {
            await swal.FireAsync("Error", "Ocurrió un error al ejecutar el proceso. Detalle de Error: " + e.Message, SweetAlertIcon.Error);
        }
        finally
        {
            InProcess = false;
        }
    }

    private async Task<bool> Validaciones()
    {

        if (String.IsNullOrEmpty(usuario.Id))
        {
            await swal.FireAsync("Atención", "Debe indicar el Código de Usuario", SweetAlertIcon.Info);
            return false;
        }
        if (String.IsNullOrEmpty(usuario.Nombre))
        {
            await swal.FireAsync("Atención", "Debe indicar el nombre de Usuario", SweetAlertIcon.Info);
            return false;
        }
        if (String.IsNullOrEmpty(usuario.Nombre))
        {
            await swal.FireAsync("Atención", "Debe indicar el correo electrónico del Usuario", SweetAlertIcon.Info);
            return false;
        }

        if (listUsuarioRol is null || listUsuarioRol.Count() == 0)
        {            
            await swal.FireAsync("Atención", "No se han asignado los roles al usuario", SweetAlertIcon.Info);
            return false;
        }

        return true;
    }

    private async Task OnRolesUsuarioChanged(IEnumerable<RolesUsuario> rolesUsuario)
    {
        if (rolesUsuario is not null)
        {
            listUsuarioRol = (from e in rolesUsuario
                              select new UsuarioRol
                                  {
                                      RolId = e.Id,
                                      UsuarioId = usuario.Id!,
                                      Habilitado = e.HabilitadoUsuario,
                                  }).ToList();
        }
    }



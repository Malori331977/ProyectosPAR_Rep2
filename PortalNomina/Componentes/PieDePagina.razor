
<div class="card card-footer bg-light">
	<div class="row">
		<div class="col-2 text-start text-white">
			<Icon Name="IconName.BuildingFillCheck" Size="IconSize.x6" />
		</div>
		<div class="col-8 text-center text-white ">
			&copy; @DateTime.Now.Year - Grupo Servicios Integrales en Tecnolog&iacute;a
		</div>
		<div class="col-2 text-end text-white ">
			@versionSistema
		</div>
	</div>
</div>

@code {


	private string versionSistema = "";
	string compania = "";

	protected override async Task OnInitializedAsync()
	{
		try
		{
			Version version = typeof(Program).Assembly.GetName().Version;
			versionSistema = $"v.{version.Major}.{version.Minor}.{version.Build}";
			
		}
		catch (Exception e)
		{
			Console.WriteLine(e);
		}

	}

}